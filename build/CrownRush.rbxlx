	},

	-- Crown dances (when you win a tournament)
	{ id = "dance_cheer", kind = "dance", name = "Cheer", source = "default" },
	{ id = "dance_jump", kind = "dance", name = "Victory Jump", source = "level", level = 20 },
	{ id = "dance_spin", kind = "dance", name = "Spin", source = "coins", price = 1200 },
	{ id = "dance_hop", kind = "dance", name = "Bunny Hop", source = "coins", price = 1800 },
	{ id = "dance_flip", kind = "dance", name = "Backflip", source = "coins", price = 2500 },
	{ id = "dance_heli", kind = "dance", name = "Helicopter", source = "earned", rule = "crowns", amount = 10 },
}

Cosmetics.Defaults = {
	hammer = "hammer_foam",
	celebrate = "cel_sparkles",
	dance = "dance_cheer",
}

Cosmetics.ById = {}
Cosmetics.ByProductId = {}
for index, item in ipairs(Cosmetics.List) do
	item.order = index
	Cosmetics.ById[item.id] = item
	if item.productId and item.productId ~= 0 then
		Cosmetics.ByProductId[item.productId] = item
	end
end

-- True if the player can use this item. vip = owns the VIP pass.
function Cosmetics.Owns(data, item, vip)
	if item.source == "default" then
		return true
	elseif item.source == "vip" then
		return vip == true
	end
	return data.cosmetics.owned[item.id] == true
end

-- The item the player shows for a kind (falls back to the free default)
function Cosmetics.Equipped(data, kind, vip)
	local item = Cosmetics.ById[data.cosmetics.equipped[kind] or ""]
	if item and Cosmetics.Owns(data, item, vip) then
		return item
	end
	return Cosmetics.ById[Cosmetics.Defaults[kind] or ""]
end

return Cosmetics
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Courses</string><ProtectedString name="Source"><![CDATA[-- Every Adventure course, as a list of obstacle kit pieces (see Server/Kit).
-- A course is built when someone plays it, so adding one is just adding a list.
--
-- Each course has 3 hidden gems: put gem = true on 3 pieces. Stars:
--   1 for finishing, 1 for beating par time, 1 for having found all 3 gems.
-- par is worked out from the course's length unless you set it.

local Worlds = require(script.Parent.Worlds)

local Courses = {}

Courses.List = {
	------------------------------------------------------------------ Candy Clouds
	{
		id = "candy_1",
		world = "candy",
		name = "Sugar Steps",
		pieces = {
			{ "start" },
			{ "run", len = 20 },
			{ "stairs", steps = 5 },
			{ "gaps", count = 3, gap = 4, gem = true },
			{ "run", len = 14 },
			{ "checkpoint" },
			{ "ramp", len = 24, rise = 6 },
			{ "spinner", r = 14, speed = 1.0 },
			{ "run", len = 16, gem = true },
			{ "bounce", rise = 14, gem = true },
			{ "finish" },
		},
	},
	{
		id = "candy_2",
		world = "candy",
		name = "Lollipop Loop",
		pieces = {
			{ "start" },
			{ "run", len = 16 },
			{ "turn", dir = "left" },
			{ "gaps", count = 4, gap = 4, drift = 4 },
			{ "checkpoint" },
			{ "spinner", r = 16, speed = 1.2, gem = true },
			{ "turn", dir = "right" },
			{ "movers", count = 2, axis = "forward", dist = 12, period = 5, gem = true },
			{ "checkpoint" },
			{ "ramp", len = 20, rise = 5 },
			{ "run", len = 16, gem = true },
			{ "finish" },
		},
	},
	{
		id = "candy_3",
		world = "candy",
		name = "Marshmallow Hop",
		pieces = {
			{ "start" },
			{ "gaps", count = 5, gap = 4, climb = 1.5, gem = true },
			{ "checkpoint" },
			{ "bounce", rise = 16 },
			{ "movers", count = 3, axis = "side", dist = 14, period = 5, gem = true },
			{ "checkpoint" },
			{ "spinner", r = 15, speed = 1.1, bars = 2 },
			{ "run", len = 14, gem = true },
			{ "stairs", steps = 4 },
			{ "finish" },
		},
	},
	{
		id = "candy_4",
		world = "candy",
		name = "Gumdrop Gauntlet",
		pieces = {
			{ "start" },
			{ "conveyor", len = 36, speed = -8, gem = true },
			{ "checkpoint" },
			{ "spinner", r = 15, speed = 1.3 },
			{ "gaps", count = 4, gap = 5, drift = 5 },
			{ "checkpoint" },
			{ "discs", count = 1, r = 13, speed = 0.5, gem = true },
			{ "turn", dir = "left" },
			{ "bounce", rise = 16, gem = true },
			{ "finish" },
		},
	},
	{
		id = "candy_5",
		world = "candy",
		name = "Cotton Candy Climb",
		pieces = {
			{ "start" },
			{ "stairs", steps = 6 },
			{ "bounce", rise = 14 },
			{ "gaps", count = 4, gap = 4, climb = 2, gem = true },
			{ "checkpoint" },
			{ "movers", count = 3, axis = "forward", dist = 12, period = 5.5 },
			{ "ramp", len = 22, rise = 6 },
			{ "checkpoint" },
			{ "spinner", r = 16, speed = 1.3, bars = 2, gem = true },
			{ "bounce", rise = 18 },
			{ "run", len = 14, gem = true },
			{ "finish" },
		},
	},
	{
		id = "candy_6",
		world = "candy",
		name = "Candy Castle",
		boss = true,
		pieces = {
			{ "start" },
			{ "run", len = 14 },
			{ "gaps", count = 4, gap = 5, drift = 3 },
			{ "spinner", r = 16, speed = 1.3 },
			{ "checkpoint" },
			{ "movers", count = 3, axis = "side", dist = 14, period = 4.5, gem = true },
			{ "bounce", rise = 16 },
			{ "checkpoint" },
			{ "discs", count = 2, r = 13, speed = 0.6 },
			{ "conveyor", len = 32, speed = -10, gem = true },
			{ "checkpoint" },
			{ "spinner", r = 16, speed = 1.5, bars = 2, reverse = true },
			{ "turn", dir = "right" },
			{ "gaps", count = 5, gap = 5, drift = 4, climb = 1, gem = true },
			{ "bounce", rise = 18 },
			{ "finish" },
		},
	},
}

Courses.ById = {}
Courses.ByWorld = {}
for _, course in ipairs(Courses.List) do
	Courses.ById[course.id] = course
	Courses.ByWorld[course.world] = Courses.ByWorld[course.world] or {}
	table.insert(Courses.ByWorld[course.world], course)
	course.number = #Courses.ByWorld[course.world]
end

-- The course before this one in its world (it must be finished first), or nil
function Courses.Previous(courseId)
	local course = Courses.ById[courseId]
	if not course or course.number == 1 then
		return nil
	end
	return Courses.ByWorld[course.world][course.number - 1]
end

-- The next course in the same world, or the first of the next world
function Courses.Next(courseId, worldOrder)
	local course = Courses.ById[courseId]
	if not course then
		return nil
	end
	local list = Courses.ByWorld[course.world]
	if list[course.number + 1] then
		return list[course.number + 1]
	end
	for index, worldId in ipairs(worldOrder) do
		if worldId == course.world and worldOrder[index + 1] then
			local nextList = Courses.ByWorld[worldOrder[index + 1]]
			return nextList and nextList[1] or nil
		end
	end
	return nil
end

-- Star bits saved per course
Courses.StarFinish = 1
Courses.StarTime = 2
Courses.StarGems = 4

function Courses.CountStars(bits)
	bits = bits or 0
	local count = 0
	for _, bit in ipairs({ 1, 2, 4 }) do
		if bit32.band(bits, bit) ~= 0 then
			count += 1
		end
	end
	return count
end

-- Total stars across every course in a save
function Courses.TotalStars(adventure)
	local total = 0
	for _, record in pairs(adventure or {}) do
		total += Courses.CountStars(record.stars)
	end
	return total
end

-- Worlds open with stars; courses in a world open one after another
function Courses.WorldUnlocked(adventure, worldId)
	local world = Worlds.ById[worldId]
	return world ~= nil and Courses.TotalStars(adventure) >= world.stars
end

function Courses.Unlocked(adventure, courseId)
	local course = Courses.ById[courseId]
	if not course or not Courses.WorldUnlocked(adventure, course.world) then
		return false
	end
	local previous = Courses.Previous(courseId)
	return previous == nil or (adventure[previous.id] ~= nil and adventure[previous.id].done == true)
end

return Courses
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Format</string><ProtectedString name="Source"><![CDATA[-- Small helpers for showing numbers and times.

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }

-- 1234 -> "1.23K", 5600000 -> "5.6M"
function Format.Number(n)
	n = math.floor(n or 0)
	if math.abs(n) < 1000 then
		return tostring(n)
	end
	local index = 1
	local value = n
	while math.abs(value) >= 1000 and index < #SUFFIXES do
		value = value / 1000
		index += 1
	end
	local text = string.format("%.2f", value)
	text = text:gsub("0+$", ""):gsub("%.$", "")
	return text .. SUFFIXES[index]
end

-- 3725 -> "1h 2m", 95 -> "1m 35s"
function Format.Duration(seconds)
	seconds = math.max(0, math.floor(seconds))
	local days = math.floor(seconds / 86400)
	local hours = math.floor((seconds % 86400) / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	local secs = seconds % 60
	if days > 0 then
		return string.format("%dd %dh", days, hours)
	elseif hours > 0 then
		return string.format("%dh %dm", hours, minutes)
	elseif minutes > 0 then
		return string.format("%dm %ds", minutes, secs)
	end
	return string.format("%ds", secs)
end

-- Damage % color: white, then yellow, orange and red as it climbs
function Format.DamageColor(damage)
	if damage < 50 then
		return Color3.new(1, 1, 1):Lerp(Color3.fromRGB(255, 230, 80), damage / 50)
	elseif damage < 100 then
		return Color3.fromRGB(255, 230, 80):Lerp(Color3.fromRGB(255, 140, 40), (damage - 50) / 50)
	end
	return Color3.fromRGB(255, 140, 40):Lerp(Color3.fromRGB(230, 30, 30), math.clamp((damage - 100) / 60, 0, 1))
end

-- 75 -> "1:15"
function Format.Clock(seconds)
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

return Format
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Level</string><ProtectedString name="Source"><![CDATA[-- Runner level. Courses, tournaments and quests give XP.
-- Your level shows above your head, pays coins each time it goes up, and some
-- levels unlock a free cosmetic (see Cosmetics.luau, source = "level").

local Level = {}

Level.CoinsPerLevel = 25 -- reward for reaching level N is N * this
Level.Max = 50

-- Total XP needed to reach a level (level 1 needs 0)
function Level.XpFor(level)
	return math.floor(60 * (level - 1) ^ 1.5)
end

function Level.FromXp(xp)
	local level = 1
	while level < Level.Max and Level.XpFor(level + 1) <= xp do
		level += 1
	end
	return level
end

-- How far through the current level, from 0 to 1
function Level.Progress(xp)
	local level = Level.FromXp(xp)
	if level >= Level.Max then
		return 1, level
	end
	local from, to = Level.XpFor(level), Level.XpFor(level + 1)
	return (xp - from) / (to - from), level
end

return Level
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Motion</string><ProtectedString name="Source"><![CDATA[-- How every moving obstacle moves. Each moving part carries attributes that
-- describe its motion, and its position is worked out from the server clock.
-- That way every player's computer moves the obstacles itself (perfectly
-- smooth, no lag) and they still all agree, and the server can work out where
-- anything is at any moment (for the bots).
--
-- Attributes on a moving part (tagged "Moving"):
--   Motion  "spin" | "swing" | "rock" | "slide" | "piston" | "ball" | "blink" | "lava"
--   Home    CFrame: the pivot the part moves around (or its rest place)
--   Offset  CFrame: where the part sits relative to the pivot (default: on it)
--   Speed   spin: radians per second (negative = the other way)
--   Amp     swing/rock: radians either side
--   Period  seconds for one full back-and-forth (or one cycle)
--   Phase   seconds added to the clock, so neighbours don't move in step
--   Axis    slide/piston: local direction (Vector3) and Dist: how far
--   Hold    slide: share of each half spent waiting at the ends (0 to 0.45)
--   On      blink: seconds solid in each cycle
--   Travel, Length, Radius   ball: seconds to roll down, lane length, ball radius
--   Low, High, Rise          lava: heights and seconds to climb

local Workspace = game:GetService("Workspace")

local Motion = {}

Motion.Tag = "Moving"
local EPOCH = 1790000000 -- keeps the clock numbers small, for precise maths
local TAU = math.pi * 2

function Motion.Clock()
	return Workspace:GetServerTimeNow() - EPOCH
end

-- Reads a part's motion attributes once into a table
function Motion.Read(part)
	local attributes = part:GetAttributes()
	return {
		kind = attributes.Motion,
		home = attributes.Home or part.CFrame,
		offset = attributes.Offset or CFrame.identity,
		speed = attributes.Speed or 1,
		amp = attributes.Amp or 0.8,
		period = math.max(0.1, attributes.Period or 4),
		phase = attributes.Phase or 0,
		axis = attributes.Axis or Vector3.xAxis,
		dist = attributes.Dist or 10,
		hold = math.clamp(attributes.Hold or 0.2, 0, 0.45),
		on = attributes.On or 2,
		travel = attributes.Travel or 3,
		length = attributes.Length or 40,
		radius = attributes.Radius or 3,
		low = attributes.Low or 0,
		high = attributes.High or 10,
		rise = attributes.Rise or 3,
	}
end

local function smooth(x)
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

-- Where along a slide (0 = home, 1 = home + axis * dist), with waits at both ends
function Motion.SlideShare(spec, t)
	local u = ((t + spec.phase) / spec.period) % 1
	local half = u < 0.5 and u * 2 or (u - 0.5) * 2
	local hold = spec.hold
	local moving = (half - hold) / (1 - 2 * hold)
	local s = smooth(moving)
	return u < 0.5 and s or 1 - s
end

local function pistonShare(spec, t)
	local u = ((t + spec.phase) / spec.period) % 1
	if u < 0.08 then
		return smooth(u / 0.08) -- punch out fast
	elseif u < 0.35 then
		return 1
	elseif u < 0.65 then
		return 1 - smooth((u - 0.35) / 0.3) -- pull back slowly
	end
	return 0
end

-- Returns cframe, state. state is "solid", "warn" (about to vanish) or "gone".
function Motion.At(spec, t)
	local kind = spec.kind
	if kind == "spin" then
		return spec.home * CFrame.Angles(0, spec.speed * t + spec.phase, 0) * spec.offset, "solid"
	elseif kind == "swing" then
		local angle = spec.amp * math.sin(TAU * (t + spec.phase) / spec.period)
		return spec.home * CFrame.Angles(0, 0, angle) * spec.offset, "solid"
	elseif kind == "rock" then
		local angle = spec.amp * math.sin(TAU * (t + spec.phase) / spec.period)
		return spec.home * CFrame.Angles(angle, 0, 0) * spec.offset, "solid"
	elseif kind == "slide" then
		return spec.home * CFrame.new(spec.axis * spec.dist * Motion.SlideShare(spec, t)) * spec.offset, "solid"
	elseif kind == "piston" then
		return spec.home * CFrame.new(spec.axis * spec.dist * pistonShare(spec, t)) * spec.offset, "solid"
	elseif kind == "ball" then
		local u = (t + spec.phase) % spec.period
		if u > spec.travel then
			return spec.home * CFrame.new(0, -500, 0), "gone"
		end
		local along = spec.length * u / spec.travel
		return spec.home * CFrame.new(0, 0, -along) * CFrame.Angles(-along / spec.radius, 0, 0), "solid"
	elseif kind == "blink" then
		local u = (t + spec.phase) % spec.period
		if u >= spec.on then
			return spec.home, "gone"
		elseif u >= spec.on - 0.7 then
			return spec.home, "warn"
		end
		return spec.home, "solid"
	elseif kind == "lava" then
		local u = (t + spec.phase) % spec.period
		local rise = spec.rise
		local share
		if u < rise then
			share = smooth(u / rise)
		elseif u < spec.period / 2 then
			share = 1
		elseif u < spec.period / 2 + rise then
			share = 1 - smooth((u - spec.period / 2) / rise)
		else
			share = 0
		end
		return spec.home + Vector3.new(0, spec.low + (spec.high - spec.low) * share, 0), "solid"
	end
	return spec.home * spec.offset, "solid"
end

-- How fast a point on the part is moving right now (for knockback direction)
function Motion.VelocityAt(spec, t, worldPoint)
	local a = Motion.At(spec, t)
	local b = Motion.At(spec, t + 0.05)
	local localPoint = a:PointToObjectSpace(worldPoint)
	return (b:PointToWorldSpace(localPoint) - worldPoint) / 0.05
end

return Motion
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Quests</string><ProtectedString name="Source"><![CDATA[-- Daily quests: three small goals per player per day. Finishing one pays coins
-- and XP right away.

local Quests = {}

-- stat: what counts toward the goal (services report these with each reward)
-- needs: "stars" / "gems" = only offered while the player still has some to find
Quests.Pool = {
	{ id = "courses", stat = "courses", text = "Finish %d Adventure courses", goal = { 2, 5 }, coins = 100 },
	{ id = "stars", stat = "stars", text = "Earn %d new stars", goal = { 1, 3 }, coins = 120, needs = "stars" },
	{ id = "gems", stat = "gems", text = "Find %d hidden gems", goal = { 1, 3 }, coins = 100, needs = "gems" },
	{ id = "tournaments", stat = "tournaments", text = "Play %d tournaments", goal = { 2, 4 }, coins = 100 },
	{ id = "rounds", stat = "rounds", text = "Survive %d tournament rounds", goal = { 3, 8 }, coins = 100 },
	{ id = "qualified", stat = "qualified", text = "Qualify in %d races", goal = { 2, 4 }, coins = 90 },
	{ id = "crowns", stat = "crowns", text = "Win %d tournament", goal = { 1, 1 }, coins = 150 },
	{ id = "kos", stat = "kos", text = "Knock %d rivals out in fight rounds", goal = { 3, 6 }, coins = 90 },
}

Quests.ById = {}
for _, quest in ipairs(Quests.Pool) do
	Quests.ById[quest.id] = quest
end

Quests.PerDay = 3
Quests.XpShare = 0.5 -- XP reward = coins * this

function Quests.Today(now)
	return math.floor(now / 86400)
end

-- Week number for the weekly leaderboard; weeks start Monday 00:00 UTC
-- (1 Jan 1970 was a Thursday). Also returns the seconds left in the week.
local WEEK = 7 * 86400
local MONDAY_OFFSET = 4 * 86400
function Quests.Week(now)
	return math.floor((now - MONDAY_OFFSET) / WEEK), WEEK - ((now - MONDAY_OFFSET) % WEEK)
end

-- The same three quests for a player all day, picked from the pool.
-- left = { stars = n, gems = n }: how many the player can still find.
function Quests.Generate(userId, day, left)
	left = left or { stars = 99, gems = 99 }
	local random = Random.new(userId % 1000003 * 977 + day)
	local pool = {}
	for _, quest in ipairs(Quests.Pool) do
		if not quest.needs or (left[quest.needs] or 0) >= quest.goal[2] then
			table.insert(pool, quest)
		end
	end
	local list = {}
	while #list < Quests.PerDay and #pool > 0 do
		local quest = table.remove(pool, random:NextInteger(1, #pool))
		table.insert(list, {
			id = quest.id,
			goal = random:NextInteger(quest.goal[1], quest.goal[2]),
			progress = 0,
			done = false,
		})
	end
	return list
end

function Quests.Text(entry)
	local quest = Quests.ById[entry.id]
	local text = string.format(quest.text, entry.goal)
	if entry.goal ~= 1 then
		return (text:gsub("Win (%d+) tournament$", "Win %1 tournaments"))
	end
	-- "Finish 1 Adventure courses" -> "Finish 1 Adventure course"
	return (
		text:gsub("courses", "course")
			:gsub("stars", "star")
			:gsub("gems", "gem")
			:gsub("tournaments", "tournament")
			:gsub("rounds", "round")
			:gsub("races", "race")
			:gsub("rivals", "rival")
	)
end

return Quests
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[-- All the messages between server and players. The server creates them;
-- players wait for them to appear.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"DataUpdate", -- server -> player: the player's full save data
	"Notify", -- server -> player: a toast message
	"OpenPanel", -- server -> player: open a menu (e.g. a world's course list)
	"Announce", -- server -> player: big text in the middle of the screen
	"Effect", -- server -> players: confetti, a fall, a gem, a hit...
	"Launch", -- server -> player: you got knocked, fly with this velocity
	"Run", -- server -> player: your course run changed (timer, checkpoint, finish)
	"Fell", -- player -> server: I touched lava / a laser, or fell below the course
	"Dive", -- player -> server: I just dived (for effects)
	"Bonk", -- player -> server: swing the hammer (fight rounds)
	"Tournaments", -- server -> everyone: the state of every tournament
}

local FUNCTIONS = {
	"Action", -- player -> server: play a course, buy or equip a cosmetic...
	"Ask", -- player -> server: questions with answers (a ghost run, leaderboards)
}

local Remotes = {}

local folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in ipairs(EVENTS) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	for _, name in ipairs(FUNCTIONS) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

for _, name in ipairs(EVENTS) do
	Remotes[name] = folder:WaitForChild(name)
end
for _, name in ipairs(FUNCTIONS) do
	Remotes[name] = folder:WaitForChild(name)
end

return Remotes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[-- Everything sold for Robux. Nothing here helps you win: only looks.
-- The cosmetics sold for Robux (source = "robux") are in Cosmetics.luau with their
-- developer product ids.
--
-- An id of 0 means "not set up yet": the pass shows as "Coming soon" in the shop.
-- tools/create_shop_items.luau makes the pass and prints its id to paste here.

local Shop = {}

Shop.Passes = {
	{
		id = "VIP",
		gamePassId = 0,
		name = "VIP",
		suggestedPrice = 250,
		description = "Golden name tag, a crown, the Golden Trail, the Royal Hammer and +25% coins (coins only buy looks).",
	},
}

Shop.PassById = {}
for _, pass in ipairs(Shop.Passes) do
	Shop.PassById[pass.id] = pass
end

return Shop
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source"><![CDATA[-- The first-time guide. Each step points at a place in the world (a part with the
-- matching "GuideTarget" attribute) and finishes on a game event.

local Tutorial = {}

Tutorial.Steps = {
	{ event = "Gate", text = "Welcome to Crown Rush! Walk into the pink Candy Clouds gate.", target = "FirstGate" },
	{ event = "Course", text = "Pick Sugar Steps to play your first course.", target = nil },
	{ event = "Finish", text = "Run to the finish! If you fall, you pop back at the last checkpoint.", target = nil },
	{ event = "Queue", text = "Ready to race other players? Step on a glowing tournament pad.", target = "Pads" },
	{ event = "Tournament", text = "Survive every round and grab the crown in the final!", target = nil },
}

Tutorial.Done = #Tutorial.Steps + 1
Tutorial.RewardCoins = 200

return Tutorial
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Worlds</string><ProtectedString name="Source"><![CDATA[-- The five Adventure worlds. Stars from courses unlock the next world.
-- Colours here dress every course and tournament round in that world's look.

local Worlds = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

Worlds.List = {
	{
		id = "candy",
		name = "Candy Clouds",
		stars = 0,
		blurb = "Pastel sky islands. Spinners, bounce pads and moving platforms.",
		floor = { rgb(255, 170, 210), rgb(255, 240, 245) },
		edge = rgb(255, 105, 170),
		mover = rgb(120, 210, 255),
		hazard = rgb(255, 70, 90),
		accent = rgb(255, 220, 90),
		deco = rgb(170, 120, 255),
		material = Enum.Material.SmoothPlastic,
		sky = { top = rgb(150, 200, 255), fog = rgb(255, 215, 235), ambient = rgb(170, 160, 190) },
		gravity = nil,
	},
	{
		id = "jungle",
		name = "Jungle Ruins",
		stars = 10,
		blurb = "Old temples and vines. Swinging hammers, rolling boulders and ziplines.",
		floor = { rgb(150, 140, 115), rgb(120, 160, 90) },
		edge = rgb(90, 75, 60),
		mover = rgb(190, 140, 80),
		hazard = rgb(200, 90, 50),
		accent = rgb(250, 200, 80),
		deco = rgb(60, 140, 70),
		material = Enum.Material.Slate,
		sky = { top = rgb(140, 200, 170), fog = rgb(170, 210, 160), ambient = rgb(120, 150, 110) },
		gravity = nil,
	},
	{
		id = "frost",
		name = "Frost Peak",
		stars = 25,
		blurb = "Ice and snow. Wind gusts, falling tiles and slippery slides.",
		floor = { rgb(235, 245, 255), rgb(175, 220, 250) },
		edge = rgb(110, 170, 220),
		mover = rgb(150, 200, 255),
		hazard = rgb(60, 110, 200),
		accent = rgb(255, 255, 255),
		deco = rgb(200, 235, 255),
		material = Enum.Material.Snow,
		sky = { top = rgb(190, 220, 245), fog = rgb(225, 240, 255), ambient = rgb(170, 185, 210) },
		gravity = nil,
	},
	{
		id = "lava",
		name = "Lava Factory",
		stars = 40,
		blurb = "Pipes and conveyor belts. Rising lava, pistons and laser gates.",
		floor = { rgb(95, 95, 105), rgb(70, 70, 80) },
		edge = rgb(255, 150, 40),
		mover = rgb(250, 190, 60),
		hazard = rgb(255, 80, 30),
		accent = rgb(255, 210, 60),
		deco = rgb(60, 60, 70),
		material = Enum.Material.DiamondPlate,
		sky = { top = rgb(90, 50, 40), fog = rgb(120, 60, 40), ambient = rgb(150, 100, 80) },
		gravity = nil,
	},
	{
		id = "space",
		name = "Star Station",
		stars = 60,
		blurb = "Low gravity in space. Spinning discs, fake doors and big jumps.",
		floor = { rgb(70, 60, 120), rgb(45, 40, 85) },
		edge = rgb(90, 255, 230),
		mover = rgb(180, 120, 255),
		hazard = rgb(255, 60, 180),
		accent = rgb(90, 255, 230),
		deco = rgb(30, 25, 60),
		material = Enum.Material.Metal,
		sky = { top = rgb(20, 15, 45), fog = rgb(40, 30, 80), ambient = rgb(120, 110, 170) },
		gravity = 120, -- players jump higher and float longer here
	},
}

Worlds.ById = {}
for index, world in ipairs(Worlds.List) do
	world.index = index
	Worlds.ById[world.id] = world
end

-- The world after this one, or nil for the last
function Worlds.Next(worldId)
	local world = Worlds.ById[worldId]
	return world and Worlds.List[world.index + 1] or nil
end

return Worlds
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX0000001D"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX0000001C"><Properties><string name="Name">Server</string><ProtectedString name="Source"><![CDATA[-- Crown Rush server. Starts every service in order.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Courses = require(Shared.Courses)

local MapBuilder = require(script.MapBuilder)
local DataService = require(script.DataService)
local ShopService = require(script.ShopService)
local CosmeticService = require(script.CosmeticService)
local TutorialService = require(script.TutorialService)
local ProgressService = require(script.ProgressService)
local CourseService = require(script.CourseService)
local AdventureService = require(script.AdventureService)
local WorldService = require(script.WorldService)

-- Players' screens can't check who owns a private server, so share it
if game.PrivateServerId ~= "" then
	game:GetService("ReplicatedStorage"):SetAttribute("PrivateServerOwnerId", game.PrivateServerOwnerId)
end

MapBuilder.Build()

local random = Random.new()
local function lobbySpawn()
	local spawnLocation = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	local base = spawnLocation and spawnLocation.CFrame or CFrame.new(0, 3, 60)
	return base * CFrame.new(random:NextNumber(-4, 4), 3.5, random:NextNumber(-4, 4))
end

-- Services that react to players loading must start before DataService
ShopService.Start()
CosmeticService.Start()
TutorialService.Start()
ProgressService.Start()
CourseService.Start()
AdventureService.Start(lobbySpawn)
WorldService.Start(lobbySpawn)
DataService.Start()

-- Test helpers for Roblox Studio only (never in the live game). In the command
-- bar, with the Server view selected:
--   game.ServerStorage.CrownRushTest:Invoke("coins", 5000)
--   game.ServerStorage.CrownRushTest:Invoke("xp", 10000)
--   game.ServerStorage.CrownRushTest:Invoke("course", "candy_3") -- play any course, locked or not
--   game.ServerStorage.CrownRushTest:Invoke("unlock") -- finish every course (3 stars each)
--   game.ServerStorage.CrownRushTest:Invoke("checkpoint", 2) -- jump to a checkpoint on your course
if RunService:IsStudio() then
	local test = Instance.new("BindableFunction")
	test.Name = "CrownRushTest"
	test.OnInvoke = function(command, amount)
		local player = Players:GetPlayers()[1]
		if command == "course" then
			local course = Courses.ById[amount]
			if not course or not player then
				return "unknown course"
			end
			local instance = CourseService.Open(course)
			CourseService.Enter(player, instance, { mode = "adventure" })
			return "ok"
		elseif command == "checkpoint" then
			local run = player and CourseService.Get(player)
			local checkpoint = run and run.instance.course.checkpoints[amount]
			if checkpoint then
				run.checkpoint = amount
				player.Character:PivotTo(checkpoint.spawn)
				player:SetAttribute("KillY", checkpoint.killY)
				run.killY = checkpoint.killY
			end
			return "ok"
		end
		for _, each in ipairs(Players:GetPlayers()) do
			DataService.Update(each, function(data)
				if command == "coins" then
					data.coins += amount
				elseif command == "xp" then
					data.xp += amount
				elseif command == "unlock" then
					for _, course in ipairs(Courses.List) do
						data.adventure[course.id] = { done = true, stars = 7, gems = 7, runs = 1, best = 60 }
					end
					data.stats.stars = Courses.TotalStars(data.adventure)
				end
			end)
		end
		return "ok"
	end
	test.Parent = game:GetService("ServerStorage")
end

print("[" .. Config.GameName .. "] Server ready")
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">AdventureService</string><ProtectedString name="Source"><![CDATA[-- Adventure: the solo courses. Walk into a world gate in the plaza to pick a
-- course. Courses in a world open one after another; worlds open with stars.
-- Stars: finish the course, beat its par time, and find all 3 gems (gems you
-- found stay found, even if you fall or leave).

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Courses = require(Shared.Courses)
local Worlds = require(Shared.Worlds)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local CourseService = require(script.Parent.CourseService)
local ProgressService = require(script.Parent.ProgressService)
local TutorialService = require(script.Parent.TutorialService)
local CosmeticService = require(script.Parent.CosmeticService)

local AdventureService = {}

local WORLD_ORDER = {}
for _, world in ipairs(Worlds.List) do
	table.insert(WORLD_ORDER, world.id)
end

local gates = {} -- { part, worldId }
local nearGate = {} -- [player] = worldId they are standing at (so the menu opens once)
local lobbySpawnFn = nil

local function notify(player, text, kind)
	Remotes.Notify:FireClient(player, text, kind)
end

------------------------------------------------------------------ Unlocks
function AdventureService.WorldUnlocked(data, worldId)
	return Courses.WorldUnlocked(data.adventure, worldId)
end

function AdventureService.CourseUnlocked(data, courseId)
	return Courses.Unlocked(data.adventure, courseId)
end

local function gemBits(record)
	return record and record.gems or 0
end

local function savedGems(data, courseId)
	local bits = gemBits(data.adventure[courseId])
	local list = {}
	for index = 1, 3 do
		if bit32.band(bits, bit32.lshift(1, index - 1)) ~= 0 then
			list[index] = true
		end
	end
	return list
end

------------------------------------------------------------------ Playing
local onFinish, onGem

local function toLobby(player)
	CourseService.Leave(player)
	local character = player.Character
	if character and lobbySpawnFn then
		character:PivotTo(lobbySpawnFn())
		local root = character:FindFirstChild("HumanoidRootPart")
		if root then
			root.AssemblyLinearVelocity = Vector3.zero
		end
	end
end
AdventureService.ToLobby = toLobby

function AdventureService.Play(player, courseId)
	local data = DataService.Get(player)
	local course = Courses.ById[courseId or ""]
	if not data or not course then
		return false, "Unknown course"
	end
	if player:GetAttribute("InTournament") then
		return false, "Finish your tournament first"
	end
	if not AdventureService.CourseUnlocked(data, courseId) then
		local world = Worlds.ById[course.world]
		if not AdventureService.WorldUnlocked(data, course.world) then
			return false, string.format("%s opens at %d stars", world.name, world.stars)
		end
		return false, "Finish the course before it first"
	end
	local instance, err = CourseService.Open(course)
	if not instance then
		return false, err
	end
	CourseService.Enter(player, instance, {
		mode = "adventure",
		savedGems = savedGems(data, courseId),
		onFinish = onFinish,
		onGem = onGem,
	})
	TutorialService.Event(player, "Course")
	return true
end

onGem = function(run, index)
	local player = run.player
	if not player then
		return
	end
	local courseId = run.instance.course.id
	local isNew = false
	DataService.Update(player, function(data)
		local record = data.adventure[courseId] or { done = false, stars = 0, gems = 0, runs = 0 }
		data.adventure[courseId] = record
		local bit = bit32.lshift(1, index - 1)
		if bit32.band(record.gems, bit) == 0 then
			record.gems = bit32.bor(record.gems, bit)
			data.stats.gems += 1
			isNew = true
		end
	end)
	if isNew then
		run.savedGems[index] = true
		ProgressService.AddResult(
			player,
			{
				coins = Config.CourseRewards.gem,
				xp = Config.CourseXp.gem,
				stats = {},
				quest = { gems = 1 },
				quiet = true,
			}
		)
		-- All three found on a course already finished: the gem star right away
		local starNow = false
		DataService.Update(player, function(data)
			local record = data.adventure[courseId]
			if record and record.done and record.gems == 7 and bit32.band(record.stars, Courses.StarGems) == 0 then
				record.stars = bit32.bor(record.stars, Courses.StarGems)
				data.stats.stars = Courses.TotalStars(data.adventure)
				starNow = true
			end
		end)
		if starNow then
			ProgressService.AddResult(
				player,
				{
					coins = Config.CourseRewards.star,
					xp = Config.CourseXp.star,
					stats = {},
					quest = { stars = 1 },
					quiet = true,
				}
			)
			notify(player, "All 3 gems: +1 star!", "rare")
		end
		notify(
			player,
			string.format(
				"Gem found! (%d/3)",
				(function()
					local count = 0
					for i = 1, 3 do
						if run.savedGems[i] then
							count += 1
						end
					end
					return count
				end)()
			),
			"rare"
		)
	end
end

onFinish = function(run)
	local player = run.player
	if not player then
		return
	end
	local course = run.instance.course
	local courseId = course.id
	local time = run.time
	local valid = not run.skipped and time >= course.par * Config.MinTimeShare
	local result = {
		courseId = courseId,
		name = course.data.name,
		time = time,
		par = course.par,
		skipped = run.skipped,
		newBest = false,
		starsBefore = 0,
		stars = 0,
		newStars = 0,
		firstFinish = false,
		coins = 0,
		xp = 0,
	}
	local worldsBefore = {}
	local data = DataService.Get(player)
	if not data then
		return
	end
	for _, world in ipairs(Worlds.List) do
		worldsBefore[world.id] = AdventureService.WorldUnlocked(data, world.id)
	end

	DataService.Update(player, function(saved)
		local record = saved.adventure[courseId] or { done = false, stars = 0, gems = 0, runs = 0 }
		saved.adventure[courseId] = record
		record.runs = (record.runs or 0) + 1
		result.starsBefore = Courses.CountStars(record.stars)
		result.firstFinish = not record.done
		record.done = true
		if valid then
			local bits = bit32.bor(record.stars, Courses.StarFinish)
			if time <= course.par then
				bits = bit32.bor(bits, Courses.StarTime)
			end
			if gemBits(record) == 7 then
				bits = bit32.bor(bits, Courses.StarGems)
			end
			record.stars = bits
			if not record.best or time < record.best then
				record.best = math.floor(time * 100) / 100
				result.newBest = true
			end
		end
		result.stars = Courses.CountStars(record.stars)
		result.newStars = result.stars - result.starsBefore
		result.best = record.best
		result.gems = gemBits(record)
		saved.stats.stars = Courses.TotalStars(saved.adventure)
	end)

	local coins = Config.CourseRewards.finish + result.newStars * Config.CourseRewards.star
	local xp = Config.CourseXp.finish + result.newStars * Config.CourseXp.star
	if result.firstFinish then
		coins += Config.CourseRewards.firstFinish
		xp += Config.CourseXp.firstFinish
	end
	result.coins, result.xp = ProgressService.AddResult(player, {
		coins = coins,
		xp = xp,
		stats = { courses = 1, falls = run.falls },
		quest = { courses = 1, stars = result.newStars, ["courses_" .. course.world] = 1 },
		quiet = true,
	})
	local nextCourse = Courses.Next(courseId, WORLD_ORDER)
	result.nextCourse = nextCourse and nextCourse.id or nil
	Remotes.Run:FireClient(player, "result", result)
	local celebrate = CosmeticService.Equipped(player, "celebrate")
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local at = root and root.Position or course.finish.lineCFrame.Position
	Remotes.Effect:FireAllClients("finish", at, { effect = celebrate and celebrate.id or nil })
	TutorialService.Event(player, "Finish")

	-- Newly opened worlds
	local after = DataService.Get(player)
	if after then
		for _, world in ipairs(Worlds.List) do
			if not worldsBefore[world.id] and AdventureService.WorldUnlocked(after, world.id) then
				notify(player, world.name .. " is open! Find its gate in the plaza.", "rare")
			end
		end
	end
end

------------------------------------------------------------------ Actions
local function play(player, courseId)
	return AdventureService.Play(player, courseId)
end

local function leave(player)
	if not CourseService.Get(player) then
		return false, "You're not on a course"
	end
	toLobby(player)
	return true
end

local function retry(player)
	local run = CourseService.Get(player)
	if not run or run.mode ~= "adventure" then
		return false, "You're not on a course"
	end
	CourseService.Restart(run)
	return true
end

local function skip(player)
	local run = CourseService.Get(player)
	if not run or run.mode ~= "adventure" then
		return false, "You're not on a course"
	end
	if not CourseService.Skip(run) then
		return false, string.format("The skip appears after %d falls in one section", Config.SkipAfterFalls)
	end
	notify(player, "Skipped ahead. This run won't give stars, but finishing opens the next course.", "info")
	return true
end

------------------------------------------------------------------ World gates
local function findGates()
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("WorldGate") then
			table.insert(gates, { part = item, worldId = item:GetAttribute("WorldGate") })
		end
	end
end

local function gateAt(position)
	for _, gate in ipairs(gates) do
		local offset = gate.part.CFrame:PointToObjectSpace(position)
		local size = gate.part.Size
		if
			math.abs(offset.X) < size.X / 2 + 1
			and math.abs(offset.Z) < size.Z / 2 + 3
			and offset.Y > -size.Y / 2 - 4
			and offset.Y < size.Y / 2
		then
			return gate.worldId
		end
	end
	return nil
end

function AdventureService.Start(lobbySpawn)
	lobbySpawnFn = lobbySpawn
	findGates()
	ProgressService.AddAction("PlayCourse", play)
	ProgressService.AddAction("LeaveCourse", leave)
	ProgressService.AddAction("RetryCourse", retry)
	ProgressService.AddAction("SkipSection", skip)

	Players.PlayerRemoving:Connect(function(player)
		nearGate[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(0.2)
			for _, player in ipairs(Players:GetPlayers()) do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				local worldId = root and not CourseService.Get(player) and gateAt(root.Position) or nil
				if worldId ~= nearGate[player] then
					nearGate[player] = worldId
					if worldId then
						local data = DataService.Get(player)
						if data and not AdventureService.WorldUnlocked(data, worldId) then
							local world = Worlds.ById[worldId]
							notify(
								player,
								string.format(
									"%s opens at %d stars. You have %s.",
									world.name,
									world.stars,
									Format.Number(Courses.TotalStars(data.adventure))
								),
								"warning"
							)
						end
						Remotes.OpenPanel:FireClient(player, "Courses", worldId)
						TutorialService.Event(player, "Gate")
					end
				end
			end
		end
	end)
end

return AdventureService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">ArenaService</string><ProtectedString name="Source"><![CDATA[-- Builds the four arenas and runs what happens in them during a round:
--   Ice Floe       slippery ice tiles crack and sink from the edge inward
--   Spin Cycle     the floor spins faster and faster, a sweeper bar comes round
--   Lava Rise      lava climbs a stepped tower
--   Bounce House   bouncy walls push you back in, then fall away one by one
--
-- Every round gets a freshly built arena. ArenaService.Build returns an "arena"
-- object that MatchService and the bots use:
--   arena.spawns            up to 4 CFrames where players start
--   arena.floorY, .radius   floor height and how far the floor reaches
--   arena:SafeRadius()      how far from the middle is still safe right now
--   arena:IsOut(position)   true if that spot is deadly (lava)
--   arena:ShouldJump(pos)   true if a bot standing there should jump now
--   arena:RandomFloorPoint() somewhere safe to drop a power-up
--   arena:Start(), :SuddenDeath(), :Destroy()

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Arenas = require(Shared.Arenas)

local CombatService = require(script.Parent.CombatService)

local ArenaService = {}

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- turns a cylinder so it lies flat like a disc
local random = Random.new()

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function disc(folder, name, center, topY, radius, thickness, color, material)
	return part({
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(thickness, radius * 2, radius * 2),
		CFrame = CFrame.new(center.X, topY - thickness / 2, center.Z) * UPRIGHT,
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		Parent = folder,
	})
end

local function flat(vector)
	return Vector3.new(vector.X, 0, vector.Z)
end

-- Spawn points around the middle, facing in
local function ringSpawns(center, y, radius)
	local spawns = {}
	for index = 0, 3 do
		local angle = index * math.pi / 2 + math.pi / 4
		local at = Vector3.new(center.X + math.cos(angle) * radius, y + 3.5, center.Z + math.sin(angle) * radius)
		table.insert(spawns, CFrame.lookAt(at, Vector3.new(center.X, at.Y, center.Z)))
	end
	return spawns
end

-- Shakes a floor piece, then lets it drop
local function crumble(tile, arena, delay)
	if tile:GetAttribute("Falling") then
		return
	end
	tile:SetAttribute("Falling", true)
	tile.Color = tile.Color:Lerp(Color3.new(1, 1, 1), 0.6)
	local home = tile.CFrame
	task.spawn(function()
		local started = os.clock()
		while os.clock() - started < (delay or 1.4) and tile.Parent do
			tile.CFrame = home * CFrame.new(random:NextNumber(-0.15, 0.15), 0, random:NextNumber(-0.15, 0.15))
			task.wait(0.05)
		end
		if not tile.Parent then
			return
		end
		tile.CFrame = home
		tile.Anchored = false
		task.delay(4, function()
			tile:Destroy()
		end)
	end)
	if arena and random:NextNumber() < 0.3 then
		CombatService.Effect("crack", tile.Position)
	end
end

local function baseArena(id, center)
	local info = Arenas.ById[id]
	local folder = Instance.new("Folder")
	folder.Name = info.name
	local arena = {
		id = id,
		name = info.name,
		center = center,
		floorY = center.Y,
		folder = folder,
		running = false,
		suddenDeath = false,
		started = 0,
		say = function() end, -- set by MatchService: shows a message to the players in this match
		entities = function()
			return {}
		end, -- set by MatchService: the entities still in the round
	}
	function arena:Elapsed()
		return self.running and os.clock() - self.started or 0
	end
	function arena:IsOut()
		return false
	end
	function arena:ShouldJump()
		return false
	end
	function arena:Start()
		self.running = true
		self.started = os.clock()
		if self.run then
			task.spawn(self.run, self)
		end
	end
	function arena:SuddenDeath()
		self.suddenDeath = true
		if self.onSuddenDeath then
			self:onSuddenDeath()
		end
	end
	function arena:Destroy()
		self.running = false
		if self.heartbeat then
			self.heartbeat:Disconnect()
		end
		folder:Destroy()
	end
	return arena
end

------------------------------------------------------------------ Ice Floe
local function buildIce(arena)
	local center, folder = arena.center, arena.folder
	local radius = 42
	arena.radius = radius
	local tiles = {}
	local ice = PhysicalProperties.new(0.9, 0.05, 0, 100, 1) -- slippery: you slide after a bonk
	for x = -radius, radius, 6 do
		for z = -radius, radius, 6 do
			local distance = math.sqrt(x * x + z * z)
			if distance <= radius then
				local shade = (math.floor(x / 6) + math.floor(z / 6)) % 2 == 0 and Color3.fromRGB(170, 225, 255)
					or Color3.fromRGB(150, 210, 245)
				local tile = part({
					Name = "Ice",
					Size = Vector3.new(5.8, 2, 5.8),
					Position = Vector3.new(center.X + x, arena.floorY - 1, center.Z + z),
					Material = Enum.Material.Ice,
					Color = shade,
					CustomPhysicalProperties = ice,
					Parent = folder,
				})
				table.insert(tiles, { part = tile, distance = distance })
			end
		end
	end
	-- Chunks of iceberg under the floe, for looks
	for _ = 1, 6 do
		local angle = random:NextNumber(0, math.pi * 2)
		local at = center
			+ Vector3.new(
				math.cos(angle) * random:NextNumber(5, 30),
				-random:NextNumber(8, 20),
				math.sin(angle) * random:NextNumber(5, 30)
			)
		part({
			Name = "Iceberg",
			Size = Vector3.new(random:NextNumber(8, 14), random:NextNumber(6, 12), random:NextNumber(8, 14)),
			CFrame = CFrame.new(at)
				* CFrame.Angles(random:NextNumber(-0.4, 0.4), random:NextNumber(0, 3), random:NextNumber(-0.4, 0.4)),
			Material = Enum.Material.Glacier,
			Color = Color3.fromRGB(190, 235, 255),
			CanCollide = false,
			CanQuery = false,
			Parent = folder,
		})
	end

	arena.spawns = ringSpawns(center, arena.floorY, 22)
	local safe = radius
	function arena:SafeRadius()
		return safe - 5
	end
	function arena:RandomFloorPoint()
		local choices = {}
		for _, tile in ipairs(tiles) do
			if tile.part.Parent and not tile.part:GetAttribute("Falling") and tile.distance < safe - 6 then
				table.insert(choices, tile.part)
			end
		end
		local pick = choices[random:NextInteger(1, math.max(1, #choices))]
		return pick and pick.Position + Vector3.new(0, 3.5, 0) or center + Vector3.new(0, 3.5, 0)
	end
	local function shrinkTo(newRadius)
		safe = newRadius
		for _, tile in ipairs(tiles) do
			if tile.distance > newRadius and tile.part.Parent then
				crumble(tile.part, arena)
			end
		end
	end
	local rings = { 36, 30, 24, 18, 12 }
	function arena.run(self)
		self.say("The ice is cracking from the edges!")
		local nextShrink = 12
		local index = 1
		while self.running and index <= #rings do
			if self:Elapsed() >= nextShrink then
				shrinkTo(rings[index])
				index += 1
				nextShrink += self.suddenDeath and 3 or 10
			end
			task.wait(0.25)
		end
	end
	function arena.onSuddenDeath(self)
		if self.running then
			shrinkTo(math.max(12, safe - 6))
		end
	end
end

------------------------------------------------------------------ Spin Cycle
local function buildSpin(arena)
	local center, folder = arena.center, arena.folder
	local radius = 36
	arena.radius = radius
	local floorY = arena.floorY

	local pin = part({
		Name = "Pin",
		Size = Vector3.new(4, 4, 4),
		Position = Vector3.new(center.X, floorY - 8, center.Z),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Parent = folder,
	})
	local spinner = part({
		Name = "Spinner",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, radius * 2, radius * 2),
		CFrame = CFrame.new(center.X, floorY - 1, center.Z) * UPRIGHT,
		Color = Color3.fromRGB(255, 230, 190),
		Anchored = false,
		Parent = folder,
	})
	-- Coloured rings and stripes so you can see it turning
	local colors = {
		Color3.fromRGB(255, 150, 60),
		Color3.fromRGB(255, 230, 190),
		Color3.fromRGB(255, 110, 80),
		Color3.fromRGB(255, 230, 190),
		Color3.fromRGB(255, 200, 60),
	}
	for index, size in ipairs({ 70, 56, 42, 28, 12 }) do
		local ring = part({
			Name = "Ring",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.1, size, size),
			CFrame = CFrame.new(center.X, floorY + 0.02 * index, center.Z) * UPRIGHT,
			Color = colors[index],
			CanCollide = false,
			CanQuery = false,
			Anchored = false,
			Massless = true,
			Parent = folder,
		})
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = spinner
		weld.Part1 = ring
		weld.Parent = ring
	end
	for index = 0, 3 do
		local stripe = part({
			Name = "Stripe",
			Size = Vector3.new(0.6, 0.2, radius * 2 - 2),
			CFrame = CFrame.new(center.X, floorY + 0.12, center.Z) * CFrame.Angles(0, index * math.pi / 4, 0),
			Color = Color3.fromRGB(120, 60, 30),
			CanCollide = false,
			CanQuery = false,
			Anchored = false,
			Massless = true,
			Parent = folder,
		})
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = spinner
		weld.Part1 = stripe
		weld.Parent = stripe
	end
	local pinAttachment = Instance.new("Attachment")
	pinAttachment.CFrame = CFrame.new(0, 7, 0) * UPRIGHT
	pinAttachment.Parent = pin
	local spinAttachment = Instance.new("Attachment")
	spinAttachment.Parent = spinner
	local hinge = Instance.new("HingeConstraint")
	hinge.Attachment0 = pinAttachment
	hinge.Attachment1 = spinAttachment
	hinge.ActuatorType = Enum.ActuatorType.Motor
	hinge.MotorMaxTorque = 1e12
	hinge.MotorMaxAcceleration = 1.5
	hinge.AngularVelocity = 0
	hinge.Parent = spinner

	-- The sweeper bar is drawn here and its hits are worked out with maths (more
	-- reliable than touching): it hits anyone low enough near its arm.
	local bar = part({
		Name = "Sweeper",
		Size = Vector3.new(radius, 1.4, 1.4),
		Color = Color3.fromRGB(255, 60, 60),
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanQuery = false,
		Transparency = 1,
		Parent = folder,
	})
	local bar2 = part({
		Name = "Sweeper2",
		Size = Vector3.new(radius, 1.4, 1.4),
		Color = Color3.fromRGB(255, 60, 60),
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanQuery = false,
		Transparency = 1,
		Parent = folder,
	})
	local sweeperOn, secondArm = false, false
	local angle, sweepSpeed = 0, 0.9
	local lastSwept = {}

	arena.spawns = ringSpawns(center, floorY, 18)
	function arena:SafeRadius()
		return radius - 7
	end
	function arena:RandomFloorPoint()
		local a = random:NextNumber(0, math.pi * 2)
		local r = random:NextNumber(4, radius - 10)
		return Vector3.new(center.X + math.cos(a) * r, floorY + 3.5, center.Z + math.sin(a) * r)
	end
	local function armDirections()
		local first = CFrame.Angles(0, angle, 0) * Vector3.xAxis
		if secondArm then
			return { first, -first }
		end
		return { first }
	end
	function arena:ShouldJump(position)
		if not sweeperOn then
			return false
		end
		local rel = flat(position - center)
		for _, dir in ipairs(armDirections()) do
			local along = rel:Dot(dir)
			local ahead = Vector3.new(0, 1, 0):Cross(dir) -- the way the arm is moving
			local side = rel:Dot(ahead)
			if along > 0 and side > 0 and side < 7 then
				return true
			end
		end
		return false
	end

	arena.heartbeat = RunService.Heartbeat:Connect(function(dt)
		if not arena.running then
			return
		end
		local elapsed = arena:Elapsed()
		hinge.AngularVelocity = arena.suddenDeath and 0.9 or math.min(0.7, 0.25 + elapsed * 0.008)
		if not sweeperOn then
			return
		end
		sweepSpeed = arena.suddenDeath and 2.2 or math.min(1.6, 0.9 + (elapsed - 12) * 0.015)
		angle += sweepSpeed * dt
		local base = CFrame.new(center.X, floorY + 1.6, center.Z)
		bar.CFrame = base * CFrame.Angles(0, angle, 0) * CFrame.new(radius / 2, 0, 0)
		bar2.CFrame = base * CFrame.Angles(0, angle + math.pi, 0) * CFrame.new(radius / 2, 0, 0)
		local now = os.clock()
		for _, entity in ipairs(arena.entities()) do
			local root = entity.root
			if root and root.Parent and (lastSwept[entity] or 0) + 1 < now then
				local rel = root.Position - center
				local height = root.Position.Y - floorY
				if height < 4.6 and height > -2 then
					for _, dir in ipairs(armDirections()) do
						local flatRel = flat(rel)
						local along = flatRel:Dot(dir)
						local off = (flatRel - dir * along).Magnitude
						if along > 0 and along < radius + 1 and off < 2.2 then
							lastSwept[entity] = now
							local push = Vector3.new(0, 1, 0):Cross(dir)
							CombatService.Push(entity, push * 55 + Vector3.yAxis * 32, 0.6, 8)
							CombatService.Effect("hit", root.Position, { damage = 8 })
							break
						end
					end
				end
			end
		end
	end)

	function arena.run(self)
		task.wait(0.1)
		pcall(function()
			spinner:SetNetworkOwner(nil)
		end)
		self.say("The floor is spinning!")
		while self.running and self:Elapsed() < 12 do
			task.wait(0.25)
		end
		if not self.running then
			return
		end
		sweeperOn = true
		bar.Transparency = 0
		self.say("Sweeper bar! Jump over it!")
		while self.running and self:Elapsed() < 40 and not self.suddenDeath do
			task.wait(0.25)
		end
		if self.running then
			secondArm = true
			bar2.Transparency = 0
		end
	end
	function arena.onSuddenDeath()
		if sweeperOn then
			secondArm = true
			bar2.Transparency = 0
		end
	end
end

------------------------------------------------------------------ Lava Rise
local function buildLava(arena)
	local center, folder = arena.center, arena.folder
	local floorY = arena.floorY
	arena.radius = 40
	local tiers = {
		{ radius = 40, top = 0, color = Color3.fromRGB(70, 60, 60) },
		{ radius = 30, top = 5, color = Color3.fromRGB(95, 82, 78) },
		{ radius = 20, top = 10, color = Color3.fromRGB(120, 100, 92) },
		{ radius = 11, top = 15, color = Color3.fromRGB(150, 120, 100) },
	}
	for index, tier in ipairs(tiers) do
		disc(
			folder,
			"Tier" .. index,
			center,
			floorY + tier.top,
			tier.radius,
			tier.top + 4,
			tier.color,
			Enum.Material.Basalt
		)
		-- A glowing edge so the steps are easy to see
		disc(
			folder,
			"Edge" .. index,
			center,
			floorY + tier.top + 0.05,
			tier.radius + 0.2,
			0.3,
			Color3.fromRGB(255, 140, 50),
			Enum.Material.Neon
		).CanCollide =
			false
		disc(
			folder,
			"Top" .. index,
			center,
			floorY + tier.top + 0.1,
			tier.radius - 0.8,
			0.3,
			tier.color,
			Enum.Material.Basalt
		).CanCollide =
			false
	end
	local lavaTop = floorY - 8
	local lava = part({
		Name = "Lava",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 124, 124),
		CFrame = CFrame.new(center.X, lavaTop - 1, center.Z) * UPRIGHT,
		Color = Color3.fromRGB(255, 100, 20),
		Material = Enum.Material.Neon,
		Transparency = 0.1,
		CanCollide = false,
		CanQuery = false,
		Parent = folder,
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 120, 40)
	light.Range = 40
	light.Brightness = 2
	light.Parent = lava

	local rises = { { at = 15, level = 1 }, { at = 35, level = 6 }, { at = 55, level = 11 } }
	local nextRise = 1
	arena.spawns = ringSpawns(center, floorY, 35)

	local function riseTo(level, seconds)
		local target = floorY + level
		TweenService:Create(
			lava,
			TweenInfo.new(seconds, Enum.EasingStyle.Sine),
			{ CFrame = CFrame.new(center.X, target - 1, center.Z) * UPRIGHT }
		):Play()
	end
	-- Read the lava's real height (it moves smoothly)
	local function currentTop()
		return lava.Position.Y + 1
	end
	function arena:IsOut(position)
		return position.Y < currentTop() + 2.5
	end
	function arena:SafeRadius()
		-- Head for the lowest step that will still be above the lava after the next rise
		local soon = currentTop()
		local upcoming = rises[nextRise]
		if upcoming and upcoming.at - self:Elapsed() < 10 then
			soon = math.max(soon, floorY + upcoming.level)
		end
		for _, tier in ipairs(tiers) do
			if floorY + tier.top > soon + 1 then
				return tier.radius - 3
			end
		end
		return tiers[#tiers].radius - 3
	end
	function arena:RandomFloorPoint()
		local safeTiers = {}
		for index, tier in ipairs(tiers) do
			if floorY + tier.top > currentTop() + 4 then
				table.insert(safeTiers, index)
			end
		end
		local index = safeTiers[random:NextInteger(1, math.max(1, #safeTiers))] or #tiers
		local tier = tiers[index]
		local inner = tiers[index + 1] and tiers[index + 1].radius + 2 or 0
		local a = random:NextNumber(0, math.pi * 2)
		local r = random:NextNumber(inner, tier.radius - 2)
		return Vector3.new(center.X + math.cos(a) * r, floorY + tier.top + 3.5, center.Z + math.sin(a) * r)
	end
	function arena.run(self)
		self.say("The lava is coming up. Climb!")
		while self.running and nextRise <= #rises do
			local rise = rises[nextRise]
			if self:Elapsed() >= rise.at - 3 then
				self.say("Lava rising!")
				task.wait(3)
				if not self.running then
					return
				end
				riseTo(rise.level, 4)
				nextRise += 1
			end
			task.wait(0.25)
		end
	end
	function arena.onSuddenDeath()
		riseTo(12.5, 3)
		nextRise = #rises + 1
	end
	riseTo(-6, 0.1)
end

------------------------------------------------------------------ Bounce House
local function buildBounce(arena)
	local center, folder = arena.center, arena.folder
	local floorY = arena.floorY
	local half = 25
	arena.radius = 36
	local tiles = {}
	local colors = {
		Color3.fromRGB(255, 120, 200),
		Color3.fromRGB(255, 230, 90),
		Color3.fromRGB(110, 220, 255),
		Color3.fromRGB(255, 255, 255),
	}
	for ix = -2, 2 do
		for iz = -2, 2 do
			local tile = part({
				Name = "Floor",
				Size = Vector3.new(10, 2, 10),
				Position = Vector3.new(center.X + ix * 10, floorY - 1, center.Z + iz * 10),
				Color = colors[((ix + iz) % #colors) + 1],
				Material = Enum.Material.SmoothPlastic,
				Parent = folder,
			})
			table.insert(tiles, { part = tile, outer = math.max(math.abs(ix), math.abs(iz)) == 2 })
		end
	end
	local walls = {}
	local sides = {
		{
			normal = Vector3.new(0, 0, 1),
			size = Vector3.new(half * 2 + 6, 5, 3),
			offset = Vector3.new(0, 0, -half - 1.5),
		},
		{
			normal = Vector3.new(0, 0, -1),
			size = Vector3.new(half * 2 + 6, 5, 3),
			offset = Vector3.new(0, 0, half + 1.5),
		},
		{ normal = Vector3.new(1, 0, 0), size = Vector3.new(3, 5, half * 2), offset = Vector3.new(-half - 1.5, 0, 0) },
		{ normal = Vector3.new(-1, 0, 0), size = Vector3.new(3, 5, half * 2), offset = Vector3.new(half + 1.5, 0, 0) },
	}
	for index, side in ipairs(sides) do
		local wall = part({
			Name = "BouncyWall",
			Size = side.size,
			Position = center + side.offset + Vector3.new(0, 2.5, 0),
			Color = index % 2 == 0 and Color3.fromRGB(255, 110, 200) or Color3.fromRGB(120, 200, 255),
			Material = Enum.Material.SmoothPlastic,
			Parent = folder,
		})
		local long = side.size.X > side.size.Z and side.size.X or side.size.Z
		local roll = part({
			Name = "WallTop",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(long, 3.4, 3.4),
			CFrame = CFrame.new(wall.Position + Vector3.new(0, 2.5, 0))
				* (side.size.X > side.size.Z and CFrame.new() or CFrame.Angles(0, math.rad(90), 0)),
			Color = wall.Color:Lerp(Color3.new(1, 1, 1), 0.3),
			Material = Enum.Material.SmoothPlastic,
			Parent = folder,
		})
		table.insert(walls, { part = wall, top = roll, normal = side.normal, up = true })
	end

	arena.spawns = ringSpawns(center, floorY, 14)
	local outerGone = false
	local lastBounce = {}
	function arena:SafeRadius()
		return outerGone and 11 or 19
	end
	function arena:RandomFloorPoint()
		local limit = outerGone and 10 or 18
		return Vector3.new(
			center.X + random:NextNumber(-limit, limit),
			floorY + 3.5,
			center.Z + random:NextNumber(-limit, limit)
		)
	end
	local function dropWall(wall)
		if not wall.up then
			return
		end
		wall.up = false
		for _, p in ipairs({ wall.part, wall.top }) do
			p.CanCollide = false
			TweenService
				:Create(p, TweenInfo.new(1.2), { Position = p.Position - Vector3.new(0, 12, 0), Transparency = 1 })
				:Play()
		end
		task.delay(1.3, function()
			wall.part:Destroy()
			wall.top:Destroy()
		end)
	end
	local function dropOuter()
		if outerGone then
			return
		end
		outerGone = true
		for _, tile in ipairs(tiles) do
			if tile.outer then
				crumble(tile.part, arena)
			end
		end
	end

	-- Bouncy walls throw you back in (worked out with maths, so fast hits never pass through)
	arena.heartbeat = RunService.Heartbeat:Connect(function()
		if not arena.running then
			return
		end
		local now = os.clock()
		for _, entity in ipairs(arena.entities()) do
			local root = entity.root
			if root and root.Parent and (lastBounce[entity] or 0) + 0.5 < now then
				local rel = root.Position - center
				if rel.Y - (floorY - center.Y) < 8 then
					for _, wall in ipairs(walls) do
						if wall.up and rel:Dot(wall.normal) + half < 2.4 then
							lastBounce[entity] = now
							CombatService.Push(entity, wall.normal * 55 + Vector3.yAxis * 25, 0.35, 0)
							CombatService.Effect("bounce", root.Position)
							break
						end
					end
				end
			end
		end
	end)

	function arena.run(self)
		self.say("Bounce off the walls... while they last!")
		local order = { 1, 2, 3, 4 }
		for index = #order, 2, -1 do
			local other = random:NextInteger(1, index)
			order[index], order[other] = order[other], order[index]
		end
		local dropAt = { 20, 30, 40, 50 }
		local nextDrop = 1
		while self.running do
			local elapsed = self:Elapsed()
			if nextDrop <= #order and elapsed >= dropAt[nextDrop] then
				if walls[order[nextDrop]].up then
					dropWall(walls[order[nextDrop]])
					self.say("A wall fell away!")
				end
				nextDrop += 1
			end
			if not outerGone and elapsed >= 60 then
				self.say("The floor is shrinking!")
				dropOuter()
			end
			if outerGone and nextDrop > #order then
				return
			end
			task.wait(0.25)
		end
	end
	function arena.onSuddenDeath()
		for _, wall in ipairs(walls) do
			dropWall(wall)
		end
		dropOuter()
	end
end

local BUILDERS = { ice = buildIce, spin = buildSpin, lava = buildLava, bounce = buildBounce }

-- Builds a fresh arena of that kind with its floor at center
function ArenaService.Build(arenaId, center, parent)
	local builder = BUILDERS[arenaId] or buildIce
	local arena = baseArena(Arenas.ById[arenaId] and arenaId or "ice", center)
	builder(arena)
	arena.folder.Parent = parent or Workspace
	-- The server moves the spinning floor, so no player's computer takes it over
	for _, item in ipairs(arena.folder:GetDescendants()) do
		if item:IsA("BasePart") and not item.Anchored then
			pcall(item.SetNetworkOwner, item, nil)
		end
	end
	return arena
end

return ArenaService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">BotService</string><ProtectedString name="Source"><![CDATA[-- Bots fill the empty spots in a match so nobody waits alone. They are a bit
-- slower and less accurate than people, their name tags say BOT, and knocking
-- them out is worth less. When a real player joins, a bot steps aside for them
-- (see MatchService).

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Cosmetics = require(Shared.Cosmetics)

local CombatService = require(script.Parent.CombatService)
local CosmeticService = require(script.Parent.CosmeticService)

local BotService = {}

local NAMES = {
	"Bonky",
	"Thumper",
	"Wobbles",
	"Sir Bonks",
	"Noodle",
	"Pip",
	"Biscuit",
	"Clank",
	"Mallet Max",
	"Tumble",
	"Boing",
	"Dizzy",
}
local SHIRTS = {
	Color3.fromRGB(230, 80, 80),
	Color3.fromRGB(80, 150, 230),
	Color3.fromRGB(90, 200, 110),
	Color3.fromRGB(240, 190, 60),
	Color3.fromRGB(170, 100, 230),
	Color3.fromRGB(240, 130, 60),
}
local SKINS = {
	Color3.fromRGB(234, 184, 146),
	Color3.fromRGB(198, 140, 100),
	Color3.fromRGB(140, 95, 65),
	Color3.fromRGB(255, 215, 180),
}
local BOT_HAMMERS = { "hammer_foam", "hammer_blue", "hammer_green", "hammer_purple", "hammer_mallet" }

BotService.WalkSpeed = 15
local REACH = 6.5
-- Roblox's own R15 animations, so bots walk and jump like players do
local ANIMATIONS = {
	idle = "rbxassetid://507766388",
	walk = "rbxassetid://507777826",
	jump = "rbxassetid://507765000",
	fall = "rbxassetid://507767968",
}

local random = Random.new()
local folder
local nameIndex = 0
local botCount = 0

local function flat(vector)
	return Vector3.new(vector.X, 0, vector.Z)
end

-- Plays the idle, walk, jump and fall animations to match what the bot is doing
local function animate(humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local tracks = {}
	for name, id in pairs(ANIMATIONS) do
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, track = pcall(animator.LoadAnimation, animator, animation)
		if ok and track then
			track.Looped = name ~= "jump"
			tracks[name] = track
		end
	end
	local current = nil
	local function play(name, speed)
		local track = tracks[name]
		if track ~= current then
			if current then
				current:Stop(0.2)
			end
			current = track
			if track then
				track:Play(0.2)
			end
		end
		if track and speed then
			track:AdjustSpeed(speed)
		end
	end
	humanoid.Running:Connect(function(speed)
		if speed > 0.5 then
			play("walk", math.clamp(speed / 14, 0.6, 1.6))
		else
			play("idle")
		end
	end)
	humanoid.StateChanged:Connect(function(_, state)
		if state == Enum.HumanoidStateType.Jumping then
			play("jump")
		elseif state == Enum.HumanoidStateType.Freefall then
			play("fall")
		end
	end)
	play("idle")
end

-- Makes a bot model standing at cframe. Returns its combat entity.
function BotService.Create(cframe)
	nameIndex = nameIndex % #NAMES + 1
	local name = NAMES[nameIndex]
	local skin = SKINS[random:NextInteger(1, #SKINS)]
	local shirt = SHIRTS[random:NextInteger(1, #SHIRTS)]
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = skin
	description.LeftArmColor = skin
	description.RightArmColor = skin
	description.TorsoColor = shirt
	description.LeftLegColor = shirt:Lerp(Color3.new(0, 0, 0), 0.5)
	description.RightLegColor = shirt:Lerp(Color3.new(0, 0, 0), 0.5)
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[BotService] Couldn't make a bot: " .. tostring(model))
		return nil
	end
	botCount += 1
	model.Name = "Bot " .. name
	model:PivotTo(cframe)
	model.Parent = folder
	local root = model:FindFirstChild("HumanoidRootPart")
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	local oldAnimate = model:FindFirstChild("Animate")
	if oldAnimate then
		oldAnimate:Destroy()
	end
	pcall(animate, model:FindFirstChildOfClass("Humanoid"))
	local entity = CombatService.Register(
		model,
		{ kind = "bot", name = name .. " (bot)", key = "b" .. botCount, walkSpeed = BotService.WalkSpeed }
	)
	entity.hammerItem = Cosmetics.ById[BOT_HAMMERS[random:NextInteger(1, #BOT_HAMMERS)]]
	entity.nextThink = 0
	entity.nextBonk = 0
	CosmeticService.BuildHammer(model, entity.hammerItem)
	CosmeticService.Tag(model, { name = name, nameColor = Color3.fromRGB(200, 200, 200), subtitle = "BOT" })
	return entity
end

function BotService.Remove(entity)
	if entity and entity.model then
		entity.model:Destroy()
	end
end

-- Moves a bot (or a dummy) and keeps the server in charge of its physics
function BotService.Place(entity, cframe)
	if entity.model.Parent then
		entity.model:PivotTo(cframe)
		entity.root.AssemblyLinearVelocity = Vector3.zero
		entity.root.AssemblyAngularVelocity = Vector3.zero
		entity.humanoid.PlatformStand = false
		pcall(function()
			entity.root:SetNetworkOwner(nil)
		end)
	end
end

-- Something solid right in front of the bot's feet (a step up) means jump
local function stepAhead(entity, direction)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { entity.model }
	local origin = entity.root.Position - Vector3.new(0, 1.8, 0)
	local hit = Workspace:Raycast(origin, direction * 3, params)
	return hit ~= nil and hit.Instance.CanCollide
end

-- One decision for one bot in a match. space = the match (MatchService) with
-- its arena, alive entities and power-ups.
local function think(entity, space)
	local now = os.clock()
	if entity.frozen or now < entity.stunUntil or not CombatService.IsAlive(entity) then
		return
	end
	local arena = space.arena
	if not arena then
		return
	end
	local humanoid, root = entity.humanoid, entity.root
	local position = root.Position
	local center = Vector3.new(arena.center.X, position.Y, arena.center.Z)
	local fromCenter = flat(position - arena.center)
	local safeRadius = arena:SafeRadius()

	local goal
	-- Back to safety first
	if fromCenter.Magnitude > safeRadius then
		goal = center + (fromCenter.Magnitude > 0.1 and fromCenter.Unit * math.max(0, safeRadius - 6) or Vector3.zero)
	else
		-- A power-up close by is worth grabbing
		local bestPowerUp, bestPowerDistance = nil, 22
		for _, powerUp in ipairs(space:PowerUpPositions()) do
			local distance = (flat(powerUp - position)).Magnitude
			if distance < bestPowerDistance and flat(powerUp - arena.center).Magnitude < safeRadius then
				bestPowerUp, bestPowerDistance = powerUp, distance
			end
		end
		-- Otherwise chase someone, but never off the edge
		if
			not entity.target
			or now > (entity.retarget or 0)
			or not CombatService.IsAlive(entity.target)
			or not entity.target.space
		then
			entity.target = nil
			local best = math.huge
			for _, other in ipairs(space:Targets()) do
				if other ~= entity and CombatService.IsAlive(other) then
					local distance = (other.root.Position - position).Magnitude + random:NextNumber(0, 12)
					if distance < best then
						best = distance
						entity.target = other
					end
				end
			end
			entity.retarget = now + random:NextNumber(2, 4)
		end
		local target = entity.target
		if bestPowerUp and (not target or bestPowerDistance < (target.root.Position - position).Magnitude) then
			goal = bestPowerUp
		elseif target then
			local targetPosition = target.root.Position
			local offset = flat(targetPosition - position)
			if offset.Magnitude <= REACH and math.abs(targetPosition.Y - position.Y) < 5 then
				-- Face them and swing (with a little delay, so bots can be beaten)
				root.CFrame = CFrame.lookAt(position, Vector3.new(targetPosition.X, position.Y, targetPosition.Z))
				if now >= entity.nextBonk then
					if CombatService.TryBonk(entity) then
						entity.nextBonk = now + random:NextNumber(0.8, 1.5)
					end
				end
				goal = position
			else
				goal = targetPosition
				local targetFromCenter = flat(targetPosition - arena.center)
				if targetFromCenter.Magnitude > safeRadius then
					goal = Vector3.new(arena.center.X, targetPosition.Y, arena.center.Z)
						+ targetFromCenter.Unit * math.max(0, safeRadius - 2)
				end
				if offset.Magnitude > 9 and offset.Magnitude < 16 and random:NextNumber() < 0.08 then
					CombatService.Dash(entity, offset)
				end
			end
		end
	end

	if goal then
		humanoid:MoveTo(goal)
		local direction = flat(goal - position)
		if direction.Magnitude > 1 and stepAhead(entity, direction.Unit) then
			humanoid.Jump = true
		end
	end
	if arena:ShouldJump(position) and random:NextNumber() < 0.75 then
		humanoid.Jump = true
	end
end

-- space:Bots() lists the bots in a match; this runs them all
function BotService.Think(space)
	for _, entity in ipairs(space:Bots()) do
		local ok, err = pcall(think, entity, space)
		if not ok then
			warn("[BotService] " .. tostring(err))
		end
	end
end

function BotService.Start()
	folder = Instance.new("Folder")
	folder.Name = "Bots"
	folder.Parent = Workspace
end

return BotService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">CombatService</string><ProtectedString name="Source"><![CDATA[-- Bonking, dashing and knockback for everyone who can be bonked: players, bots
-- and the practice dummies. Each of them is an "entity" with a damage %.
--
-- The server decides every hit (who is in front of you and close enough), so
-- nobody can bonk people from across the map. A bonked player's own computer
-- moves their character (Roblox lets players move their own character), so the
-- server tells it how fast to fly with the Launch remote.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local PowerUps = require(Shared.PowerUps)
local Remotes = require(Shared.Remotes)

local CosmeticService = require(script.Parent.CosmeticService)

local CombatService = {}

local entities = {} -- [model] = entity
local byPlayer = {} -- [player] = entity of their current character
local hitListeners = {}
local bonkListeners = {}
local random = Random.new()

-- Who an entity can hit. MatchService gives entities in a match a "space" with
-- a Targets() function; everyone else can only hit the practice dummies.
local function targetsFor(entity)
	if entity.space then
		return entity.space:Targets()
	end
	local list = {}
	for _, other in pairs(entities) do
		if other.kind == "dummy" then
			table.insert(list, other)
		end
	end
	return list
end

local function flat(vector)
	return Vector3.new(vector.X, 0, vector.Z)
end

local function alive(entity)
	return entity.root ~= nil
		and entity.root:IsDescendantOf(workspace)
		and entity.humanoid ~= nil
		and entity.humanoid.Health > 0
end
CombatService.IsAlive = alive

function CombatService.Register(model, info)
	local entity = {
		kind = info.kind, -- "player", "bot" or "dummy"
		player = info.player,
		model = model,
		root = model:FindFirstChild("HumanoidRootPart"),
		humanoid = model:FindFirstChildOfClass("Humanoid"),
		name = info.name,
		key = info.key,
		baseSpeed = info.walkSpeed or Config.WalkSpeed,
		damage = 0,
		space = nil,
		lastBonk = 0,
		lastDash = 0,
		stunUntil = 0,
		stunToken = 0,
		frozen = false,
		shield = 0,
		giantUntil = 0,
		speedUntil = 0,
		ironUntil = 0,
		magnetUntil = 0,
		lastHit = nil, -- { by = entity, time = os.clock() }
	}
	if entity.humanoid then
		entity.humanoid.UseJumpPower = false
		entity.humanoid.JumpHeight = Config.JumpHeight
		entity.humanoid.WalkSpeed = entity.baseSpeed
	end
	entities[model] = entity
	if info.player then
		byPlayer[info.player] = entity
	end
	model:SetAttribute("Damage", 0)
	model.Destroying:Connect(function()
		CombatService.Unregister(model)
	end)
	return entity
end

function CombatService.Unregister(model)
	local entity = entities[model]
	if not entity then
		return
	end
	entities[model] = nil
	if entity.player and byPlayer[entity.player] == entity then
		byPlayer[entity.player] = nil
	end
end

function CombatService.Get(model)
	return entities[model]
end

function CombatService.GetByPlayer(player)
	return byPlayer[player]
end

-- Called with (attacker, target) after every landed bonk
function CombatService.OnHit(listener)
	table.insert(hitListeners, listener)
end

-- Called with (entity) whenever someone swings
function CombatService.OnBonk(listener)
	table.insert(bonkListeners, listener)
end

function CombatService.Effect(kind, position, extra)
	Remotes.Effect:FireAllClients(kind, position, extra)
end

------------------------------------------------------------------ Damage and movement
function CombatService.SetDamage(entity, value)
	entity.damage = math.clamp(value, 0, Config.MaxDamage)
	entity.model:SetAttribute("Damage", math.floor(entity.damage))
end

-- Walk speed and jumping, from frozen / speed boots / normal
function CombatService.UpdateMovement(entity)
	local humanoid = entity.humanoid
	if not humanoid or not humanoid.Parent then
		return
	end
	if entity.frozen then
		humanoid.WalkSpeed = 0
		humanoid.JumpHeight = 0
	else
		humanoid.WalkSpeed = entity.speedUntil > os.clock() and PowerUps.SpeedWalkSpeed or entity.baseSpeed
		humanoid.JumpHeight = Config.JumpHeight
	end
end

-- Frozen entities can't move, bonk or be bonked (the countdown before a round)
function CombatService.Freeze(entity, frozen)
	entity.frozen = frozen
	CombatService.UpdateMovement(entity)
end

-- Clears damage and power-ups, for a fresh round
function CombatService.Reset(entity)
	CombatService.SetDamage(entity, 0)
	entity.lastHit = nil
	entity.stunUntil = 0
	entity.shield = 0
	entity.giantUntil = 0
	entity.speedUntil = 0
	entity.ironUntil = 0
	entity.magnetUntil = 0
	local wasGiant = entity.model:GetAttribute("GiantHammer")
	entity.model:SetAttribute("GiantHammer", nil)
	for _, name in ipairs({ "BonkShield", "IronBoots" }) do
		local item = entity.model:FindFirstChild(name)
		if item then
			item:Destroy()
		end
	end
	if entity.player then
		CosmeticService.RefreshHammer(entity.player, 1)
	elseif wasGiant and entity.hammerItem then
		CosmeticService.BuildHammer(entity.model, entity.hammerItem, 1)
	end
	CombatService.UpdateMovement(entity)
	if entity.humanoid then
		entity.humanoid.PlatformStand = false
	end
end

-- Sends an entity flying. Players' computers move their own characters; the
-- server moves bots and dummies itself.
function CombatService.Launch(entity, velocity, stun)
	if not alive(entity) then
		return
	end
	local now = os.clock()
	entity.stunUntil = math.max(entity.stunUntil, now + stun)
	local spinAxis = flat(velocity).Magnitude > 0.1 and flat(velocity).Unit:Cross(Vector3.yAxis) or Vector3.xAxis
	local spin = spinAxis * random:NextNumber(4, 9)
	if entity.player then
		Remotes.Launch:FireClient(entity.player, velocity, stun, spin)
		return
	end
	entity.stunToken += 1
	local token = entity.stunToken
	entity.humanoid.PlatformStand = true
	entity.root.AssemblyLinearVelocity = velocity
	entity.root.AssemblyAngularVelocity = spin
	task.delay(stun, function()
		if entity.stunToken == token and entity.humanoid.Parent then
			entity.humanoid.PlatformStand = false
			entity.root.AssemblyAngularVelocity = Vector3.zero
			-- Stand back up straight
			local position = entity.root.Position
			local look = flat(entity.root.CFrame.LookVector)
			if look.Magnitude < 0.1 then
				look = Vector3.new(0, 0, -1)
			end
			entity.root.CFrame = CFrame.lookAt(position, position + look)
		end
	end)
end

-- A push that doesn't come from a bonk (bouncy walls, the sweeper bar, a banana).
-- by = the entity that caused it, if any, so a fall still counts as their knockout.
function CombatService.Push(entity, velocity, stun, addDamage, by)
	if not alive(entity) or entity.frozen then
		return
	end
	if addDamage and addDamage > 0 then
		CombatService.SetDamage(entity, entity.damage + addDamage)
	end
	if entity.ironUntil > os.clock() then
		velocity = Vector3.new(velocity.X * PowerUps.IronShare, velocity.Y, velocity.Z * PowerUps.IronShare)
	end
	if by then
		entity.lastHit = { by = by, time = os.clock() }
	end
	CombatService.Launch(entity, velocity, stun)
end

------------------------------------------------------------------ Bonking
-- The right shoulder joint and the axis that lifts the arm forward. Older rigs
-- use a Motor6D (turn its C0); newer ones an AnimationConstraint (turn the
-- shoulder attachment on the torso instead).
local function shoulder(model)
	local joint, axis = nil, nil
	local arm = model:FindFirstChild("RightUpperArm")
	if arm and arm:FindFirstChild("RightShoulder") then
		joint, axis = arm.RightShoulder, Vector3.xAxis
	else
		local torso = model:FindFirstChild("Torso")
		if torso and torso:FindFirstChild("Right Shoulder") then
			joint, axis = torso["Right Shoulder"], Vector3.zAxis
		end
	end
	if not joint then
		return nil
	end
	if joint:IsA("Motor6D") then
		return joint, "C0", axis
	elseif joint:IsA("AnimationConstraint") and joint.Attachment0 then
		return joint.Attachment0, "CFrame", axis
	end
	return nil
end

-- Swings the right arm (and the hammer in that hand) up and down
local function swing(entity)
	local target, property, axis = shoulder(entity.model)
	if not target then
		return
	end
	if entity.shoulderTarget ~= target then
		entity.shoulderTarget = target
		entity.shoulderBase = target[property]
	end
	local base = entity.shoulderBase
	local function at(degrees)
		return base * CFrame.fromAxisAngle(axis, math.rad(degrees))
	end
	entity.swingToken = (entity.swingToken or 0) + 1
	local token = entity.swingToken
	TweenService:Create(target, TweenInfo.new(0.07), { [property] = at(165) }):Play()
	task.delay(0.07, function()
		if entity.swingToken ~= token or not target.Parent then
			return
		end
		TweenService
			:Create(
				target,
				TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{ [property] = at(55) }
			)
			:Play()
		task.delay(0.22, function()
			if entity.swingToken ~= token or not target.Parent then
				return
			end
			TweenService:Create(target, TweenInfo.new(0.2), { [property] = base }):Play()
		end)
	end)
end

-- One landed bonk: adds damage and sends the target flying away from the attacker.
-- options.power multiplies the push (Giant Hammer).
function CombatService.Hit(attacker, target, options)
	options = options or {}
	if not alive(target) or target.frozen then
		return false
	end
	local now = os.clock()
	local away = flat(target.root.Position - attacker.root.Position)
	if away.Magnitude < 0.1 then
		away = flat(attacker.root.CFrame.LookVector)
	end
	away = away.Unit

	if target.shield > 0 then
		target.shield -= 1
		if target.shield <= 0 then
			local bubble = target.model:FindFirstChild("BonkShield")
			if bubble then
				bubble:Destroy()
			end
		end
		CombatService.Effect("block", target.root.Position)
		-- The shield bounces the attacker back a little
		CombatService.Launch(attacker, -away * 35 + Vector3.yAxis * 20, 0.3)
		return false
	end

	local power = options.power or 1
	local amount = random:NextInteger(Config.BonkDamageMin, Config.BonkDamageMax)
	if power > 1 then
		amount = math.floor(amount * 1.25)
	end
	CombatService.SetDamage(target, target.damage + amount)
	local speed, up = Config.Knockback(target.damage)
	if target.ironUntil > now then
		power *= PowerUps.IronShare
	end
	local velocity = away * speed * power + Vector3.yAxis * up * math.max(power, 0.7)
	target.lastHit = { by = attacker, time = now }
	CombatService.Launch(target, velocity, Config.Stun(target.damage))
	CombatService.Effect(
		"hit",
		target.root.Position,
		{ damage = amount, total = math.floor(target.damage), big = power > 1 }
	)
	for _, listener in ipairs(hitListeners) do
		task.spawn(listener, attacker, target)
	end
	return true
end

local function resolveBonk(entity)
	if not alive(entity) or entity.frozen or entity.stunUntil > os.clock() then
		return -- got bonked during the swing
	end
	local now = os.clock()
	local giant = entity.giantUntil > now
	local magnet = entity.magnetUntil > now
	local range = Config.BonkRange + (giant and PowerUps.GiantReach or 0)
	if magnet then
		range = math.max(range, PowerUps.MagnetBonkRange)
		entity.magnetUntil = 0
		CombatService.Effect("shockwave", entity.root.Position, { range = range })
	end
	local origin = entity.root.Position
	local look = flat(entity.root.CFrame.LookVector)
	look = look.Magnitude > 0.1 and look.Unit or Vector3.new(0, 0, -1)
	local minDot = math.cos(math.rad(Config.BonkArc / 2))
	for _, target in ipairs(targetsFor(entity)) do
		if target ~= entity and alive(target) then
			local offset = target.root.Position - origin
			local flatOffset = flat(offset)
			local distance = flatOffset.Magnitude
			if distance <= range and math.abs(offset.Y) <= 6 then
				if magnet or distance < 2.5 or look:Dot(flatOffset.Unit) >= minDot then
					CombatService.Hit(entity, target, { power = giant and PowerUps.GiantPower or 1 })
				end
			end
		end
	end
end

-- Starts a swing if the entity is allowed to. The hit lands a moment later.
function CombatService.TryBonk(entity)
	local now = os.clock()
	if not alive(entity) or entity.frozen or now < entity.stunUntil or now - entity.lastBonk < Config.BonkCooldown then
		return false
	end
	entity.lastBonk = now
	swing(entity)
	CombatService.Effect("swing", entity.root.Position)
	for _, listener in ipairs(bonkListeners) do
		task.spawn(listener, entity)
	end
	task.delay(Config.BonkImpactDelay, resolveBonk, entity)
	return true
end

-- Bots dash on the server (players dash on their own computer, see Controls.luau)
function CombatService.Dash(entity, direction)
	local now = os.clock()
	if not alive(entity) or entity.frozen or now < entity.stunUntil or now - entity.lastDash < Config.DashCooldown then
		return false
	end
	entity.lastDash = now
	local dir = flat(direction or entity.root.CFrame.LookVector)
	if dir.Magnitude < 0.1 then
		return false
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "DashAttachment"
	attachment.Parent = entity.root
	local mover = Instance.new("LinearVelocity")
	mover.Name = "Dash"
	mover.Attachment0 = attachment
	mover.RelativeTo = Enum.ActuatorRelativeTo.World
	mover.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	mover.MaxAxesForce = Vector3.new(1e6, 0, 1e6)
	mover.VectorVelocity = dir.Unit * Config.DashSpeed
	mover.Parent = entity.root
	task.delay(Config.DashSeconds, function()
		mover:Destroy()
		attachment:Destroy()
	end)
	CombatService.Effect("dash", entity.root.Position)
	return true
end

function CombatService.All()
	return entities
end

function CombatService.Start()
	local function watch(player)
		player.CharacterRemoving:Connect(function(character)
			CombatService.Unregister(character)
		end)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("HumanoidRootPart", 10)
			character:WaitForChild("Humanoid", 10)
			if character.Parent then
				CombatService.Register(
					character,
					{ kind = "player", player = player, name = player.DisplayName, key = "p" .. player.UserId }
				)
			end
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		watch(player)
		if player.Character then
			CombatService.Register(
				player.Character,
				{ kind = "player", player = player, name = player.DisplayName, key = "p" .. player.UserId }
			)
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		byPlayer[player] = nil
	end)

	-- Speed Boots and the Giant Hammer wear off
	task.spawn(function()
		while true do
			task.wait(0.25)
			local now = os.clock()
			for _, entity in pairs(entities) do
				if entity.speedEnds and now >= entity.speedUntil then
					entity.speedEnds = nil
					CombatService.UpdateMovement(entity)
				end
				if entity.model:GetAttribute("GiantHammer") and now >= entity.giantUntil then
					entity.model:SetAttribute("GiantHammer", nil)
					if entity.player then
						CosmeticService.RefreshHammer(entity.player, 1)
					else
						CosmeticService.BuildHammer(entity.model, entity.hammerItem, 1)
					end
				end
				if entity.ironUntil > 0 and now >= entity.ironUntil then
					entity.ironUntil = 0
					local boots = entity.model:FindFirstChild("IronBoots")
					if boots then
						boots:Destroy()
					end
				end
			end
		end
	end)

	Remotes.Bonk.OnServerEvent:Connect(function(player)
		local entity = byPlayer[player]
		if entity then
			CombatService.TryBonk(entity)
		end
	end)
	-- Players dash on their own computer; show the puff to everyone else
	Remotes.Dash.OnServerEvent:Connect(function(player)
		local entity = byPlayer[player]
		if entity and alive(entity) and os.clock() - entity.lastDash >= Config.DashCooldown * 0.8 then
			entity.lastDash = os.clock()
			CombatService.Effect("dash", entity.root.Position)
		end
	end)
end

return CombatService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">CosmeticService</string><ProtectedString name="Source"><![CDATA[-- How everyone looks: name tags (name, level, title, VIP, crowns and damage %
-- in fight rounds), trails, the VIP crown, hammers in fight rounds and crown dances.
-- Also hands out the free cosmetics players unlock by levelling up or playing.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Cosmetics = require(Shared.Cosmetics)
local Remotes = require(Shared.Remotes)
local Level = require(Shared.Level)
local Format = require(Shared.Format)

local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)

local CosmeticService = {}

local VIP_GOLD = Color3.fromRGB(255, 200, 40)
local applied = {} -- [player] = signature of what is shown, to skip needless rebuilds
local tagConnections = {} -- [model] = connections that keep the damage line up to date

local function isVip(player)
	return ShopService.HasPass(player, "VIP")
end

-- The cosmetic a player shows for a kind (falls back to the free default)
function CosmeticService.Equipped(player, kind)
	local data = DataService.Get(player)
	if not data then
		return Cosmetics.ById[Cosmetics.Defaults[kind] or ""]
	end
	return Cosmetics.Equipped(data, kind, isVip(player))
end

------------------------------------------------------------------ Hammers
local function piece(hammer, hand, gripY, props)
	local p = Instance.new("Part")
	p.Name = props.Name or "Piece"
	p.Size = props.Size
	p.Shape = props.Shape or Enum.PartType.Block
	p.Color = props.Color
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.Mesh then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	local weld = Instance.new("Weld")
	weld.Part0 = hand
	weld.Part1 = p
	weld.C0 = CFrame.new(0, gripY, 0) * props.CFrame
	weld.Parent = p
	p.CFrame = hand.CFrame * weld.C0
	p.Parent = hammer
	return p
end

-- Builds the hammer in the model's right hand. The handle points forward from
-- the hand, so swinging the arm brings the head down in front of you.
-- scale > 1 for the Giant Hammer power-up.
function CosmeticService.BuildHammer(model, item, scale)
	scale = scale or 1
	item = item or Cosmetics.ById[Cosmetics.Defaults.hammer]
	local old = model:FindFirstChild("BonkHammer")
	if old then
		old:Destroy()
	end
	local hand = model:FindFirstChild("RightHand") or model:FindFirstChild("Right Arm")
	if not hand then
		return
	end
	local gripY = hand.Name == "RightHand" and -0.15 or -0.9
	local hammer = Instance.new("Model")
	hammer.Name = "BonkHammer"
	local s = scale
	local forward = CFrame.Angles(0, math.rad(90), 0) -- a cylinder's length runs forward
	local upright = CFrame.Angles(0, 0, math.rad(90)) -- a cylinder's length runs up and down

	if item.shape == "chicken" then
		piece(
			hammer,
			hand,
			gripY,
			{
				Name = "Legs",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(2 * s, 0.3, 0.3),
				CFrame = CFrame.new(0, 0, -0.9 * s) * forward,
				Color = item.handle,
			}
		)
		piece(
			hammer,
			hand,
			gripY,
			{
				Name = "Head",
				Mesh = true,
				Size = Vector3.new(1.4, 1.4, 3.2) * s,
				CFrame = CFrame.new(0, 0, -3.4 * s),
				Color = item.head,
				Material = item.material,
			}
		)
		piece(
			hammer,
			hand,
			gripY,
			{
				Name = "Neck",
				Mesh = true,
				Size = Vector3.new(0.8, 0.8, 1.8) * s,
				CFrame = CFrame.new(0, 0.3 * s, -5.3 * s) * CFrame.Angles(math.rad(-20), 0, 0),
				Color = item.head,
				Material = item.material,
			}
		)
		piece(
			hammer,
			hand,
			gripY,
			{
				Name = "Comb",
				Size = Vector3.new(0.2, 0.6, 0.8) * s,
				CFrame = CFrame.new(0, 0.85 * s, -6 * s),
				Color = Color3.fromRGB(230, 40, 40),
			}
		)
		piece(
			hammer,
			hand,
			gripY,
			{
				Name = "Beak",
				Size = Vector3.new(0.4, 0.3, 0.6) * s,
				CFrame = CFrame.new(0, 0.5 * s, -6.6 * s),
				Color = item.handle,
			}
		)
	elseif item.shape == "fish" then
		piece(
			hammer,
			hand,
			gripY,
			{
				Name = "Tail",
				Size = Vector3.new(0.2, 1.4, 1) * s,
				CFrame = CFrame.new(0, 0, -0.3 * s),
				Color = item.handle,
			}
		)
		piece(
			hammer,
			hand,
			gripY,
			{
				Name = "Head",
				Mesh = true,
				Size = Vector3.new(1, 1.8, 4.2) * s,
				CFrame = CFrame.new(0, 0, -2.9 * s),
				Color = item.head,
				Material = item.material,
			}
		)
		piece(
			hammer,
			hand,
			gripY,
			{
				Name = "Fin",
				Size = Vector3.new(0.15, 0.8, 1.2) * s,
				CFrame = CFrame.new(0, 0.95 * s, -2.8 * s),
				Color = item.handle,
			}
		)
		for _, side in ipairs({ -1, 1 }) do
			piece(
				hammer,
				hand,
				gripY,
				{
					Name = "Eye",
					Shape = Enum.PartType.Ball,
					Size = Vector3.one * 0.35 * s,
					CFrame = CFrame.new(0.42 * side * s, 0.25 * s, -4.4 * s),
					Color = Color3.new(1, 1, 1),
				}
			)
		end
	else
		piece(
			hammer,
			hand,
			gripY,
			{
				Name = "Handle",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(3.4 * s, 0.35 * s, 0.35 * s),
				CFrame = CFrame.new(0, 0, -1.4 * s) * forward,
				Color = item.handle,
				Material = item.material == Enum.Material.Neon and Enum.Material.SmoothPlastic or item.material,
			}
		)
		if item.shape == "mallet" then
			piece(
				hammer,
				hand,
				gripY,
				{
					Name = "Head",
					Size = Vector3.new(1.5, 2.6, 1.5) * s,
					CFrame = CFrame.new(0, 0, -3.3 * s),
					Color = item.head,
					Material = item.material,
				}
			)
		else
			piece(
				hammer,
				hand,
				gripY,
				{
					Name = "Head",
					Shape = Enum.PartType.Cylinder,
					Size = Vector3.new(2.6 * s, 1.6 * s, 1.6 * s),
					CFrame = CFrame.new(0, 0, -3.3 * s) * upright,
					Color = item.head,
					Material = item.material,
				}
			)
			for _, side in ipairs({ -1, 1 }) do
				piece(
					hammer,
					hand,
					gripY,
					{
						Name = "Cap",
						Shape = Enum.PartType.Cylinder,
						Size = Vector3.new(0.25 * s, 1.75 * s, 1.75 * s),
						CFrame = CFrame.new(0, 1.3 * side * s, -3.3 * s) * upright,
						Color = item.handle,
						Material = item.material == Enum.Material.Neon and Enum.Material.Neon
							or Enum.Material.SmoothPlastic,
					}
				)
			end
		end
	end
	hammer.Parent = model
	return hammer
end

------------------------------------------------------------------ Name tags
-- info = { name, nameColor, title (cosmetic item or nil), subtitle }
function CosmeticService.Tag(model, info)
	local head = model:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("BonkTag")
	if old then
		old:Destroy()
	end
	if tagConnections[model] then
		for _, connection in ipairs(tagConnections[model]) do
			connection:Disconnect()
		end
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "BonkTag"
	gui.Size = UDim2.fromOffset(220, 96)
	gui.StudsOffset = Vector3.new(0, 3.4, 0)
	gui.MaxDistance = 140
	gui.Adornee = head
	local layout = Instance.new("UIListLayout")
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = gui
	local order = 0
	local function line(name, text, color, height)
		order += 1
		local label = Instance.new("TextLabel")
		label.Name = name
		label.Size = UDim2.new(1, 0, 0, height)
		label.BackgroundTransparency = 1
		label.Text = text
		label.TextColor3 = color
		label.TextScaled = true
		label.Font = Enum.Font.FredokaOne
		label.TextStrokeTransparency = 0.3
		label.LayoutOrder = order
		label.Parent = gui
		return label
	end
	local damage = line("Damage", "0%", Color3.new(1, 1, 1), 30)
	if info.title then
		line("Title", info.title.text, info.title.color, 16)
	end
	line("PlayerName", info.name, info.nameColor or Color3.new(1, 1, 1), 22)
	line("Sub", info.subtitle or "", Color3.fromRGB(150, 220, 255), 16)

	local function refresh()
		local value = math.floor(model:GetAttribute("Damage") or 0)
		damage.Text = value .. "%"
		damage.TextColor3 = Format.DamageColor(value)
		damage.Visible = model:GetAttribute("ShowDamage") == true
	end
	tagConnections[model] = {
		model:GetAttributeChangedSignal("Damage"):Connect(refresh),
		model:GetAttributeChangedSignal("ShowDamage"):Connect(refresh),
		model.Destroying:Connect(function()
			tagConnections[model] = nil
		end),
	}
	refresh()
	gui.Parent = head
end

------------------------------------------------------------------ Players
local function clearOld(character)
	for _, item in ipairs(character:GetDescendants()) do
		if
			item.Name == "BonkTrail"
			or item.Name == "BonkCrown"
			or item.Name == "BonkTrailTop"
			or item.Name == "BonkTrailBottom"
		then
			item:Destroy()
		end
	end
end

local function applyToCharacter(player)
	local data = DataService.Get(player)
	local character = player.Character
	if not data or not character then
		return
	end
	local head = character:WaitForChild("Head", 5)
	local root = character:WaitForChild("HumanoidRootPart", 5)
	if not head or not root or not character.Parent then
		return
	end
	clearOld(character)

	local vip = isVip(player)
	local title = Cosmetics.Equipped(data, "title", vip)
	CosmeticService.Tag(character, {
		name = player.DisplayName,
		nameColor = vip and VIP_GOLD or nil,
		title = title,
		subtitle = string.format(
			"%sLv %d%s",
			vip and "VIP  " or "",
			Level.FromXp(data.xp),
			data.stats.crowns > 0
					and ("  -  " .. data.stats.crowns .. " crown" .. (data.stats.crowns == 1 and "" or "s"))
				or ""
		),
	})

	if character:GetAttribute("HasHammer") then
		CosmeticService.BuildHammer(character, Cosmetics.Equipped(data, "hammer", vip))
	end

	if vip then
		local crown = Instance.new("Part")
		crown.Name = "BonkCrown"
		crown.Size = Vector3.new(1.1, 0.5, 1.1)
		crown.Color = VIP_GOLD
		crown.Material = Enum.Material.Neon
		crown.CanCollide = false
		crown.CanQuery = false
		crown.CanTouch = false
		crown.Massless = true
		local weld = Instance.new("Weld")
		weld.Part0 = head
		weld.Part1 = crown
		weld.C0 = CFrame.new(0, head.Size.Y / 2 + 0.3, 0)
		weld.Parent = crown
		crown.Parent = character
	end

	local trailItem = Cosmetics.Equipped(data, "trail", vip)
	if trailItem then
		local top = Instance.new("Attachment")
		top.Name = "BonkTrailTop"
		top.Position = Vector3.new(0, 0.8, 0.5)
		top.Parent = root
		local bottom = Instance.new("Attachment")
		bottom.Name = "BonkTrailBottom"
		bottom.Position = Vector3.new(0, -0.8, 0.5)
		bottom.Parent = root
		local keypoints = {}
		for index, color in ipairs(trailItem.colors) do
			table.insert(keypoints, ColorSequenceKeypoint.new((index - 1) / math.max(1, #trailItem.colors - 1), color))
		end
		local trail = Instance.new("Trail")
		trail.Name = "BonkTrail"
		trail.Attachment0 = top
		trail.Attachment1 = bottom
		trail.Color = ColorSequence.new(keypoints)
		trail.Lifetime = 0.6
		trail.LightEmission = 0.6
		trail.Transparency = NumberSequence.new(0.2, 1)
		trail.Parent = root
	end
end

-- Rebuilds a player's hammer (scale > 1 for a giant one)
function CosmeticService.RefreshHammer(player, scale)
	local character = player.Character
	if character and character:GetAttribute("HasHammer") then
		CosmeticService.BuildHammer(character, CosmeticService.Equipped(player, "hammer"), scale)
	end
end

-- Hands out (or takes away) the foam hammer for fight rounds
function CosmeticService.SetHammer(model, on, player)
	model:SetAttribute("HasHammer", on or nil)
	if on then
		if player then
			CosmeticService.BuildHammer(model, CosmeticService.Equipped(player, "hammer"))
		end
	else
		local hammer = model:FindFirstChild("BonkHammer")
		if hammer then
			hammer:Destroy()
		end
	end
end

local function signature(data, runtime)
	local equipped = data.cosmetics.equipped
	return table.concat({
		tostring(equipped.title),
		tostring(equipped.trail),
		tostring(equipped.hammer),
		tostring(runtime.passes and runtime.passes.VIP),
		tostring(Level.FromXp(data.xp)),
		tostring(data.stats.crowns),
	}, "|")
end

------------------------------------------------------------------ Free unlocks
local function unlocked(item, data)
	if item.source == "level" then
		return Level.FromXp(data.xp) >= item.level
	elseif item.source == "earned" then
		return (data.stats[item.rule] or 0) >= item.amount
	end
	return false
end

local function checkUnlocks(player, data)
	local new = {}
	for _, item in ipairs(Cosmetics.List) do
		if
			(item.source == "level" or item.source == "earned")
			and not data.cosmetics.owned[item.id]
			and unlocked(item, data)
		then
			table.insert(new, item)
		end
	end
	if #new == 0 then
		return
	end
	DataService.Update(player, function(saved)
		for _, item in ipairs(new) do
			saved.cosmetics.owned[item.id] = true
		end
	end)
	for _, item in ipairs(new) do
		Remotes.Notify:FireClient(player, "Unlocked: " .. item.name .. "! Equip it in the Locker.", "rare")
	end
end

------------------------------------------------------------------ Victory dances
-- Each dance moves the whole character for a few seconds: t = seconds since the
-- start, returns an offset from where the character stands.
local DANCES = {
	dance_cheer = function(t)
		local hop = math.abs(math.sin(t * math.pi * 1.6)) * 2.5
		return CFrame.new(0, hop, 0)
	end,
	dance_jump = function(t)
		local cycle = t % 2
		local height = math.max(0, math.sin(cycle / 1.2 * math.pi)) * 9
		local turn = cycle < 1.2 and cycle / 1.2 * math.pi * 2 or 0
		return CFrame.new(0, height, 0) * CFrame.Angles(0, turn, 0)
	end,
	dance_spin = function(t)
		return CFrame.Angles(0, t * math.pi * 3, 0)
	end,
	dance_hop = function(t)
		local hop = math.abs(math.sin(t * math.pi * 2.5)) * 1.8
		local side = math.sin(t * math.pi * 1.25) * 2
		return CFrame.new(side, hop, 0)
	end,
	dance_flip = function(t)
		local cycle = t % 1.6
		local height = math.max(0, math.sin(cycle / 1.1 * math.pi)) * 6
		local flip = cycle < 1.1 and cycle / 1.1 * math.pi * 2 or 0
		return CFrame.new(0, height, 0) * CFrame.Angles(flip, 0, 0)
	end,
	dance_heli = function(t)
		local height = math.sin(math.min(t, 5) / 5 * math.pi) * 7
		return CFrame.new(0, height, 0) * CFrame.Angles(0, t * math.pi * 8, 0)
	end,
}

-- Plays a victory dance on a model standing at standCFrame, for seconds.
function CosmeticService.Dance(model, danceId, standCFrame, seconds)
	local root = model:FindFirstChild("HumanoidRootPart")
	local dance = DANCES[danceId] or DANCES.dance_cheer
	if not root then
		return
	end
	root.Anchored = true
	local started = os.clock()
	local connection
	connection = RunService.Heartbeat:Connect(function()
		local t = os.clock() - started
		if t >= seconds or not root.Parent then
			connection:Disconnect()
			if root.Parent then
				model:PivotTo(standCFrame)
				root.Anchored = false
			end
			return
		end
		model:PivotTo(standCFrame * dance(t))
	end)
end

function CosmeticService.Start()
	DataService.OnChanged(function(player, data, runtime)
		checkUnlocks(player, data)
		local current = signature(data, runtime)
		if applied[player] ~= current then
			applied[player] = current
			applyToCharacter(player)
		end
	end)

	local function watch(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.3)
			applyToCharacter(player)
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		watch(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		applied[player] = nil
	end)
end

return CosmeticService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">CourseBuilder</string><ProtectedString name="Source"><![CDATA[-- Turns a course (a list of kit pieces, see Shared/Courses) into parts in the
-- world, and works out everything the game needs to run it: where you start,
-- the checkpoints, the finish, the gems, how low you can fall in each section,
-- the path bots follow and a par time.

local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Worlds = require(Shared.Worlds)
local Motion = require(Shared.Motion)

local Kit = require(script.Parent.Kit)

local CourseBuilder = {}

local function sign(parentPart, text)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 30
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = text
		label.TextScaled = true
		label.Font = Enum.Font.FredokaOne
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 0.3
		label.Parent = gui
		gui.Parent = parentPart
	end
end
CourseBuilder.Sign = sign

-- A spinning gem. Its index (1 to 3) lets each player's screen dim the gems
-- they already found.
local function makeGem(folder, courseId, index, position)
	local gem = Instance.new("Part")
	gem.Name = "Gem" .. index
	gem.Size = Vector3.new(1.6, 2.4, 1.6)
	gem.Color = Color3.fromRGB(80, 230, 255)
	gem.Material = Enum.Material.Neon
	gem.Anchored = true
	gem.CanCollide = false
	gem.CanQuery = false
	gem.CanTouch = false
	gem:SetAttribute("Motion", "spin")
	gem:SetAttribute("Home", CFrame.new(position))
	gem:SetAttribute("Offset", CFrame.Angles(0, 0, math.rad(45)) * CFrame.Angles(math.rad(45), 0, 0))
	gem:SetAttribute("Speed", 2)
	gem:SetAttribute("GemIndex", index)
	gem:SetAttribute("CourseId", courseId)
	gem.CFrame = CFrame.new(position)
	CollectionService:AddTag(gem, Motion.Tag)
	CollectionService:AddTag(gem, "Gem")
	local light = Instance.new("PointLight")
	light.Color = gem.Color
	light.Range = 10
	light.Parent = gem
	gem.Parent = folder
	return gem
end

-- Rough time for a good run along the bot path (for par)
local function estimateTime(nodes, start)
	local seconds = 0
	local last = start
	for _, node in ipairs(nodes) do
		local target = node.to
			or node.exit
			or node.past
			or (node.choices and node.choices[1] and node.choices[1].at)
			or node.z
		if typeof(target) == "Vector3" and last then
			seconds += (target - last).Magnitude / Config.WalkSpeed
			last = target
		end
		if node.kind == "ride" then
			seconds += node.spec.period * 0.6
		elseif node.kind == "wait" then
			seconds += node.spec.period * 0.3
		elseif node.kind == "tiles" then
			seconds += 0.6
		elseif node.kind == "lava" or node.kind == "zip" then
			seconds += 1
		end
	end
	return seconds
end

-- Builds a course with its start at origin (a CFrame facing the way the course
-- runs). theme = a world id, for colours. Returns the course object.
function CourseBuilder.Build(courseData, origin, parent, themeId)
	local folder = Instance.new("Model")
	folder.Name = "Course_" .. courseData.id
	local theme = Worlds.ById[themeId or courseData.world] or Worlds.List[1]
	local ctx = {
		folder = folder,
		theme = theme,
		random = Random.new(courseData.seed or #courseData.id * 7919 + string.byte(courseData.id, -1)),
		sign = sign,
	}

	local course = {
		id = courseData.id,
		data = courseData,
		folder = folder,
		theme = theme,
		origin = origin,
		start = nil,
		checkpoints = {}, -- [1..n] = { spawn, center, size, killY }
		finish = nil,
		gems = {}, -- [1..3] = Vector3
		gemParts = {},
		nodes = {},
		sections = {}, -- [0..n] = lowest floor height in that section
		fallTiles = {},
		fakeDoors = {},
		windZones = {},
	}

	local cursor = origin
	local section = 0
	course.sections[0] = origin.Position.Y
	for index, entry in ipairs(courseData.pieces) do
		local kind = entry[1]
		local result = Kit.Build(kind, ctx, cursor, entry)
		if result.start then
			course.start = result.start
		end
		if result.checkpoint then
			section += 1
			course.sections[section] = result.minY
			table.insert(course.checkpoints, result.checkpoint)
			table.insert(course.nodes, { kind = "checkpoint", index = section })
		else
			course.sections[section] = math.min(course.sections[section], result.minY)
		end
		if result.finish then
			course.finish = result.finish
		end
		if result.gemSpot and #course.gems < 3 then
			table.insert(course.gems, result.gemSpot)
		end
		for _, node in ipairs(result.nodes) do
			node.piece = index
			table.insert(course.nodes, node)
		end
		cursor = result.cursor
	end
	course.endCursor = cursor

	for index, checkpoint in ipairs(course.checkpoints) do
		checkpoint.killY = course.sections[index] - Config.FallBelow
	end
	course.startKillY = course.sections[0] - Config.FallBelow
	for index, position in ipairs(course.gems) do
		course.gemParts[index] = makeGem(folder, courseData.id, index, position)
	end

	for _, item in ipairs(folder:GetDescendants()) do
		if CollectionService:HasTag(item, "FallTile") then
			table.insert(course.fallTiles, { part = item, home = item.CFrame, state = "up" })
		elseif CollectionService:HasTag(item, "FakeDoor") then
			table.insert(course.fakeDoors, { part = item, home = item.CFrame, broken = false })
		end
	end

	local estimate = estimateTime(course.nodes, course.start and course.start.spawn.Position)
	course.par = courseData.par or math.max(10, math.floor(estimate * 1.3 + 4))

	folder:SetAttribute("CourseId", courseData.id)
	folder:SetAttribute("World", theme.id)
	folder.Parent = parent
	return course
end

-- The lowest a player in a section can be before it counts as a fall
function CourseBuilder.KillY(course, checkpointIndex)
	if checkpointIndex <= 0 then
		return course.startKillY
	end
	local checkpoint = course.checkpoints[checkpointIndex]
	return checkpoint and checkpoint.killY or course.startKillY
end

-- True if a world position is inside a box (cframe + size)
function CourseBuilder.InBox(position, cframe, size)
	local offset = cframe:PointToObjectSpace(position)
	return math.abs(offset.X) <= size.X / 2 and math.abs(offset.Y) <= size.Y / 2 and math.abs(offset.Z) <= size.Z / 2
end

return CourseBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">CourseService</string><ProtectedString name="Source"><![CDATA[-- Runs courses: builds them on demand in their own spot in the sky, and keeps
-- track of everyone running one (a "run"): the timer, checkpoints, gems,
-- falling and coming back, the finish. Adventure (solo play) and tournament
-- races both use it; they pass callbacks for what happens at the finish.
--
-- A course built for Adventure is shared: everyone playing that course on the
-- server runs on the same copy (each with their own timer). Tournament races get
-- their own copy.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local CourseBuilder = require(script.Parent.CourseBuilder)

local CourseService = {}

local SLOT_ORIGIN = Vector3.new(4000, 300, 0)
local SLOT_SPACING = 1400
local GEM_RADIUS = 4.5

local folder
local slots = {} -- [index] = instance or nil
local instances = {} -- [key] = instance
local runs = {} -- [runner key] = run
local random = Random.new()

local function now()
	return Workspace:GetServerTimeNow()
end

------------------------------------------------------------------ Course instances
local function freeSlot()
	for index = 1, Config.CourseSlots do
		if not slots[index] then
			return index
		end
	end
	return nil
end

-- Builds a course (or returns the copy already built under that key)
function CourseService.Open(courseData, key, themeId)
	key = key or courseData.id
	local existing = instances[key]
	if existing then
		existing.emptySince = nil
		return existing
	end
	local slot = freeSlot()
	if not slot then
		return nil, "The game is busy, try again in a moment"
	end
	local origin = CFrame.new(SLOT_ORIGIN + Vector3.new((slot - 1) * SLOT_SPACING, 0, 0))
	local course = CourseBuilder.Build(courseData, origin, folder, themeId)
	local instance = {
		key = key,
		slot = slot,
		course = course,
		emptySince = nil,
		shared = key == courseData.id,
	}
	slots[slot] = instance
	instances[key] = instance
	return instance
end

function CourseService.Close(instance)
	if instances[instance.key] ~= instance then
		return
	end
	for runnerKey, run in pairs(runs) do
		if run.instance == instance then
			runs[runnerKey] = nil
		end
	end
	instances[instance.key] = nil
	slots[instance.slot] = nil
	instance.course.folder:Destroy()
end

local function runnersIn(instance)
	local list = {}
	for _, run in pairs(runs) do
		if run.instance == instance then
			table.insert(list, run)
		end
	end
	return list
end

------------------------------------------------------------------ Runs
local function rootOf(run)
	if run.player then
		local character = run.player.Character
		return character and character:FindFirstChild("HumanoidRootPart")
	end
	return run.bot and run.bot.root
end

local function send(run, event, info)
	if run.player then
		Remotes.Run:FireClient(run.player, event, info)
	end
end

-- { true, false, true }: remotes drop gaps in number-keyed tables, so no nils
local function gemList(set)
	return { set[1] == true, set[2] == true, set[3] == true }
end

-- What a player's screen needs to show their run
local function summary(run)
	local course = run.instance.course
	return {
		courseId = course.id,
		name = course.data.name,
		world = course.theme.id,
		mode = run.mode,
		started = run.started,
		checkpoint = run.checkpoint,
		checkpoints = #course.checkpoints,
		gems = gemList(run.gems),
		savedGems = gemList(run.savedGems),
		falls = run.falls,
		canSkip = run.fallsHere >= Config.SkipAfterFalls and run.mode == "adventure",
		skipped = run.skipped,
		par = course.par,
		finished = run.finished,
	}
end
CourseService.Summary = summary

local function placeRunner(run, cframe)
	local root = rootOf(run)
	if not root then
		return
	end
	if run.player then
		local character = run.player.Character
		pcall(function()
			run.player:RequestStreamAroundAsync(cframe.Position, 2)
		end)
		character:PivotTo(cframe)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.PlatformStand = false
		end
	elseif run.onPlaceBot then
		run.onPlaceBot(run, cframe)
	end
end

local function spawnFor(run)
	local course = run.instance.course
	if run.checkpoint > 0 then
		return course.checkpoints[run.checkpoint].spawn
	end
	return course.start.spawn
end

local function setKillY(run)
	run.killY = CourseBuilder.KillY(run.instance.course, run.checkpoint)
	if run.player then
		run.player:SetAttribute("KillY", run.killY)
	end
end

-- Puts a runner on a course. options:
--   mode = "adventure" | "race"
--   savedGems = { [1..3] = true } gems found on earlier runs (they still show, dimmed)
--   onFinish(run), onFall(run), onCheckpoint(run), onGem(run, index), onLeave(run)
--   frozen = true: wait at the start until CourseService.Release(run)
function CourseService.Enter(runner, instance, options)
	options = options or {}
	local key = typeof(runner) == "Instance" and ("p" .. runner.UserId) or runner.key
	local old = runs[key]
	if old and old.onLeave then
		task.spawn(old.onLeave, old)
	end
	local run = {
		key = key,
		player = typeof(runner) == "Instance" and runner or nil,
		bot = typeof(runner) ~= "Instance" and runner or nil,
		instance = instance,
		mode = options.mode or "adventure",
		started = nil,
		finished = false,
		checkpoint = 0,
		falls = 0,
		fallsHere = 0,
		gems = {},
		savedGems = options.savedGems or {},
		skipped = false,
		respawning = false,
		lastSafe = 0,
		options = options,
		onFinish = options.onFinish,
		onFall = options.onFall,
		onCheckpoint = options.onCheckpoint,
		onGem = options.onGem,
		onLeave = options.onLeave,
		onPlaceBot = options.onPlaceBot,
		frozen = options.frozen == true,
	}
	runs[key] = run
	instance.emptySince = nil
	setKillY(run)
	if run.player then
		run.player:SetAttribute("Course", instance.course.id)
		run.player:SetAttribute("CourseWorld", instance.course.theme.id)
	end
	local spot = instance.course.start.spawn * CFrame.new(random:NextNumber(-6, 6), 0, random:NextNumber(-2, 3))
	placeRunner(run, spot)
	send(run, "enter", summary(run))
	return run
end

-- Takes a runner off their course (doesn't move them)
function CourseService.Leave(runner)
	local key = typeof(runner) == "Instance" and ("p" .. runner.UserId) or runner.key
	local run = runs[key]
	if not run then
		return
	end
	runs[key] = nil
	if run.player then
		run.player:SetAttribute("Course", nil)
		run.player:SetAttribute("CourseWorld", nil)
		run.player:SetAttribute("KillY", nil)
		send(run, "leave", nil)
	end
	if run.onLeave then
		task.spawn(run.onLeave, run)
	end
end

function CourseService.Get(runner)
	local key = typeof(runner) == "Instance" and ("p" .. runner.UserId) or runner.key
	return runs[key]
end

-- Starts a frozen run's timer (tournament races start everyone together)
function CourseService.Release(run)
	run.frozen = false
	run.started = now()
	send(run, "update", summary(run))
end

-- Back to the start with a fresh timer
function CourseService.Restart(run)
	run.started = nil
	run.finished = false
	run.checkpoint = 0
	run.falls = 0
	run.fallsHere = 0
	run.gems = {}
	run.skipped = false
	setKillY(run)
	placeRunner(run, run.instance.course.start.spawn)
	send(run, "update", summary(run))
end

-- Back to the last checkpoint after a fall
function CourseService.Respawn(run, counts)
	if run.respawning or run.finished then
		return
	end
	run.respawning = true
	if counts ~= false then
		run.falls += 1
		run.fallsHere += 1
	end
	local root = rootOf(run)
	if root then
		Remotes.Effect:FireAllClients("fall", root.Position, {})
	end
	if run.onFall then
		task.spawn(run.onFall, run)
	end
	task.delay(Config.RespawnSeconds, function()
		run.respawning = false
		if runs[run.key] ~= run then
			return
		end
		placeRunner(run, spawnFor(run) * CFrame.new(random:NextNumber(-3, 3), 0, random:NextNumber(-1, 1)))
		send(run, "update", summary(run))
	end)
end

-- The free skip: jump to the next checkpoint (that run gets no stars)
function CourseService.Skip(run)
	local course = run.instance.course
	if run.fallsHere < Config.SkipAfterFalls or run.finished then
		return false
	end
	run.skipped = true
	run.fallsHere = 0
	if run.checkpoint < #course.checkpoints then
		run.checkpoint += 1
		setKillY(run)
		placeRunner(run, spawnFor(run))
	else
		placeRunner(run, course.finish.stand * CFrame.new(0, 0, 8))
	end
	if not run.started then
		run.started = now()
	end
	send(run, "update", summary(run))
	return true
end

local function finish(run)
	run.finished = true
	run.time = now() - (run.started or now())
	if run.onFinish then
		task.spawn(run.onFinish, run)
	end
	send(run, "update", summary(run))
end

-- One check of one runner: start line, checkpoints, gems, finish, falling
local function checkRun(run)
	if run.respawning then
		return
	end
	local root = rootOf(run)
	if not root then
		return
	end
	local course = run.instance.course
	local position = root.Position

	if not run.started and not run.frozen then
		local line = course.start.lineCFrame:PointToObjectSpace(position)
		if line.Z < -0.5 then
			run.started = now()
			send(run, "update", summary(run))
		end
	end

	if position.Y < run.killY then
		CourseService.Respawn(run)
		return
	end

	if run.finished then
		return
	end

	local nextCheckpoint = course.checkpoints[run.checkpoint + 1]
	if nextCheckpoint and CourseBuilder.InBox(position, nextCheckpoint.center, nextCheckpoint.size) then
		run.checkpoint += 1
		run.fallsHere = 0
		setKillY(run)
		if run.onCheckpoint then
			task.spawn(run.onCheckpoint, run)
		end
		Remotes.Effect:FireAllClients("checkpoint", position, {})
		send(run, "update", summary(run))
	end

	for index, gemPosition in ipairs(course.gems) do
		if not run.gems[index] and (gemPosition - position).Magnitude < GEM_RADIUS then
			run.gems[index] = true
			if run.onGem then
				task.spawn(run.onGem, run, index)
			end
			if run.player then
				Remotes.Effect:FireClient(run.player, "gem", gemPosition, { index = index })
			end
			send(run, "update", summary(run))
		end
	end

	if run.checkpoint >= #course.checkpoints and run.started then
		local finishLine = course.finish.lineCFrame:PointToObjectSpace(position)
		if
			finishLine.Z < 0.5
			and math.abs(finishLine.X) < course.finish.size.X / 2 + 2
			and math.abs(finishLine.Y) < 20
		then
			finish(run)
		end
	end
end

------------------------------------------------------------------ Falling tiles and fake doors
local function nearFeet(tile, position)
	local offset = tile.home:PointToObjectSpace(position)
	local size = tile.part.Size
	return math.abs(offset.X) < size.X / 2 + 0.5
		and math.abs(offset.Z) < size.Z / 2 + 0.5
		and offset.Y > 0
		and offset.Y < 5
end

local function dropTile(tile)
	tile.state = "shaking"
	local part = tile.part
	part.Color = part.Color:Lerp(Color3.new(1, 1, 1), 0.5)
	local original = tile.color or part.Color
	tile.color = tile.color or original
	task.spawn(function()
		local started = os.clock()
		while os.clock() - started < 0.55 and part.Parent do
			part.CFrame = tile.home * CFrame.new(random:NextNumber(-0.12, 0.12), 0, random:NextNumber(-0.12, 0.12))
			task.wait(0.05)
		end
		if not part.Parent then
			return
		end
		tile.state = "down"
		part.CanCollide = false
		TweenService:Create(
			part,
			TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ CFrame = tile.home * CFrame.new(0, -24, 0), Transparency = 1 }
		):Play()
		task.wait(5)
		if not part.Parent then
			return
		end
		part.CFrame = tile.home
		part.Transparency = 0
		part.CanCollide = true
		part.Color = tile.color
		tile.state = "up"
	end)
end

local function breakDoor(door)
	door.broken = true
	local part = door.part
	Remotes.Effect:FireAllClients("door", part.Position, {})
	part.Transparency = 1
	for _, child in ipairs(part:GetChildren()) do
		if child:IsA("SurfaceGui") then
			child.Enabled = false
		end
	end
	task.delay(4, function()
		if part.Parent then
			part.Transparency = 0
			for _, child in ipairs(part:GetChildren()) do
				if child:IsA("SurfaceGui") then
					child.Enabled = true
				end
			end
			door.broken = false
		end
	end)
end

local function checkWorld(instance, positions)
	local course = instance.course
	for _, tile in ipairs(course.fallTiles) do
		if tile.state == "up" then
			for _, position in ipairs(positions) do
				if nearFeet(tile, position) then
					dropTile(tile)
					break
				end
			end
		end
	end
	for _, door in ipairs(course.fakeDoors) do
		if not door.broken then
			for _, position in ipairs(positions) do
				if CourseBuilder.InBox(position, door.home, door.part.Size + Vector3.new(1, 0, 3)) then
					breakDoor(door)
					break
				end
			end
		end
	end
end

------------------------------------------------------------------ Start
function CourseService.Start()
	folder = Instance.new("Folder")
	folder.Name = "Courses"
	folder.Parent = Workspace

	-- A player's own computer says when they touched lava or a laser (or fell
	-- below the course): bring them back to their checkpoint right away
	Remotes.Fell.OnServerEvent:Connect(function(player)
		local run = runs["p" .. player.UserId]
		if run and not run.finished then
			CourseService.Respawn(run)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		CourseService.Leave(player)
	end)

	-- A player who resets goes back to their checkpoint
	local function watch(player)
		player.CharacterAdded:Connect(function()
			local run = runs["p" .. player.UserId]
			if run then
				task.wait(0.2)
				placeRunner(run, spawnFor(run))
			end
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		watch(player)
	end

	RunService.Heartbeat:Connect(function()
		for _, run in pairs(runs) do
			local ok, err = pcall(checkRun, run)
			if not ok then
				warn("[CourseService] " .. tostring(err))
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.1)
			for _, instance in pairs(instances) do
				local list = runnersIn(instance)
				local positions = {}
				for _, run in ipairs(list) do
					local root = rootOf(run)
					if root then
						table.insert(positions, root.Position)
					end
				end
				pcall(checkWorld, instance, positions)
				if #list == 0 and instance.shared then
					instance.emptySince = instance.emptySince or os.clock()
					if os.clock() - instance.emptySince > Config.EmptyCourseSeconds then
						CourseService.Close(instance)
					end
				end
			end
		end
	end)
end

function CourseService.Instances()
	return instances
end

CourseService.RunnersIn = runnersIn

return CourseService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- Loads, saves and hands out each player's save data.
-- Other scripts change data with DataService.Update(player, function(data) ... end)
-- so the player's screen and leaderboard always refresh afterwards.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Level = require(Shared.Level)

local DataService = {}

local LOCK_EXPIRES = 15 * 60 -- a lock older than this is from a crashed server

local function defaultData()
	return {
		coins = 0,
		totalEarned = 0,
		xp = 0,
		tutorial = 1, -- step of the first-time guide (Shared/Tutorial)
		adventure = {}, -- [courseId] = { done = true, best = seconds, stars = bits, gems = bits, runs = n }
		stats = {
			courses = 0, -- Adventure courses finished
			stars = 0,
			gems = 0,
			falls = 0,
			tournaments = 0,
			crowns = 0, -- tournaments won
			rounds = 0, -- tournament rounds survived
			races = 0,
			qualified = 0,
			kos = 0,
			bonks = 0,
		},
		weekly = { week = 0, crowns = 0 }, -- for the weekly leaderboard
		daily = { day = 0, best = 0 }, -- the Daily Challenge
		quests = { day = 0, list = {} },
		cosmetics = {
			owned = {}, -- [cosmeticId] = true
			equipped = {}, -- [kind] = cosmeticId
		},
		levelRewards = 1, -- highest level whose reward was paid
		purchases = {}, -- [receiptPurchaseId] = true
		lastDailyDay = 0,
		dailyStreak = 0,
	}
end

-- Fill in any fields missing from older saves
local function reconcile(data, template)
	for key, value in pairs(template) do
		if data[key] == nil then
			if type(value) == "table" then
				data[key] = table.clone(value)
			else
				data[key] = value
			end
		elseif type(value) == "table" and type(data[key]) == "table" then
			reconcile(data[key], value)
		end
	end
	return data
end

local store = nil
local savingEnabled = true
local profiles = {} -- [player] = { data = {}, runtime = {} }
local listeners = {} -- functions called after any data change

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		savingEnabled = false
		warn("[DataService] DataStores unavailable, progress will not save: " .. tostring(result))
	end
end

local function keyFor(player)
	return "player_" .. player.UserId
end

local function loadData(player)
	if not store then
		return defaultData(), false
	end

	local key = keyFor(player)
	for attempt = 1, 6 do
		local lockedElsewhere = false
		local stealLock = attempt >= 4 -- after ~15 seconds, assume the old server is gone
		local ok, result = pcall(function()
			return store:UpdateAsync(key, function(saved)
				saved = saved or { data = defaultData() }
				local lock = saved.lock
				if lock and lock.jobId ~= game.JobId and os.time() - lock.time < LOCK_EXPIRES and not stealLock then
					lockedElsewhere = true
					return nil
				end
				saved.lock = { jobId = game.JobId, time = os.time() }
				return saved
			end)
		end)

		if ok and not lockedElsewhere and result then
			return reconcile(result.data or defaultData(), defaultData()), true
		end

		if not ok then
			local message = tostring(result)
			warn(string.format("[DataService] Load attempt %d failed for %s: %s", attempt, player.Name, message))
			if RunService:IsStudio() then
				-- Usually an unpublished place, or "Enable Studio Access to API Services" is off
				return defaultData(), false
			end
		end
		task.wait(5)
	end
	return nil, false
end

local function saveData(player, release)
	local profile = profiles[player]
	if not profile or not profile.canSave then
		return true
	end
	local data = profile.data
	local ok, err = pcall(function()
		store:UpdateAsync(keyFor(player), function(saved)
			saved = saved or {}
			if saved.lock and saved.lock.jobId ~= game.JobId then
				-- Another server took over this player; don't overwrite newer data
				return nil
			end
			saved.data = data
			saved.lock = (not release) and { jobId = game.JobId, time = os.time() } or nil
			return saved
		end)
	end)
	if not ok then
		warn("[DataService] Save failed for " .. player.Name .. ": " .. tostring(err))
	end

	-- Global leaderboards: most crowns, most stars, most crowns this week
	pcall(function()
		local key = tostring(player.UserId)
		DataStoreService:GetOrderedDataStore(Config.CrownsStoreName):SetAsync(key, data.stats.crowns)
		DataStoreService:GetOrderedDataStore(Config.StarsStoreName):SetAsync(key, data.stats.stars)
		if data.weekly.crowns > 0 then
			DataStoreService:GetOrderedDataStore(Config.WeeklyCrownsStorePrefix .. data.weekly.week)
				:SetAsync(key, data.weekly.crowns)
		end
	end)
	return ok
end

local function setupLeaderstats(player)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	for _, name in ipairs({ "Level", "Stars", "Crowns" }) do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = folder
	end
	folder.Parent = player
end

local function refresh(player)
	local profile = profiles[player]
	if not profile then
		return
	end
	local data = profile.data
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Level.Value = Level.FromXp(data.xp)
		stats.Stars.Value = data.stats.stars
		stats.Crowns.Value = data.stats.crowns
	end
	for _, listener in ipairs(listeners) do
		task.spawn(listener, player, data, profile.runtime)
	end
	Remotes.DataUpdate:FireClient(player, data, profile.runtime)
end

function DataService.Get(player)
	local profile = profiles[player]
	return profile and profile.data
end

-- Runtime info that is not saved (game passes owned, ...)
function DataService.GetRuntime(player)
	local profile = profiles[player]
	return profile and profile.runtime
end

function DataService.Update(player, change)
	local profile = profiles[player]
	if not profile then
		return nil
	end
	local results = table.pack(change(profile.data, profile.runtime))
	refresh(player)
	return table.unpack(results, 1, results.n)
end

function DataService.Refresh(player)
	refresh(player)
end

-- Called with (player, data, runtime) after every change
function DataService.OnChanged(listener)
	table.insert(listeners, listener)
end

function DataService.SaveNow(player)
	return saveData(player, false)
end

function DataService.IsLoaded(player)
	return profiles[player] ~= nil
end

-- Waits until the player's data has loaded (or they left)
function DataService.WaitFor(player)
	while player.Parent and not profiles[player] do
		task.wait(0.2)
	end
	return profiles[player] ~= nil
end

local loadedCallbacks = {}
-- callback(player, data, runtime) runs once per player, before the data is shared.
-- It may yield, but must not call DataService.Get/Update for that player.
function DataService.OnLoaded(callback)
	table.insert(loadedCallbacks, callback)
end

local function onPlayerAdded(player)
	setupLeaderstats(player)
	local data, canSave = loadData(player)
	if not player.Parent then
		return
	end
	if not data then
		player:Kick("We couldn't load your save. Please rejoin in a minute.")
		return
	end
	-- Loaded callbacks fill in runtime info (like game passes) before anything else sees the data
	local runtime = { passes = {} }
	for _, callback in ipairs(loadedCallbacks) do
		callback(player, data, runtime)
	end
	if not player.Parent then
		return
	end
	profiles[player] = { data = data, runtime = runtime, canSave = canSave and savingEnabled }
	refresh(player)
	if not profiles[player].canSave then
		Remotes.Notify:FireClient(player, "Saving is off (in Studio, turn on API Services to test saving).", "warning")
	end
end

local function onPlayerRemoving(player)
	if profiles[player] then
		saveData(player, true)
		profiles[player] = nil
	end
end

function DataService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for player in pairs(profiles) do
				task.spawn(saveData, player, false)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in pairs(profiles) do
			pending += 1
			task.spawn(function()
				saveData(player, true)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">Kit</string><ProtectedString name="Source"><![CDATA[-- The obstacle kit: every piece a course can be made of. Each builder lays one
-- piece down in front of a cursor (a CFrame in the middle of the path, at floor
-- level, facing the way you run) and returns where the next piece starts.
--
-- Moving obstacles don't move on the server: they carry Motion attributes (see
-- Shared/Motion) and every player's computer moves them from the shared clock.
-- Tags tell players' computers what a part does:
--   Moving   moves by its Motion attributes
--   Hit      knocks you back when it touches you (Low = true: low enough to jump)
--   Kill     sends you back to your checkpoint (lava, lasers, spikes)
--   Bounce   launches you with its Launch attribute (a velocity)
--   Belt     floor that carries you along its Belt attribute (conveyors, slides)
--   Wind     a zone that pushes you by Push while its gust is on
--   Zip      the start of a zipline (ends at its ZipTo attribute)
-- and these are handled by the server:
--   FallTile tiles that drop a moment after someone steps on them
--   FakeDoor doors you can run straight through
--
-- Builders also return "nodes": the path bots follow (see BotService).

local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Motion = require(Shared.Motion)

local Kit = {}

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- a cylinder's length runs up and down

------------------------------------------------------------------ Helpers
-- A piece being built: knows the cursor, the theme and the course's folder
local Piece = {}
Piece.__index = Piece

local function newPiece(ctx, cursor)
	return setmetatable({
		ctx = ctx,
		cursor = cursor,
		theme = ctx.theme,
		random = ctx.random,
		folder = ctx.folder,
		nodes = {},
		minY = cursor.Position.Y,
		gemSpot = nil,
		shade = 0,
	}, Piece)
end

-- World point from local x (right), y (up), z (forward)
function Piece:P(x, y, z)
	return self.cursor:PointToWorldSpace(Vector3.new(x, y, -z))
end

function Piece:C(x, y, z)
	return self.cursor * CFrame.new(x, y, -z)
end

function Piece:Part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = self.theme.material
	for key, value in pairs(props) do
		if key ~= "Parent" and key ~= "Tags" and key ~= "Attributes" then
			p[key] = value
		end
	end
	for name, value in pairs(props.Attributes or {}) do
		p:SetAttribute(name, value)
	end
	for _, tag in ipairs(props.Tags or {}) do
		CollectionService:AddTag(p, tag)
	end
	p.Parent = props.Parent or self.folder
	return p
end

function Piece:FloorColor()
	self.shade += 1
	return self.theme.floor[(self.shade % #self.theme.floor) + 1]
end

-- A floor slab whose top is at local height y. Centre (x, z), width w, length l.
function Piece:Floor(x, y, z, w, l, props)
	props = props or {}
	local thickness = props.thickness or 2
	local p = self:Part({
		Name = props.Name or "Floor",
		Size = Vector3.new(w, thickness, l),
		CFrame = self:C(x, y - thickness / 2, z),
		Color = props.Color or self:FloorColor(),
		Material = props.Material or self.theme.material,
		Tags = props.Tags,
		Attributes = props.Attributes,
		Transparency = props.Transparency or 0,
	})
	local top = self:P(x, y, z).Y
	if top < self.minY then
		self.minY = top
	end
	return p
end

-- A round platform whose top is at local height y
function Piece:Disc(x, y, z, radius, props)
	props = props or {}
	local thickness = props.thickness or 2
	local p = self:Part({
		Name = props.Name or "Disc",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(thickness, radius * 2, radius * 2),
		CFrame = self:C(x, y - thickness / 2, z) * UPRIGHT,
		Color = props.Color or self:FloorColor(),
		Material = props.Material or self.theme.material,
	})
	local top = self:P(x, y, z).Y
	if top < self.minY then
		self.minY = top
	end
	return p
end

-- A low glowing rim along both sides of a stretch of path, for looks
function Piece:Rails(y, z0, z1, w)
	for _, side in ipairs({ -1, 1 }) do
		self:Part({
			Name = "Rim",
			Size = Vector3.new(0.6, 0.6, math.abs(z1 - z0)),
			CFrame = self:C(side * (w / 2 - 0.3), y + 0.3, (z0 + z1) / 2),
			Color = self.theme.edge,
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
	end
end

-- A moving part. motion = attributes for Shared/Motion (Home in world space).
function Piece:Mover(props, motion, tags)
	local attributes = props.Attributes or {}
	for key, value in pairs(motion) do
		attributes[key] = value
	end
	props.Attributes = attributes
	props.Tags = props.Tags or {}
	table.insert(props.Tags, Motion.Tag)
	for _, tag in ipairs(tags or {}) do
		table.insert(props.Tags, tag)
	end
	local p = self:Part(props)
	local spec = Motion.Read(p)
	p.CFrame = Motion.At(spec, Motion.Clock())
	return p, spec
end

function Piece:Node(node)
	table.insert(self.nodes, node)
	return node
end

-- Walk to a local point (on the floor)
function Piece:Go(x, y, z, extra)
	local node = { kind = "go", to = self:P(x, y, z) }
	for key, value in pairs(extra or {}) do
		node[key] = value
	end
	return self:Node(node)
end

function Piece:Jump(x, y, z, extra)
	local node = { kind = "jump", to = self:P(x, y, z) }
	for key, value in pairs(extra or {}) do
		node[key] = value
	end
	return self:Node(node)
end

function Piece:Gem(x, y, z)
	self.gemSpot = self:P(x, y + 2.5, z)
end

-- Every builder ends with this: the cursor for the next piece
function Piece:Done(length, rise, turn)
	local nextCursor = self.cursor * CFrame.new(0, rise or 0, -length)
	if turn then
		nextCursor = nextCursor * CFrame.Angles(0, turn, 0)
	end
	return {
		cursor = nextCursor,
		nodes = self.nodes,
		minY = self.minY,
		gemSpot = self.gemSpot,
		checkpoint = self.checkpoint,
		finish = self.finish,
		start = self.start,
	}
end

------------------------------------------------------------------ Builders
local B = {}

-- The start platform with a starting arch. The timer starts when you leave it.
B.start = function(pc)
	local w, l = 24, 22
	pc:Floor(0, 0, l / 2, w, l, { Color = pc.theme.floor[2] })
	pc:Rails(0, 0, l, w)
	pc:Part({ Name = "BackWall", Size = Vector3.new(w, 10, 1), CFrame = pc:C(0, 5, -0.5), Transparency = 1 })
	for _, side in ipairs({ -1, 1 }) do
		pc:Part({
			Name = "ArchPost",
			Size = Vector3.new(1.6, 14, 1.6),
			CFrame = pc:C(side * (w / 2 - 1), 7, l - 1),
			Color = pc.theme.edge,
			Material = Enum.Material.SmoothPlastic,
		})
		pc:Part({
			Name = "SideWall",
			Size = Vector3.new(1, 10, l),
			CFrame = pc:C(side * (w / 2 + 0.5), 5, l / 2),
			Transparency = 1,
		})
	end
	local bar = pc:Part({
		Name = "StartBanner",
		Size = Vector3.new(w, 3, 1),
		CFrame = pc:C(0, 13, l - 1),
		Color = pc.theme.accent,
		Material = Enum.Material.SmoothPlastic,
	})
	pc.ctx.sign(bar, "START")
	pc:Part({
		Name = "StartLine",
		Size = Vector3.new(w, 0.1, 1.2),
		CFrame = pc:C(0, 0.05, l - 1),
		Color = Color3.new(1, 1, 1),
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
	pc.start = { spawn = pc:C(0, 3.5, 6), lineCFrame = pc:C(0, 0, l - 1), size = Vector3.new(w, 20, 2) }
	pc:Go(0, 0, l)
	return pc:Done(l)
end

-- A checkpoint pad with flags. You come back here when you fall.
B.checkpoint = function(pc)
	local w, l = 22, 14
	pc:Floor(0, 0, l / 2, w, l, { Color = pc.theme.floor[2] })
	local pad = pc:Part({
		Name = "CheckpointPad",
		Size = Vector3.new(w - 4, 0.2, l - 4),
		CFrame = pc:C(0, 0.1, l / 2),
		Color = Color3.fromRGB(90, 230, 120),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Transparency = 0.4,
	})
	for _, side in ipairs({ -1, 1 }) do
		pc:Part({
			Name = "FlagPole",
			Size = Vector3.new(0.5, 9, 0.5),
			CFrame = pc:C(side * (w / 2 - 1), 4.5, l / 2),
			Color = Color3.fromRGB(230, 230, 230),
			Material = Enum.Material.Metal,
		})
		pc:Part({
			Name = "Flag",
			Size = Vector3.new(0.2, 2.4, 3.4),
			CFrame = pc:C(side * (w / 2 - 1), 7.6, l / 2 + 1.8),
			Color = Color3.fromRGB(90, 230, 120),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
		})
	end
	pc.checkpoint = { spawn = pc:C(0, 3.5, l / 2), center = pad.CFrame, size = Vector3.new(w, 20, l) }
	pc:Go(0, 0, l)
	return pc:Done(l)
end

-- The finish platform: an arch with a chequered line, confetti when you cross
B.finish = function(pc)
	local w, l = 28, 26
	pc:Floor(0, 0, l / 2, w, l, { Color = pc.theme.floor[2] })
	pc:Rails(0, 0, l, w)
	for _, side in ipairs({ -1, 1 }) do
		pc:Part({
			Name = "ArchPost",
			Size = Vector3.new(2, 16, 2),
			CFrame = pc:C(side * (w / 2 - 1.5), 8, 6),
			Color = pc.theme.accent,
			Material = Enum.Material.SmoothPlastic,
		})
		pc:Part({
			Name = "SideWall",
			Size = Vector3.new(1, 12, l),
			CFrame = pc:C(side * (w / 2 + 0.5), 6, l / 2),
			Transparency = 1,
		})
	end
	pc:Part({ Name = "BackWall", Size = Vector3.new(w, 12, 1), CFrame = pc:C(0, 6, l + 0.5), Transparency = 1 })
	local banner = pc:Part({
		Name = "FinishBanner",
		Size = Vector3.new(w, 4, 1),
		CFrame = pc:C(0, 15, 6),
		Color = Color3.fromRGB(30, 30, 40),
		Material = Enum.Material.SmoothPlastic,
	})
	pc.ctx.sign(banner, "FINISH")
	for index = 0, 13 do
		pc:Part({
			Name = "FinishLine",
			Size = Vector3.new(w / 14, 0.1, 1.6),
			CFrame = pc:C(-w / 2 + w / 28 + index * w / 14, 0.05, 6),
			Color = index % 2 == 0 and Color3.new(1, 1, 1) or Color3.new(0.1, 0.1, 0.1),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
		})
	end
	pc.finish = { lineCFrame = pc:C(0, 0, 6), size = Vector3.new(w, 24, 3), stand = pc:C(0, 3.5, 16) }
	pc:Go(0, 0, 10)
	return pc:Done(l)
end

-- A plain stretch. Good for breathing room between hard parts.
B.run = function(pc, o)
	local l, w = o.len or 24, o.w or 16
	pc:Floor(0, 0, l / 2, w, l)
	pc:Rails(0, 0, l, w)
	if o.gem then
		pc:Gem(w / 2 - 2, 0, l / 2)
	end
	pc:Go(0, 0, l)
	return pc:Done(l)
end

-- A slope up (or down with a negative rise)
B.ramp = function(pc, o)
	local l, w, rise = o.len or 30, o.w or 16, o.rise or 10
	local slope = math.sqrt(l * l + rise * rise)
	local angle = math.atan2(rise, l)
	pc:Part({
		Name = "Ramp",
		Size = Vector3.new(w, 2, slope),
		CFrame = pc:C(0, rise / 2, l / 2) * CFrame.Angles(angle, 0, 0) * CFrame.new(0, -1, 0),
		Color = pc:FloorColor(),
	})
	pc.minY = math.min(pc.minY, pc:P(0, math.min(0, rise), 0).Y)
	if o.gem then
		pc:Gem(-w / 2 + 2, rise / 2, l / 2)
	end
	pc:Go(0, rise, l)
	return pc:Done(l, rise)
end

-- Steps up
B.stairs = function(pc, o)
	local steps, rise, depth, w = o.steps or 6, o.rise or 1.5, o.depth or 4, o.w or 16
	for index = 1, steps do
		pc:Floor(0, index * rise, (index - 0.5) * depth, w, depth, { thickness = index * rise + 2 })
	end
	pc:Go(0, steps * rise, steps * depth)
	return pc:Done(steps * depth, steps * rise)
end

-- A corner: turns the course left or right
B.turn = function(pc, o)
	local size = o.size or 20
	pc:Floor(0, 0, size / 2, size, size)
	local turn = o.dir == "left" and math.rad(90) or math.rad(-90)
	pc:Go(0, 0, size / 2)
	-- The next piece starts at the side of this square
	local result = pc:Done(size / 2, 0, turn)
	result.cursor = result.cursor * CFrame.new(0, 0, -size / 2)
	return result
end

-- Stepping stones over a drop. drift moves each stone sideways (zigzag).
B.gaps = function(pc, o)
	local count, gap, size, drift, w = o.count or 4, o.gap or 5, o.size or 8, o.drift or 0, o.w or 16
	local z = 0
	local lastX = 0
	for index = 1, count do
		z += gap
		local x = drift * (index % 2 == 0 and 1 or -1)
		if index == count then
			x = 0
		end
		local y = (o.climb or 0) * index
		pc:Floor(x, y, z + size / 2, size, size)
		pc:Jump(x, y, z + size / 2, { risk = 0.04 })
		lastX = x
		z += size
	end
	z += gap
	local endY = (o.climb or 0) * count
	pc:Floor(0, endY, z + 3, w, 6)
	pc:Jump(lastX * 0.5, endY, z + 3)
	if o.gem then
		pc:Floor(w / 2 + 8, endY, z - size / 2 - gap, 5, 5, { Color = pc.theme.accent })
		pc:Gem(w / 2 + 8, endY, z - size / 2 - gap)
	end
	return pc:Done(z + 6, endY)
end

-- Platforms that slide across a gap. axis "side" (left-right) or "forward".
B.movers = function(pc, o)
	local count, period, dist, size = o.count or 3, o.period or 5, o.dist or 14, o.size or 9
	local forward = o.axis == "forward"
	local z = 6
	pc:Floor(0, 0, 3, 16, 6)
	for index = 1, count do
		local gapBefore = forward and 4 or 5
		z += gapBefore
		local zCenter = z + size / 2
		local axis, home
		local phase = (index - 1) * period * 0.5
		if forward then
			axis = Vector3.new(0, 0, -1)
			home = pc:C(0, -1, zCenter)
		else
			axis = Vector3.xAxis
			home = pc:C(-dist / 2, -1, zCenter)
		end
		local _, spec = pc:Mover(
			{ Name = "MovingPlatform", Size = Vector3.new(size, 2, size), Color = pc.theme.mover },
			{
				Motion = "slide",
				Home = home,
				Axis = axis,
				Dist = forward and dist or dist,
				Period = period,
				Phase = phase,
				Hold = 0.25,
			}
		)
		pc:Node({
			kind = "ride",
			spec = spec,
			enter = pc:P(0, 0, z - gapBefore),
			exit = pc:P(0, 0, zCenter + size / 2 + 5),
			forward = forward,
		})
		z += size + (forward and dist or 0)
	end
	z += 5
	pc:Floor(0, 0, z + 4, 16, 8)
	pc:Go(0, 0, z + 4)
	if o.gem then
		pc:Floor(-12, 0, z + 4, 6, 6, { Color = pc.theme.accent })
		pc:Gem(-12, 0, z + 4)
	end
	return pc:Done(z + 8)
end

-- A round platform with a spinning bar at knee height: jump over it.
-- bars = 1 or 2, high = true adds a second, higher bar you must not jump into.
B.spinner = function(pc, o)
	local radius, speed, bars = o.r or 16, o.speed or 1.3, o.bars or 1
	local z = radius + 3
	pc:Floor(0, 0, 2, 12, 4)
	pc:Disc(0, 0, z, radius)
	local center = pc:C(0, 0, z)
	pc:Part({
		Name = "Hub",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(4, 3, 3),
		CFrame = center * CFrame.new(0, 2, 0) * UPRIGHT,
		Color = pc.theme.edge,
		Material = Enum.Material.SmoothPlastic,
	})
	for index = 1, bars do
		local home = center * CFrame.new(0, 1.4, 0)
		pc:Mover(
			{
				Name = "SpinnerBar",
				Size = Vector3.new(radius * 2 - 1, 1.2, 1.2),
				Color = pc.theme.hazard,
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				Attributes = { Low = true },
			},
			{
				Motion = "spin",
				Home = home,
				Speed = speed * (o.reverse and -1 or 1),
				Phase = (index - 1) * math.pi / bars,
			},
			{ "Hit" }
		)
	end
	if o.high then
		local home = center * CFrame.new(0, 6.5, 0)
		pc:Mover(
			{
				Name = "HighBar",
				Size = Vector3.new(radius * 2 - 1, 1.2, 1.2),
				Color = pc.theme.hazard,
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
			},
			{ Motion = "spin", Home = home, Speed = -speed * 0.8, Phase = math.pi / 2 },
			{ "Hit" }
		)
	end
	pc:Go(0, 0, z - radius + 2)
	pc:Go(0, 0, z + radius - 2, { hazard = true })
	pc:Floor(0, 0, z * 2 - 1, 12, 4)
	pc:Go(0, 0, z * 2)
	if o.gem then
		pc:Gem(radius - 3, 0, z)
	end
	return pc:Done(z * 2 + 1)
end

-- A narrow bridge with pendulum hammers swinging across it
B.hammers = function(pc, o)
	local count, period, w = o.count or 3, o.period or 3.2, o.w or 8
	local spacing = o.spacing or 14
	local l = count * spacing + 8
	pc:Floor(0, 0, l / 2, w, l, { Name = "Bridge" })
	for index = 1, count do
		local z = 4 + (index - 0.5) * spacing
		local pivot = pc:C(0, 18, z)
		pc:Part({
			Name = "HammerBeam",
			Size = Vector3.new(w + 10, 1.4, 1.4),
			CFrame = pivot * CFrame.new(0, 0.5, 0),
			Color = pc.theme.edge,
			Material = Enum.Material.Wood,
		})
		for _, side in ipairs({ -1, 1 }) do
			pc:Part({
				Name = "HammerPost",
				Size = Vector3.new(1.4, 20, 1.4),
				CFrame = pc:C(side * (w / 2 + 5), 9, z),
				Color = pc.theme.edge,
				Material = Enum.Material.Wood,
			})
		end
		local motion =
			{ Motion = "swing", Home = pivot, Amp = math.rad(65), Period = period, Phase = (index % 2) * period / 2 }
		pc:Mover(
			{
				Name = "HammerArm",
				Size = Vector3.new(0.8, 14, 0.8),
				Color = Color3.fromRGB(90, 70, 50),
				Material = Enum.Material.Wood,
				CanCollide = false,
			},
			(function()
				local m = table.clone(motion)
				m.Offset = CFrame.new(0, -7, 0)
				return m
			end)()
		)
		local head = table.clone(motion)
		head.Offset = CFrame.new(0, -15, 0) * CFrame.Angles(0, math.rad(90), 0) -- the head's length runs along the bridge
		pc:Mover(
			{
				Name = "HammerHead",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(7, 4.5, 4.5),
				Color = pc.theme.hazard,
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
			},
			head,
			{ "Hit" }
		)
		pc:Go(0, 0, z, { hazard = true })
	end
	pc:Rails(0, 0, l, w)
	pc:Go(0, 0, l)
	if o.gem then
		pc:Gem(0, 7, l - 6)
	end
	return pc:Done(l)
end

-- An uphill ramp with balls rolling down lanes
B.balls = function(pc, o)
	local l, rise, lanes, period = o.len or 60, o.rise or 10, o.lanes or 3, o.period or 3.6
	local laneWidth = 6
	local w = lanes * laneWidth + 2
	local angle = math.atan2(rise, l)
	local slope = math.sqrt(l * l + rise * rise)
	pc:Part({
		Name = "Ramp",
		Size = Vector3.new(w, 2, slope),
		CFrame = pc:C(0, rise / 2, l / 2) * CFrame.Angles(angle, 0, 0) * CFrame.new(0, -1, 0),
		Color = pc:FloorColor(),
	})
	for _, side in ipairs({ -1, 1 }) do
		pc:Part({
			Name = "RampWall",
			Size = Vector3.new(1, 3, slope),
			CFrame = pc:C(side * (w / 2 + 0.5), rise / 2 + 1, l / 2) * CFrame.Angles(angle, 0, 0),
			Color = pc.theme.edge,
		})
	end
	local radius = 2.4
	local lanesX = {}
	for lane = 1, lanes do
		local x = -w / 2 + 1 + (lane - 0.5) * laneWidth
		table.insert(lanesX, x)
		-- Balls start at the top and roll down: home faces down the ramp
		local top = pc:C(x, rise + radius, l)
		local home = CFrame.lookAt(top.Position, pc:P(x, radius, 0))
		for ball = 0, 1 do
			pc:Mover(
				{
					Name = "Ball",
					Shape = Enum.PartType.Ball,
					Size = Vector3.one * radius * 2,
					Color = pc.theme.hazard,
					Material = Enum.Material.SmoothPlastic,
					CanCollide = false,
				},
				{
					Motion = "ball",
					Home = home,
					Length = slope + 6,
					Travel = 2.6,
					Period = period,
					Phase = (lane - 1) * period / lanes + ball * period / 2,
					Radius = radius,
				},
				{ "Hit" }
			)
		end
	end
	pc:Node({
		kind = "dodge",
		from = pc:P(0, 0, 0),
		to = pc:P(0, rise, l),
		lanes = lanesX,
		cursor = pc.cursor,
		rise = rise,
		len = l,
	})
	pc:Floor(0, rise, l + 4, w, 8)
	pc:Go(0, rise, l + 6)
	if o.gem then
		pc:Gem(lanesX[1], rise * 0.6, l * 0.6)
	end
	return pc:Done(l + 8, rise)
end

-- A conveyor belt. speed < 0 runs against you.
B.conveyor = function(pc, o)
	local l, w, speed = o.len or 40, o.w or 12, o.speed or -10
	local belt = pc:Floor(
		0,
		0,
		l / 2,
		w,
		l,
		{ Name = "Belt", Color = Color3.fromRGB(60, 60, 70), Material = Enum.Material.Fabric, Tags = { "Belt" } }
	)
	belt:SetAttribute("Belt", pc.cursor.LookVector * speed)
	-- Stripes so you can tell which way it runs (they don't move, the arrows say it)
	for z = 4, l - 2, 8 do
		pc:Part({
			Name = "Arrow",
			Size = Vector3.new(w - 4, 0.1, 1),
			CFrame = pc:C(0, 0.06, z),
			Color = pc.theme.accent,
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
	end
	pc:Rails(0, 0, l, w)
	pc:Go(0, 0, l, { belt = speed })
	if o.gem then
		pc:Gem(0, 0, l * 0.75)
	end
	return pc:Done(l)
end

-- A grid of tiles that blink away and back on a timer
B.blink = function(pc, o)
	local rows, cols, period = o.rows or 4, o.cols or 3, o.period or 4
	local size = 7
	local gap = 1.5
	local w = cols * (size + gap)
	local l = rows * (size + gap) + 4
	pc:Floor(0, 0, 2, 16, 4)
	local tilesByRow = {}
	for row = 1, rows do
		tilesByRow[row] = {}
		for col = 1, cols do
			local x = -w / 2 + (col - 0.5) * (size + gap)
			local z = 4 + (row - 0.5) * (size + gap)
			local phase = ((row + col) % 3) * period / 3
			local _, spec = pc:Mover(
				{
					Name = "BlinkTile",
					Size = Vector3.new(size, 1.5, size),
					Color = pc.theme.mover,
					Material = Enum.Material.SmoothPlastic,
				},
				{ Motion = "blink", Home = pc:C(x, -0.75, z), Period = period, On = period * 0.65, Phase = phase }
			)
			table.insert(tilesByRow[row], { spec = spec, at = pc:P(x, 0, z) })
		end
	end
	for row = 1, rows do
		pc:Node({ kind = "tiles", choices = tilesByRow[row] })
	end
	pc:Floor(0, 0, l + 3, 16, 6)
	pc:Jump(0, 0, l + 3)
	if o.gem then
		pc:Gem(-w / 2 + size / 2 + gap / 2, 0, 4 + (rows - 0.5) * (size + gap))
	end
	return pc:Done(l + 6)
end

-- Tiles that drop a moment after someone steps on them (they come back later)
B.fall = function(pc, o)
	local rows, cols = o.rows or 5, o.cols or 4
	local size = o.size or 6
	local w = cols * size
	local l = rows * size + 4
	pc:Floor(0, 0, 2, 16, 4)
	for row = 1, rows do
		for col = 1, cols do
			local x = -w / 2 + (col - 0.5) * size
			local z = 4 + (row - 0.5) * size
			pc:Part({
				Name = "FallTile",
				Size = Vector3.new(size - 0.3, 1.5, size - 0.3),
				CFrame = pc:C(x, -0.75, z),
				Color = (row + col) % 2 == 0 and pc.theme.floor[1] or pc.theme.floor[2],
				Tags = { "FallTile" },
			})
		end
	end
	pc:Go(0, 0, l / 2, { hazard = true })
	pc:Floor(0, 0, l + 3, 16, 6)
	pc:Go(0, 0, l + 3)
	if o.gem then
		pc:Gem(w / 2 - size / 2, 0, 4 + size / 2)
	end
	return pc:Done(l + 6)
end

-- A bounce pad that throws you up to a higher ledge
B.bounce = function(pc, o)
	local rise = o.rise or 18
	pc:Floor(0, 0, 6, 16, 12)
	local speed = math.sqrt(2 * workspace.Gravity * (rise + 9))
	local pad = pc:Part({
		Name = "BouncePad",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 7, 7),
		CFrame = pc:C(0, 0.3, 8) * UPRIGHT,
		Color = pc.theme.accent,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Tags = { "Bounce" },
	})
	pad:SetAttribute("Launch", Vector3.new(0, speed, 0) + pc.cursor.LookVector * 14)
	pc:Go(0, 0, 8)
	pc:Node({ kind = "bounce", to = pc:P(0, rise, 16), speed = speed })
	pc:Floor(0, rise, 18, 16, 10)
	pc:Part({
		Name = "Wall",
		Size = Vector3.new(16, rise, 2),
		CFrame = pc:C(0, rise / 2 - 1, 12),
		Color = pc.theme.edge,
	})
	pc:Go(0, rise, 22)
	if o.gem then
		pc:Gem(0, rise + 9, 8)
	end
	return pc:Done(23, rise)
end

-- A narrow bridge with gusts of wind from the side
B.wind = function(pc, o)
	local l, w, push, period = o.len or 44, o.w or 6, o.push or 16, o.period or 4
	pc:Floor(0, 0, l / 2, w, l, { Name = "Bridge" })
	local side = o.side or 1
	local fanCount = math.max(1, math.floor(l / 14))
	for index = 1, fanCount do
		local z = (index - 0.5) * l / fanCount
		pc:Part({
			Name = "Fan",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(2, 8, 8),
			CFrame = pc:C(-side * (w / 2 + 9), 3, z) * CFrame.Angles(0, 0, 0),
			Color = pc.theme.edge,
			Material = Enum.Material.Metal,
		})
	end
	local zone = pc:Part({
		Name = "WindZone",
		Size = Vector3.new(w + 16, 14, l),
		CFrame = pc:C(0, 6, l / 2),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Tags = { "Wind" },
	})
	zone:SetAttribute("Push", pc.cursor.RightVector * push * side)
	zone:SetAttribute("Period", period)
	zone:SetAttribute("On", period * 0.5)
	zone:SetAttribute("Phase", pc.random:NextNumber(0, period))
	pc:Go(0, 0, l, { wind = zone })
	if o.gem then
		pc:Gem(side * (w / 2 - 1), 0, l / 2)
	end
	return pc:Done(l)
end

-- A slime slide down a slope: it carries you fast; steer round the bumpers
B.slide = function(pc, o)
	local l, drop, w = o.len or 70, o.drop or 24, o.w or 18
	local angle = math.atan2(-drop, l)
	local slope = math.sqrt(l * l + drop * drop)
	local surface = pc:Part({
		Name = "Slide",
		Size = Vector3.new(w, 2, slope),
		CFrame = pc:C(0, -drop / 2, l / 2) * CFrame.Angles(angle, 0, 0) * CFrame.new(0, -1, 0),
		Color = Color3.fromRGB(120, 230, 120),
		Material = Enum.Material.Glass,
		Transparency = 0.15,
		Tags = { "Belt" },
	})
	surface:SetAttribute("Belt", (pc.cursor * CFrame.Angles(angle, 0, 0)).LookVector * (o.speed or 22))
	for _, side in ipairs({ -1, 1 }) do
		pc:Part({
			Name = "SlideWall",
			Size = Vector3.new(1, 3, slope),
			CFrame = pc:C(side * (w / 2 + 0.5), -drop / 2 + 1, l / 2) * CFrame.Angles(angle, 0, 0),
			Color = pc.theme.edge,
		})
	end
	pc.minY = math.min(pc.minY, pc:P(0, -drop, 0).Y)
	-- Bumpers to steer round
	local bumpers = o.bumpers or 4
	for index = 1, bumpers do
		local share = index / (bumpers + 1)
		local x = (index % 2 == 0 and 1 or -1) * (w / 4)
		pc:Part({
			Name = "Bumper",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(6, 4, 4),
			CFrame = pc:C(x, -drop * share + 2, l * share) * UPRIGHT,
			Color = pc.theme.hazard,
			Material = Enum.Material.SmoothPlastic,
		})
	end
	pc:Node({ kind = "slide", from = pc:P(0, 0, 0), to = pc:P(0, -drop, l), dodge = w / 4 })
	pc:Floor(0, -drop, l + 5, w, 10)
	pc:Go(0, -drop, l + 8)
	if o.gem then
		pc:Gem(-w / 2 + 2, -drop * 0.5, l * 0.5)
	end
	return pc:Done(l + 10, -drop)
end

-- Rocking platforms that tilt back and forth
B.seesaw = function(pc, o)
	local count, period = o.count or 3, o.period or 4
	local size = 12
	local z = 4
	pc:Floor(0, 0, 2, 14, 4)
	for index = 1, count do
		z += 3
		local zCenter = z + size / 2
		local _, spec = pc:Mover(
			{
				Name = "Seesaw",
				Size = Vector3.new(size, 1.5, size),
				Color = pc.theme.mover,
				Material = Enum.Material.SmoothPlastic,
			},
			{
				Motion = "rock",
				Home = pc:C(0, -0.75, zCenter),
				Amp = math.rad(o.tilt or 14),
				Period = period,
				Phase = index * 0.9,
			}
		)
		pc:Part({
			Name = "Pivot",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(size, 1.4, 1.4),
			CFrame = pc:C(0, -2.2, zCenter),
			Color = pc.theme.edge,
			CanCollide = false,
		})
		pc:Node({
			kind = "ride",
			spec = spec,
			enter = pc:P(0, 0, z - 3),
			exit = pc:P(0, 0, zCenter + size / 2 + 3),
			rock = true,
		})
		z += size
	end
	z += 3
	pc:Floor(0, 0, z + 3, 14, 6)
	pc:Go(0, 0, z + 3)
	if o.gem then
		pc:Gem(size / 2 - 1.5, 0, 7 + size / 2)
	end
	return pc:Done(z + 6)
end

-- A wall of doors: some are fake and you can run through, the rest are solid
B.doors = function(pc, o)
	local rows, perRow = o.rows or 2, o.doors or 5
	local w = perRow * 6
	local spacing = 16
	local l = rows * spacing + 6
	pc:Floor(0, 0, l / 2, w, l)
	for row = 1, rows do
		local z = row * spacing - 4
		local fakes = {}
		local count = math.max(1, math.floor(perRow / 2))
		local pool = {}
		for index = 1, perRow do
			table.insert(pool, index)
		end
		for _ = 1, count do
			table.insert(fakes, table.remove(pool, pc.random:NextInteger(1, #pool)))
		end
		local openX = {}
		for index = 1, perRow do
			local x = -w / 2 + (index - 0.5) * 6
			local fake = table.find(fakes, index) ~= nil
			local door = pc:Part({
				Name = "Door",
				Size = Vector3.new(5.8, 9, 1.2),
				CFrame = pc:C(x, 4.5, z),
				Color = pc.theme.mover,
				Material = Enum.Material.SmoothPlastic,
				CanCollide = not fake,
				Tags = fake and { "FakeDoor" } or nil,
			})
			pc.ctx.sign(door, "?")
			if fake then
				table.insert(openX, x)
			end
		end
		pc:Part({ Name = "DoorFrame", Size = Vector3.new(w, 2, 1.6), CFrame = pc:C(0, 10, z), Color = pc.theme.edge })
		pc:Node({
			kind = "doors",
			z = pc:P(0, 0, z),
			choices = (function()
				local list = {}
				for _, x in ipairs(openX) do
					table.insert(list, pc:P(x, 0, z + 2))
				end
				return list
			end)(),
			all = (function()
				local list = {}
				for index = 1, perRow do
					table.insert(list, pc:P(-w / 2 + (index - 0.5) * 6, 0, z - 2))
				end
				return list
			end)(),
		})
	end
	for _, side in ipairs({ -1, 1 }) do
		pc:Part({
			Name = "SideWall",
			Size = Vector3.new(1, 10, l),
			CFrame = pc:C(side * (w / 2 + 0.5), 5, l / 2),
			Color = pc.theme.edge,
			Transparency = 0.6,
		})
	end
	pc:Go(0, 0, l)
	if o.gem then
		pc:Gem(w / 2 - 3, 0, spacing + 2)
	end
	return pc:Done(l)
end

-- Laser gates that switch on and off. Touching a live one sends you back.
B.lasers = function(pc, o)
	local count, period, w = o.count or 3, o.period or 3, o.w or 14
	local spacing = 12
	local l = count * spacing + 6
	pc:Floor(0, 0, l / 2, w, l)
	for index = 1, count do
		local z = index * spacing - 3
		for _, side in ipairs({ -1, 1 }) do
			pc:Part({
				Name = "LaserPost",
				Size = Vector3.new(1.2, 10, 1.2),
				CFrame = pc:C(side * (w / 2 + 0.6), 5, z),
				Color = Color3.fromRGB(60, 60, 70),
				Material = Enum.Material.Metal,
			})
		end
		local _, spec = pc:Mover(
			{
				Name = "Laser",
				Size = Vector3.new(w, 8, 0.4),
				Color = Color3.fromRGB(255, 40, 40),
				Material = Enum.Material.Neon,
				CanCollide = false,
				Transparency = 0.35,
			},
			{ Motion = "blink", Home = pc:C(0, 4, z), Period = period, On = period * 0.5, Phase = index * period / 3 },
			{ "Kill" }
		)
		pc:Node({ kind = "wait", spec = spec, at = pc:P(0, 0, z - 3), past = pc:P(0, 0, z + 3) })
	end
	pc:Rails(0, 0, l, w)
	pc:Go(0, 0, l)
	if o.gem then
		pc:Gem(-w / 2 + 2, 0, spacing * 1.5)
	end
	return pc:Done(l)
end

-- Big spinning discs to run across
B.discs = function(pc, o)
	local count, radius, speed = o.count or 2, o.r or 13, o.speed or 0.6
	local z = 4
	pc:Floor(0, 0, 2, 12, 4)
	for index = 1, count do
		z += 3 + radius
		local home = pc:C(0, -1, z)
		local _, spec = pc:Mover(
			{
				Name = "SpinDisc",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(2, radius * 2, radius * 2),
				Color = pc.theme.mover,
				Material = Enum.Material.SmoothPlastic,
			},
			{ Motion = "spin", Home = home, Offset = UPRIGHT, Speed = speed * (index % 2 == 0 and -1 or 1) }
		)
		-- Stripes on the disc so the spin is easy to see
		for stripe = 0, 1 do
			pc:Mover(
				{
					Name = "DiscStripe",
					Size = Vector3.new(radius * 2 - 2, 0.2, 1),
					Color = pc.theme.accent,
					Material = Enum.Material.Neon,
					CanCollide = false,
				},
				{
					Motion = "spin",
					Home = home,
					Offset = CFrame.new(0, 1.05, 0) * CFrame.Angles(0, stripe * math.pi / 2, 0),
					Speed = speed * (index % 2 == 0 and -1 or 1),
				}
			)
		end
		if o.bar then
			pc:Mover(
				{
					Name = "DiscBar",
					Size = Vector3.new(radius * 2 - 3, 1.2, 1.2),
					Color = pc.theme.hazard,
					Material = Enum.Material.SmoothPlastic,
					CanCollide = false,
					Attributes = { Low = true },
				},
				{ Motion = "spin", Home = home * CFrame.new(0, 2.4, 0), Speed = -speed * 2.2 },
				{ "Hit" }
			)
		end
		pc:Node({
			kind = "ride",
			spec = spec,
			enter = pc:P(0, 0, z - radius - 1),
			exit = pc:P(0, 0, z + radius + 2),
			spin = true,
		})
		z += radius
	end
	z += 3
	pc:Floor(0, 0, z + 3, 12, 6)
	pc:Go(0, 0, z + 3)
	if o.gem then
		pc:Gem(radius - 3, 0, 7 + radius)
	end
	return pc:Done(z + 6)
end

-- A climb up ledges while lava rises and drains below
B.climb = function(pc, o)
	local tiers, step, period = o.tiers or 4, o.step or 5, o.period or 10
	local z = 0
	local w = 16
	for index = 0, tiers do
		local y = index * step
		local depth = index == tiers and 10 or 7
		pc:Floor((index % 2 == 0) and -2 or 2, y, z + depth / 2, w - 4, depth, { thickness = y + 4 })
		if index > 0 then
			pc:Jump((index % 2 == 0) and -2 or 2, y, z + depth / 2)
		end
		z += depth + 1
	end
	local height = tiers * step
	local _, spec = pc:Mover(
		{
			Name = "Lava",
			Size = Vector3.new(w + 6, 2, z + 6),
			Color = Color3.fromRGB(255, 100, 20),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Transparency = 0.1,
		},
		{
			Motion = "lava",
			Home = pc:C(0, -2, z / 2),
			Low = -1,
			High = height * 0.6,
			Period = period,
			Rise = period * 0.25,
		},
		{ "Kill" }
	)
	pc:Node({ kind = "lava", spec = spec })
	pc:Go(0, height, z)
	if o.gem then
		pc:Floor(w / 2 + 4, height - step, z - 6, 5, 5, { Color = pc.theme.accent })
		pc:Gem(w / 2 + 4, height - step, z - 6)
	end
	return pc:Done(z, height)
end

-- A zipline down to a lower platform: step on the pad to grab it
B.zip = function(pc, o)
	local l, drop = o.len or 60, o.drop or 14
	pc:Floor(0, 0, 5, 14, 10)
	local from = pc:P(0, 7, 8)
	local to = pc:P(0, -drop + 4, l - 6)
	local pad = pc:Part({
		Name = "ZipPad",
		Size = Vector3.new(6, 0.3, 4),
		CFrame = pc:C(0, 0.15, 8),
		Color = pc.theme.accent,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Tags = { "Zip" },
	})
	pad:SetAttribute("ZipFrom", from)
	pad:SetAttribute("ZipTo", to)
	local length = (to - from).Magnitude
	pc:Part({
		Name = "ZipLine",
		Size = Vector3.new(0.3, 0.3, length),
		CFrame = CFrame.lookAt((from + to) / 2, to) * CFrame.new(0, 2, 0),
		Color = Color3.fromRGB(40, 40, 40),
		Material = Enum.Material.Metal,
		CanCollide = false,
	})
	for _, point in ipairs({ from, to }) do
		pc:Part({
			Name = "ZipPole",
			Size = Vector3.new(1, 10, 1),
			CFrame = CFrame.new(point + Vector3.new(0, -2, 0)),
			Color = pc.theme.edge,
			CanCollide = false,
		})
	end
	pc:Go(0, 0, 8)
	pc:Node({ kind = "zip", from = from, to = to })
	pc:Floor(0, -drop, l - 3, 16, 12)
	pc:Go(0, -drop, l + 2)
	if o.gem then
		pc:Gem(0, -drop + 10, l * 0.5)
	end
	return pc:Done(l + 3, -drop)
end

-- A tall climbing truss
B.truss = function(pc, o)
	local height = o.height or 16
	pc:Floor(0, 0, 4, 14, 8)
	local truss = Instance.new("TrussPart")
	truss.Anchored = true
	truss.Size = Vector3.new(2, height, 2)
	truss.CFrame = pc:C(0, height / 2, 9)
	truss.Color = pc.theme.edge
	truss.Parent = pc.folder
	pc:Part({
		Name = "Wall",
		Size = Vector3.new(14, height, 2),
		CFrame = pc:C(0, height / 2, 11),
		Color = pc.theme.floor[1],
	})
	pc:Go(0, 0, 7.5)
	pc:Node({ kind = "climb", to = pc:P(0, height + 0.5, 9) })
	pc:Floor(0, height, 16, 14, 10)
	pc:Go(0, height, 18)
	return pc:Done(21, height)
end

-- Pistons punch out from the walls of a bridge
B.pushers = function(pc, o)
	local count, period, w = o.count or 4, o.period or 3, o.w or 12
	local spacing = 10
	local l = count * spacing + 6
	pc:Floor(0, 0, l / 2, w, l)
	for index = 1, count do
		local z = index * spacing - 2
		local side = index % 2 == 0 and 1 or -1
		local home = pc:C(side * (w / 2 + 3), 2.5, z)
		pc:Part({
			Name = "PistonBox",
			Size = Vector3.new(6, 6, 7),
			CFrame = pc:C(side * (w / 2 + 6), 2.5, z),
			Color = pc.theme.edge,
		})
		pc:Mover(
			{
				Name = "Pusher",
				Size = Vector3.new(6, 4.5, 6),
				Color = pc.theme.hazard,
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
			},
			{
				Motion = "piston",
				Home = home,
				Axis = Vector3.new(-side, 0, 0),
				Dist = w - 3,
				Period = period,
				Phase = index * period / count,
			},
			{ "Hit" }
		)
		pc:Go(0, 0, z, { hazard = true })
	end
	pc:Go(0, 0, l)
	if o.gem then
		pc:Gem(0, 0, l - 4)
	end
	return pc:Done(l)
end

Kit.Builders = B

-- Builds one piece. ctx = { folder, theme, random, sign = function(part, text) }
function Kit.Build(kind, ctx, cursor, options)
	local builder = B[kind]
	if not builder then
		error("Unknown course piece: " .. tostring(kind))
	end
	local pc = newPiece(ctx, cursor)
	return builder(pc, options or {})
end

return Kit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[-- Builds Crown Plaza (the hub) when the place has no folder called "Map" in
-- Workspace, so the game is playable the moment you press Play. Courses and
-- tournament rounds are built separately, when someone plays them.
-- To use your own scenery later, the game only cares about parts with these attributes:
--   WorldGate = "candy"     walking into it opens that world's course list
--   DailyGate = true        walking into it starts the Daily Challenge
--   TournamentPad = 1       a pad that queues players for tournament 1
--   Station = "CrownsBoard" / "StarsBoard" / "HowTo"
--   GuideTarget = "FirstGate" / "Pads"   where the first-time guide points
--   LobbyFloor = true       the plaza (players who fall off it come back)

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Worlds = require(Shared.Worlds)

local MapBuilder = {}

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))
local PLAZA_RADIUS = 100

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function disc(folder, name, position, radius, thickness, color, material)
	return part({
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(thickness, radius * 2, radius * 2),
		CFrame = CFrame.new(position - Vector3.new(0, thickness / 2, 0)) * UPRIGHT,
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		Parent = folder,
	})
end

local function sign(parentPart, text, face, color, pixelsPerStud)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud or 40
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Parent = gui
	gui.Parent = parentPart
	return label
end

local function bothSides(parentPart, text, color, pixelsPerStud)
	sign(parentPart, text, Enum.NormalId.Front, color, pixelsPerStud)
	return sign(parentPart, text, Enum.NormalId.Back, color, pixelsPerStud)
end

local function cloud(folder, position, size, random)
	for _ = 1, 4 do
		part({
			Name = "Cloud",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * size * random:NextNumber(0.6, 1),
			Position = position + Vector3.new(
				random:NextNumber(-size, size),
				random:NextNumber(-size / 4, size / 4),
				random:NextNumber(-size / 2, size / 2)
			),
			Color = Color3.new(1, 1, 1),
			Material = Enum.Material.SmoothPlastic,
			Transparency = 0.25,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Parent = folder,
		})
	end
end

local function lamp(folder, position, color)
	part({
		Name = "LampPost",
		Size = Vector3.new(0.6, 9, 0.6),
		Position = position + Vector3.new(0, 4.5, 0),
		Color = Color3.fromRGB(60, 60, 75),
		Material = Enum.Material.Metal,
		Parent = folder,
	})
	local bulb = part({
		Name = "Lamp",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.8, 1.8, 1.8),
		Position = position + Vector3.new(0, 9.4, 0),
		Color = color,
		Material = Enum.Material.Neon,
		Parent = folder,
	})
	local light = Instance.new("PointLight")
	light.Range = 16
	light.Brightness = 1.5
	light.Color = color
	light.Parent = bulb
end

local function board(folder, name, cframe, size, station)
	local p = part({
		Name = name,
		Size = size,
		CFrame = cframe,
		Color = Color3.fromRGB(30, 40, 60),
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	p:SetAttribute("Station", station)
	local postHeight = cframe.Position.Y - size.Y / 2 + 0.5
	for _, x in ipairs({ -size.X / 2 + 1, size.X / 2 - 1 }) do
		local at = (cframe * CFrame.new(x, 0, 0)).Position
		part({
			Name = "BoardPost",
			Size = Vector3.new(0.8, postHeight, 0.8),
			Position = Vector3.new(at.X, postHeight / 2, at.Z),
			Color = Color3.fromRGB(60, 60, 70),
			Material = Enum.Material.Metal,
			Parent = folder,
		})
	end
	return p
end

-- A floating island of a world's colours, seen through its gate
local function worldIsland(folder, world, position, random)
	disc(folder, world.id .. "IslandTop", position, 14, 3, world.floor[1], world.material)
	for index, shrink in ipairs({ 0.85, 0.6, 0.35 }) do
		disc(
			folder,
			world.id .. "IslandRock" .. index,
			position - Vector3.new(0, 3 + (index - 1) * 5, 0),
			14 * shrink,
			5,
			world.edge:Lerp(Color3.new(0, 0, 0), 0.25 + index * 0.1),
			Enum.Material.Rock
		)
	end
	-- A few blocks of the world's obstacles for a taste
	for index = 1, 3 do
		local angle = random:NextNumber(0, math.pi * 2)
		local at = position + Vector3.new(math.cos(angle) * 7, 2 + index, math.sin(angle) * 7)
		part({
			Name = "Deco",
			Size = Vector3.new(3, 3, 3),
			CFrame = CFrame.new(at) * CFrame.Angles(0, angle, 0.3),
			Color = index == 1 and world.hazard or (index == 2 and world.mover or world.accent),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Parent = folder,
		})
	end
end

-- A world gate: an arch with a glowing doorway, the world's name and the stars it needs
local function worldGate(folder, world, cframe)
	local width, height = 14, 16
	local color = world.edge
	for _, side in ipairs({ -1, 1 }) do
		part({
			Name = "GatePillar",
			Size = Vector3.new(2.5, height, 2.5),
			CFrame = cframe * CFrame.new(side * (width / 2 + 1.25), height / 2, 0),
			Color = color,
			Material = Enum.Material.SmoothPlastic,
			Parent = folder,
		})
		part({
			Name = "GateCap",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(3.4, 3.4, 3.4),
			CFrame = cframe * CFrame.new(side * (width / 2 + 1.25), height + 2, 0),
			Color = world.accent,
			Material = Enum.Material.Neon,
			Parent = folder,
		})
	end
	local top = part({
		Name = "GateTop",
		Size = Vector3.new(width + 5, 4, 3),
		CFrame = cframe * CFrame.new(0, height + 2, 0),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	sign(top, world.name, Enum.NormalId.Back, Color3.new(1, 1, 1), 30)
	sign(top, world.name, Enum.NormalId.Front, Color3.new(1, 1, 1), 30)
	local portal = part({
		Name = "Portal",
		Size = Vector3.new(width, height, 1),
		CFrame = cframe * CFrame.new(0, height / 2, 0),
		Color = world.mover,
		Material = Enum.Material.Neon,
		Transparency = 0.45,
		CanCollide = false,
		Parent = folder,
	})
	portal:SetAttribute("WorldGate", world.id)
	local starSign = part({
		Name = "StarSign",
		Size = Vector3.new(10, 2.6, 0.4),
		CFrame = cframe * CFrame.new(0, 2, 1.6),
		Color = Color3.fromRGB(30, 35, 55),
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	local starText = world.stars == 0 and "Open to all" or string.format("Needs %d stars", world.stars)
	sign(starSign, starText, Enum.NormalId.Back, Color3.fromRGB(255, 230, 120), 30)
	-- A path tile in front of the gate
	part({
		Name = "GateMat",
		Size = Vector3.new(width, 0.2, 10),
		CFrame = cframe * CFrame.new(0, 0.1, 7),
		Color = world.floor[1],
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		Parent = folder,
	})
	return portal
end

-- A tournament pad: queue here for a knockout tournament
local function tournamentPad(folder, slot, position, color)
	local pad =
		disc(folder, "TournamentPad" .. slot, position + Vector3.new(0, 0.4, 0), 9, 0.4, color, Enum.Material.Neon)
	pad.CanCollide = false
	pad:SetAttribute("TournamentPad", slot)
	disc(
		folder,
		"PadRim" .. slot,
		position + Vector3.new(0, 0.3, 0),
		10,
		0.3,
		Color3.fromRGB(40, 45, 60),
		Enum.Material.Metal
	)
	for index = 0, 7 do
		local angle = index / 8 * math.pi * 2
		part({
			Name = "PadLight",
			Size = Vector3.new(0.6, 6, 0.6),
			Position = position + Vector3.new(math.cos(angle) * 9.5, 3, math.sin(angle) * 9.5),
			Color = color,
			Material = Enum.Material.Neon,
			Transparency = 0.4,
			CanCollide = false,
			CanQuery = false,
			Parent = folder,
		})
	end
	local look = CFrame.lookAt(position, Vector3.new(0, 0, 0))
	local signPart = part({
		Name = "PadSign" .. slot,
		Size = Vector3.new(16, 6, 0.6),
		CFrame = look * CFrame.new(0, 12, 11),
		Color = Color3.fromRGB(25, 30, 45),
		Parent = folder,
	})
	signPart:SetAttribute("PadSign", slot)
	local label = sign(signPart, "TOURNAMENT", Enum.NormalId.Front, color, 30)
	label.Name = "Status"
	for _, x in ipairs({ -7.4, 7.4 }) do
		part({
			Name = "SignPost",
			Size = Vector3.new(0.6, 10, 0.6),
			CFrame = look * CFrame.new(x, 5, 11),
			Color = Color3.fromRGB(60, 60, 70),
			Material = Enum.Material.Metal,
			Parent = folder,
		})
	end
	return pad
end

function MapBuilder.Build()
	Lighting.ClockTime = 14
	Lighting.Brightness = 2.5
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 165)
	Lighting.GlobalShadows = true

	if Workspace:FindFirstChild("Map") then
		return -- the creator made their own map
	end

	local map = Instance.new("Folder")
	map.Name = "Map"
	local scenery = Instance.new("Folder")
	scenery.Name = "Scenery"
	scenery.Parent = map
	local random = Random.new(11)

	-- The plaza island: a big round floor with coloured rings, rock underneath
	local top = disc(
		scenery,
		"PlazaTop",
		Vector3.new(0, 0, 0),
		PLAZA_RADIUS,
		3,
		Color3.fromRGB(245, 240, 230),
		Enum.Material.Concrete
	)
	top:SetAttribute("LobbyFloor", true)
	disc(
		scenery,
		"PlazaRing",
		Vector3.new(0, 0.05, 0),
		46,
		0.1,
		Color3.fromRGB(255, 205, 90),
		Enum.Material.SmoothPlastic
	).CanCollide =
		false
	disc(scenery, "PlazaInner", Vector3.new(0, 0.1, 0), 40, 0.1, Color3.fromRGB(250, 245, 235), Enum.Material.Concrete).CanCollide =
		false
	for index, shrink in ipairs({ 0.9, 0.72, 0.5, 0.28 }) do
		disc(
			scenery,
			"PlazaRock" .. index,
			Vector3.new(0, -3 - (index - 1) * 7, 0),
			PLAZA_RADIUS * shrink,
			7,
			Color3.fromRGB(150, 135, 125):Lerp(Color3.fromRGB(90, 80, 75), index / 4),
			Enum.Material.Rock
		)
	end
	for index = 0, 35 do
		local angle = index / 36 * math.pi * 2
		local at = Vector3.new(math.cos(angle) * (PLAZA_RADIUS - 1), 4, math.sin(angle) * (PLAZA_RADIUS - 1))
		part({
			Name = "EdgeWall",
			Size = Vector3.new(1, 8, 19),
			CFrame = CFrame.lookAt(at, Vector3.new(0, 4, 0)) * CFrame.Angles(0, math.rad(90), 0),
			Transparency = 1,
			Parent = map,
		})
		if index % 2 == 0 then
			part({
				Name = "Fence",
				Size = Vector3.new(0.6, 2.5, 17.5),
				CFrame = CFrame.lookAt(Vector3.new(at.X, 1.25, at.Z), Vector3.new(0, 1.25, 0))
					* CFrame.Angles(0, math.rad(90), 0),
				Color = Color3.fromRGB(255, 255, 255),
				Material = Enum.Material.SmoothPlastic,
				Parent = scenery,
			})
		end
	end

	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name = "PlazaSpawn"
	spawnLocation.Anchored = true
	spawnLocation.Size = Vector3.new(14, 1, 14)
	spawnLocation.CFrame = CFrame.lookAt(Vector3.new(0, 0.5, 62), Vector3.new(0, 0.5, 0))
	spawnLocation.Material = Enum.Material.SmoothPlastic
	spawnLocation.Color = Color3.fromRGB(255, 200, 60)
	spawnLocation.Duration = 0
	spawnLocation.Parent = map

	-- The crown fountain in the middle
	disc(scenery, "FountainRim", Vector3.new(0, 2, 0), 12, 2, Color3.fromRGB(230, 225, 215), Enum.Material.Marble)
	disc(scenery, "FountainWater", Vector3.new(0, 2.1, 0), 10.5, 0.4, Color3.fromRGB(90, 190, 255), Enum.Material.Glass).Transparency =
		0.3
	part({
		Name = "Pedestal",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(8, 4, 4),
		CFrame = CFrame.new(0, 4, 0) * UPRIGHT,
		Color = Color3.fromRGB(240, 235, 225),
		Material = Enum.Material.Marble,
		Parent = scenery,
	})
	local crownBase = part({
		Name = "CrownBand",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3, 9, 9),
		CFrame = CFrame.new(0, 10, 0) * UPRIGHT,
		Color = Color3.fromRGB(255, 200, 40),
		Material = Enum.Material.Foil,
		Parent = scenery,
	})
	for index = 0, 4 do
		local angle = index / 5 * math.pi * 2
		part({
			Name = "CrownPoint",
			Size = Vector3.new(2, 4, 2),
			CFrame = CFrame.new(math.cos(angle) * 3.6, 13, math.sin(angle) * 3.6)
				* CFrame.Angles(0, -angle, 0)
				* CFrame.Angles(0, 0, math.rad(45)),
			Color = Color3.fromRGB(255, 200, 40),
			Material = Enum.Material.Foil,
			Parent = scenery,
		})
		part({
			Name = "CrownJewel",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1.4, 1.4, 1.4),
			Position = Vector3.new(math.cos(angle) * 4.5, 10, math.sin(angle) * 4.5),
			Color = Color3.fromRGB(255, 60, 90),
			Material = Enum.Material.Neon,
			Parent = scenery,
		})
	end
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 220, 120)
	glow.Range = 24
	glow.Parent = crownBase

	-- World gates in an arc to the north, each facing the fountain
	for index, world in ipairs(Worlds.List) do
		local angle = math.rad(-150 + (index - 1) * 30)
		local at = Vector3.new(math.cos(angle) * 74, 0, math.sin(angle) * 74)
		local cframe = CFrame.lookAt(at, Vector3.new(0, 0, 0)) * CFrame.Angles(0, math.pi, 0)
		local portal = worldGate(map, world, cframe)
		if index == 1 then
			portal:SetAttribute("GuideTarget", "FirstGate")
		end
		worldIsland(scenery, world, at * 1.45 + Vector3.new(0, 18 + index * 3, 0), random)
	end

	-- Tournament pads to the west
	tournamentPad(map, 1, Vector3.new(-62, 0, 28), Color3.fromRGB(255, 180, 40))
	tournamentPad(map, 2, Vector3.new(-48, 0, 56), Color3.fromRGB(255, 90, 160))
	local padsTarget = part({
		Name = "PadsTarget",
		Size = Vector3.new(2, 1, 2),
		Position = Vector3.new(-55, 1, 42),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = map,
	})
	padsTarget:SetAttribute("GuideTarget", "Pads")

	-- The Daily Challenge gate to the east
	local dailyCFrame = CFrame.lookAt(Vector3.new(66, 0, 34), Vector3.new(0, 0, 0)) * CFrame.Angles(0, math.pi, 0)
	local daily = worldGate(
		map,
		{
			id = "daily",
			name = "Daily Challenge",
			stars = 0,
			edge = Color3.fromRGB(70, 200, 255),
			accent = Color3.fromRGB(255, 255, 255),
			mover = Color3.fromRGB(110, 230, 255),
			floor = { Color3.fromRGB(200, 240, 255) },
		},
		dailyCFrame
	)
	daily:SetAttribute("WorldGate", nil)
	daily:SetAttribute("DailyGate", true)

	-- Leaderboards and the how-to-play board, near the spawn
	board(
		map,
		"CrownsBoard",
		CFrame.lookAt(Vector3.new(40, 11, 72), Vector3.new(0, 11, 30)),
		Vector3.new(22, 16, 1),
		"CrownsBoard"
	)
	board(
		map,
		"StarsBoard",
		CFrame.lookAt(Vector3.new(-30, 11, 80), Vector3.new(0, 11, 30)),
		Vector3.new(22, 16, 1),
		"StarsBoard"
	)
	local howTo = board(
		map,
		"HowToBoard",
		CFrame.lookAt(Vector3.new(16, 8, 84), Vector3.new(0, 8, 40)),
		Vector3.new(18, 11, 1),
		"HowTo"
	)
	local howToText =
		"HOW TO PLAY\n\nAdventure: walk into a world gate\nTournament: step on a glowing pad\n\nRun, jump (Space) and dive (Q)\nGet stars and find hidden gems\nWin tournaments for crowns!"
	bothSides(howTo, howToText, Color3.fromRGB(255, 240, 200), 30)

	local title = part({
		Name = "TitleSign",
		Size = Vector3.new(56, 11, 1.5),
		Position = Vector3.new(0, 44, -96),
		Color = Color3.fromRGB(255, 120, 60),
		Material = Enum.Material.SmoothPlastic,
		Parent = scenery,
	})
	bothSides(title, string.upper(Config.GameName), Color3.new(1, 1, 1))
	for _, x in ipairs({ -26, 26 }) do
		part({
			Name = "TitlePost",
			Size = Vector3.new(1.4, 44, 1.4),
			Position = Vector3.new(x, 22, -96),
			Color = Color3.fromRGB(60, 60, 70),
			Material = Enum.Material.Metal,
			Parent = scenery,
		})
	end

	-- Bunting, lamps and clouds
	local colors = {
		Color3.fromRGB(255, 90, 90),
		Color3.fromRGB(255, 200, 60),
		Color3.fromRGB(90, 200, 255),
		Color3.fromRGB(140, 230, 120),
		Color3.fromRGB(200, 120, 255),
	}
	for index = 0, 11 do
		local angle = index / 12 * math.pi * 2
		local at = Vector3.new(math.cos(angle) * 44, 0, math.sin(angle) * 44)
		lamp(scenery, at, colors[(index % #colors) + 1])
	end
	for _ = 1, 14 do
		local angle = random:NextNumber(0, math.pi * 2)
		cloud(
			scenery,
			Vector3.new(
				math.cos(angle) * random:NextNumber(140, 260),
				random:NextNumber(-70, -20),
				math.sin(angle) * random:NextNumber(140, 260)
			),
			random:NextNumber(14, 26),
			random
		)
	end

	map.Parent = Workspace
end

return MapBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">ProgressService</string><ProtectedString name="Source"><![CDATA[-- Coins, XP, levels, daily quests and the daily login reward, plus the menu
-- buttons players press (all go through the "Action" remote). Other services
-- add their own actions with ProgressService.AddAction.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Cosmetics = require(Shared.Cosmetics)
local Courses = require(Shared.Courses)
local Quests = require(Shared.Quests)
local Level = require(Shared.Level)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)

local ProgressService = {}

local function notify(player, text, kind)
	Remotes.Notify:FireClient(player, text, kind)
end

local function refreshQuests(player, data)
	local today = Quests.Today(os.time())
	if data.quests.day ~= today then
		data.quests.day = today
		local maxStars = #Courses.List * 3
		local gems = 0
		for _, record in pairs(data.adventure) do
			for index = 0, 2 do
				if bit32.band(record.gems or 0, bit32.lshift(1, index)) ~= 0 then
					gems += 1
				end
			end
		end
		data.quests.list = Quests.Generate(player.UserId, today, {
			stars = maxStars - Courses.TotalStars(data.adventure),
			gems = #Courses.List * 3 - gems,
		})
	end
end

-- Adds XP and pays the coin reward for every level reached. Call inside DataService.Update.
local function addXp(player, data, amount)
	data.xp += amount
	local level = Level.FromXp(data.xp)
	local reached = {}
	while data.levelRewards < level do
		data.levelRewards += 1
		local reward = data.levelRewards * Level.CoinsPerLevel
		data.coins += reward
		data.totalEarned += reward
		table.insert(reached, { level = data.levelRewards, coins = reward })
	end
	for _, entry in ipairs(reached) do
		task.defer(
			notify,
			player,
			string.format("Level %d! +%s coins", entry.level, Format.Number(entry.coins)),
			"rare"
		)
	end
end

-- Adds to the daily quests. Call inside DataService.Update.
local function addQuestProgress(player, data, counts)
	refreshQuests(player, data)
	for _, entry in ipairs(data.quests.list) do
		local quest = Quests.ById[entry.id]
		if quest and not entry.done then
			entry.progress = math.min(entry.goal, entry.progress + (counts[quest.stat] or 0))
			if entry.progress >= entry.goal then
				entry.done = true
				data.coins += quest.coins
				data.totalEarned += quest.coins
				addXp(player, data, math.floor(quest.coins * Quests.XpShare))
				task.defer(
					notify,
					player,
					string.format("Quest done: %s! +%d coins", Quests.Text(entry), quest.coins),
					"success"
				)
			end
		end
	end
end

-- Pays a reward. result = {
--   coins, xp,
--   stats = { key = amount } added to the saved stats (keys that exist),
--   quest = { key = amount } counted toward daily quests (defaults to stats),
--   crowns = amount for the weekly crowns board,
--   message = toast text (coins and XP are added to it), quiet = true for none }
-- Returns the coins (after the VIP bonus) and XP given.
function ProgressService.AddResult(player, result)
	if not DataService.IsLoaded(player) then
		return 0, 0
	end
	local coins = result.coins or 0
	if ShopService.HasPass(player, "VIP") then
		coins = math.floor(coins * (1 + Config.VipCoinBonus))
	end
	local xp = result.xp or 0
	DataService.Update(player, function(data)
		data.coins += coins
		data.totalEarned += coins
		for key, value in pairs(result.stats or {}) do
			if data.stats[key] ~= nil then
				data.stats[key] += value
			end
		end
		local week = Quests.Week(os.time())
		if data.weekly.week ~= week then
			data.weekly.week = week
			data.weekly.crowns = 0
		end
		data.weekly.crowns += result.crowns or 0
		addXp(player, data, xp)
		addQuestProgress(player, data, result.quest or result.stats or {})
	end)
	if not result.quiet then
		notify(
			player,
			string.format("%s +%s coins, +%d XP", result.message or "Nice!", Format.Number(coins), xp),
			"coins"
		)
	end
	return coins, xp
end

------------------------------------------------------------------ Actions
local function buyCosmetic(player, itemId)
	local item = Cosmetics.ById[itemId or ""]
	local data = DataService.Get(player)
	if not item or not data then
		return false, "Unknown item"
	end
	if item.source ~= "coins" then
		return false, "That one can't be bought with coins"
	end
	if data.cosmetics.owned[item.id] then
		return false, "You already have it"
	end
	if data.coins < item.price then
		return false, string.format("You need %s more coins", Format.Number(item.price - data.coins))
	end
	DataService.Update(player, function(saved)
		saved.coins -= item.price
		saved.cosmetics.owned[item.id] = true
		saved.cosmetics.equipped[item.kind] = item.id
	end)
	notify(player, "You got " .. item.name .. "! It's equipped.", "success")
	return true
end

local function equipCosmetic(player, itemId)
	local item = Cosmetics.ById[itemId or ""]
	local data = DataService.Get(player)
	if not item or not data then
		return false, "Unknown item"
	end
	if not Cosmetics.Owns(data, item, ShopService.HasPass(player, "VIP")) then
		return false, "You don't own that yet"
	end
	DataService.Update(player, function(saved)
		if saved.cosmetics.equipped[item.kind] == item.id and not Cosmetics.Defaults[item.kind] then
			saved.cosmetics.equipped[item.kind] = nil -- pressing again takes a title or trail off
		else
			saved.cosmetics.equipped[item.kind] = item.id
		end
	end)
	return true
end

local function giveDailyReward(player, data)
	local today = math.floor(os.time() / 86400)
	if data.lastDailyDay == today then
		return
	end
	if data.lastDailyDay == today - 1 then
		data.dailyStreak += 1
	else
		data.dailyStreak = 1
	end
	data.lastDailyDay = today
	local day = math.min(data.dailyStreak, Config.DailyStreakCap)
	local reward = Config.DailyRewardBase * day
	data.coins += reward
	data.totalEarned += reward
	task.spawn(function()
		if DataService.WaitFor(player) then
			notify(
				player,
				string.format(
					"Daily reward (day %d streak): +%s coins! Come back tomorrow for more.",
					data.dailyStreak,
					Format.Number(reward)
				),
				"coins"
			)
		end
	end)
end

local actions = {
	BuyCosmetic = buyCosmetic,
	EquipCosmetic = equipCosmetic,
}

-- Lets other services add actions (the guide's reset, for example)
function ProgressService.AddAction(name, handler)
	actions[name] = handler
end

function ProgressService.Start()
	DataService.OnLoaded(function(player, data)
		giveDailyReward(player, data)
		refreshQuests(player, data)
	end)

	-- New quests at midnight UTC for players who are online
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = DataService.Get(player)
				if data and data.quests.day ~= Quests.Today(os.time()) then
					DataService.Update(player, function(saved)
						refreshQuests(player, saved)
					end)
				end
			end
		end
	end)

	Remotes.Action.OnServerInvoke = function(player, actionName, argument)
		local action = actions[actionName]
		if type(actionName) ~= "string" or not action then
			return false, "Unknown action"
		end
		if argument ~= nil and type(argument) ~= "string" then
			return false, "Bad request"
		end
		local ok, success, message = pcall(action, player, argument)
		if not ok then
			warn("[ProgressService] " .. actionName .. " failed: " .. tostring(success))
			return false, "Something went wrong"
		end
		return success, message
	end
end

return ProgressService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[-- Robux purchases: the VIP game pass and cosmetic developer products.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Shop = require(Shared.Shop)
local Cosmetics = require(Shared.Cosmetics)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)

local ShopService = {}

function ShopService.HasPass(player, passId)
	local runtime = DataService.GetRuntime(player)
	return runtime ~= nil and runtime.passes ~= nil and runtime.passes[passId] == true
end

local function checkPasses(player, runtime)
	runtime.passes = {}
	local testing = RunService:IsStudio() and Config.TestPassesInStudio
	for _, pass in ipairs(Shop.Passes) do
		if testing then
			runtime.passes[pass.id] = true
		elseif pass.gamePassId ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.gamePassId)
			end)
			runtime.passes[pass.id] = ok and owns or false
		end
	end
end

local function onPassPurchased(player, gamePassId, purchased)
	if not purchased then
		return
	end
	for _, pass in ipairs(Shop.Passes) do
		if pass.gamePassId == gamePassId and pass.gamePassId ~= 0 then
			DataService.Update(player, function(_, runtime)
				runtime.passes[pass.id] = true
			end)
			Remotes.Notify:FireClient(player, "Thanks for buying " .. pass.name .. "!", "success")
		end
	end
end

-- Roblox calls this for every developer product purchase. It must only return
-- PurchaseGranted once the item is given AND saved, otherwise Roblox retries later.
local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player or not DataService.IsLoaded(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local item = Cosmetics.ByProductId[receipt.ProductId]
	if not item then
		warn("[ShopService] Unknown product id " .. tostring(receipt.ProductId) .. " - add it to Cosmetics.luau")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local data = DataService.Get(player)
	if data.purchases[receipt.PurchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	DataService.Update(player, function(saved)
		saved.purchases[receipt.PurchaseId] = true
		saved.cosmetics.owned[item.id] = true
		saved.cosmetics.equipped[item.kind] = item.id
	end)

	if not DataService.SaveNow(player) then
		-- Keep the item, Roblox will call again and the purchase id stops a double grant
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	Remotes.Notify:FireClient(player, "You got " .. item.name .. "! It's equipped.", "success")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function ShopService.Start()
	DataService.OnLoaded(function(player, _, runtime)
		checkPasses(player, runtime)
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(onPassPurchased)
	MarketplaceService.ProcessReceipt = processReceipt
end

return ShopService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">TutorialService</string><ProtectedString name="Source"><![CDATA[-- Moves players through the first-time guide (see Shared/Tutorial).
-- Other services call TutorialService.Event(player, "Gate") etc. Doing a later
-- step first (like jumping straight into a match) skips the earlier ones.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Tutorial = require(Shared.Tutorial)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)

local TutorialService = {}

function TutorialService.Event(player, event)
	local data = DataService.Get(player)
	if not data or data.tutorial >= Tutorial.Done then
		return
	end
	local index = nil
	for stepIndex, step in ipairs(Tutorial.Steps) do
		if step.event == event then
			index = stepIndex
		end
	end
	if not index or index < data.tutorial then
		return
	end
	local finished = index + 1 >= Tutorial.Done
	DataService.Update(player, function(saved)
		saved.tutorial = index + 1
		if finished then
			saved.coins += Tutorial.RewardCoins
			saved.totalEarned += Tutorial.RewardCoins
		end
	end)
	if finished then
		Remotes.Notify:FireClient(
			player,
			string.format(
				"You're a natural! Here's %s coins. Spend them in the Locker.",
				Format.Number(Tutorial.RewardCoins)
			),
			"success"
		)
	end
end

function TutorialService.Start() end

return TutorialService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">WorldService</string><ProtectedString name="Source"><![CDATA[-- The plaza: the global leaderboards, and catching players who fall off it.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Quests = require(Shared.Quests)
local Format = require(Shared.Format)

local CourseService = require(script.Parent.CourseService)

local WorldService = {}

local LEADERBOARD_REFRESH = 120
local lobbySpawn = nil

------------------------------------------------------------------ Leaderboards
local function makeBoardFace(boardPart, face)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "BoardGui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 12)
	padding.PaddingLeft = UDim.new(0, 16)
	padding.PaddingRight = UDim.new(0, 16)
	padding.Parent = gui
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.new(1, 0, 0.16, 0)
	title.BackgroundTransparency = 1
	title.TextScaled = true
	title.Font = Enum.Font.FredokaOne
	title.TextColor3 = Color3.fromRGB(255, 220, 120)
	title.Parent = gui
	local body = Instance.new("TextLabel")
	body.Name = "Body"
	body.Position = UDim2.new(0, 0, 0.18, 0)
	body.Size = UDim2.new(1, 0, 0.8, 0)
	body.BackgroundTransparency = 1
	body.Text = "Loading..."
	body.TextScaled = true
	body.TextXAlignment = Enum.TextXAlignment.Left
	body.TextYAlignment = Enum.TextYAlignment.Top
	body.Font = Enum.Font.GothamMedium
	body.TextColor3 = Color3.new(1, 1, 1)
	body.Parent = gui
	gui.Parent = boardPart
	return title, body
end

-- Boards show the same text on both sides. Returns a function(title, text).
local function makeBoardGui(boardPart)
	local frontTitle, frontBody = makeBoardFace(boardPart, Enum.NormalId.Front)
	local backTitle, backBody = makeBoardFace(boardPart, Enum.NormalId.Back)
	return function(title, text)
		frontTitle.Text = title
		backTitle.Text = title
		frontBody.Text = text
		backBody.Text = text
	end
end

local function findStation(name)
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("Station") == name then
			return item
		end
	end
	return nil
end

local nameCache = {}
local function nameFor(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = ok and name or ("Player " .. userId)
	return nameCache[userId]
end

local function topTen(storeName, emptyText)
	local ok, pages = pcall(function()
		return DataStoreService:GetOrderedDataStore(storeName):GetSortedAsync(false, 10)
	end)
	if not ok then
		return "Leaderboard unavailable right now."
	end
	local lines = {}
	for rank, entry in ipairs(pages:GetCurrentPage()) do
		table.insert(
			lines,
			string.format("%d. %s  -  %s", rank, nameFor(tonumber(entry.key)), Format.Number(entry.value))
		)
	end
	return #lines > 0 and table.concat(lines, "\n") or emptyText
end

-- The crowns board takes turns showing all-time crowns and this week's crowns
local function runCrownsBoard(boardPart)
	local setText = makeBoardGui(boardPart)
	local allTime, weekly, weekLeft = "Loading...", "Loading...", 0
	task.spawn(function()
		while true do
			local week, left = Quests.Week(os.time())
			allTime = topTen(Config.CrownsStoreName, "No crowns yet. Be the first!")
			weekly = topTen(Config.WeeklyCrownsStorePrefix .. week, "No crowns this week yet!")
			weekLeft = os.time() + left
			task.wait(LEADERBOARD_REFRESH)
		end
	end)
	while true do
		setText("Most Crowns", allTime)
		task.wait(12)
		setText("This Week's Crowns", weekly .. "\n\nNew week in " .. Format.Duration(weekLeft - os.time()))
		task.wait(12)
	end
end

local function runStarsBoard(boardPart)
	local setText = makeBoardGui(boardPart)
	while true do
		setText("Most Stars", topTen(Config.StarsStoreName, "No stars yet. Play a course!"))
		task.wait(LEADERBOARD_REFRESH)
	end
end

function WorldService.Start(spawnFn)
	lobbySpawn = spawnFn
	local crownsBoard = findStation("CrownsBoard")
	if crownsBoard then
		task.spawn(runCrownsBoard, crownsBoard)
	end
	local starsBoard = findStation("StarsBoard")
	if starsBoard then
		task.spawn(runStarsBoard, starsBoard)
	end

	-- Anyone who falls off the plaza comes back to the spawn
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, player in ipairs(Players:GetPlayers()) do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if
					root
					and root.Position.Y < -40
					and root.Position.X < 1000
					and not CourseService.Get(player)
					and not player:GetAttribute("InTournament")
				then
					character:PivotTo(lobbySpawn())
					root.AssemblyLinearVelocity = Vector3.zero
				end
			end
		end
	end)
end

return WorldService
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX0000002A"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000029"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000028"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[-- Crown Rush player script. Builds the screen and starts the controls.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local UI = require(script.UI)
local Notifications = require(script.Notifications)
local Movement = require(script.Movement)
local Controls = require(script.Controls)
local Effects = require(script.Effects)
local Panels = require(script.Panels)
local RunHud = require(script.RunHud)
local Hud = require(script.Hud)
local Guide = require(script.Guide)

local player = Players.LocalPlayer

local screenGui = UI.new("ScreenGui", {
	Name = "CrownRushUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

-- Shrink the whole UI on small screens (phones)
local scale = UI.new("UIScale", { Parent = screenGui })
local function rescale()
	local camera = Workspace.CurrentCamera
	if camera then
		local size = camera.ViewportSize
		scale.Scale = math.clamp(math.min(size.X / 1100, size.Y / 700), 0.55, 1.2)
	end
end
while not Workspace.CurrentCamera do
	task.wait()
end
Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
rescale()

Notifications.Init(screenGui)
Movement.Init()
Controls.Init()
Effects.Init()
Panels.Init(screenGui)
RunHud.Init(screenGui)
Hud.Init(screenGui)
Guide.Init(screenGui)
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">Controls</string><ProtectedString name="Source"><![CDATA[-- Dive, jump help, and the hammer swing in fight rounds.
--   Dive: Q, X on a controller, or the DIVE button on phones.
--         A quick forward lunge, once per jump, to reach a ledge or grab a gem.
--   Jump help: you can still jump a moment after running off an edge, and a
--         jump pressed just before landing still counts. Phones need this most.
--   Bonk: click, F, R2 on a controller, or the BONK button on phones, only
--         while you hold a foam hammer (fight rounds). The server decides who
--         gets hit; this script only asks to swing.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Movement = require(script.Parent.Movement)

local Controls = {}

local player = Players.LocalPlayer
local DIVE_SECONDS = 0.32
local JUMP_BUFFER = 0.15

local lastBonk = 0
local lastDive = 0
local divedThisJump = false
local diving = nil
local lastGrounded = 0
local jumpedSinceGround = false
local jumpPressedAt = -1
local hammerShown = nil

local function parts()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if root and humanoid and humanoid.Health > 0 then
		return root, humanoid, character
	end
	return nil
end

local function flat(vector)
	return Vector3.new(vector.X, 0, vector.Z)
end

local function stopDive()
	if diving then
		diving.mover:Destroy()
		diving.attachment:Destroy()
		diving = nil
	end
end

function Controls.HasHammer()
	local character = player.Character
	return character ~= nil and character:GetAttribute("HasHammer") == true
end

function Controls.Bonk()
	local now = os.clock()
	if not Controls.HasHammer() or now - lastBonk < Config.BonkCooldown or Movement.IsStunned() or not parts() then
		return
	end
	lastBonk = now
	Remotes.Bonk:FireServer()
end

function Controls.Dive()
	local now = os.clock()
	local root, humanoid = parts()
	if not root or now - lastDive < Config.DiveCooldown or Movement.IsStunned() or humanoid.WalkSpeed <= 0 then
		return
	end
	local inAir = humanoid.FloorMaterial == Enum.Material.Air
	if inAir and divedThisJump then
		return
	end
	local direction = flat(humanoid.MoveDirection)
	if direction.Magnitude < 0.1 then
		direction = flat(root.CFrame.LookVector)
	end
	if direction.Magnitude < 0.1 then
		return
	end
	direction = direction.Unit
	lastDive = now
	divedThisJump = true
	stopDive()
	local attachment = Instance.new("Attachment")
	attachment.Name = "DiveAttachment"
	attachment.Parent = root
	local mover = Instance.new("LinearVelocity")
	mover.Name = "Dive"
	mover.Attachment0 = attachment
	mover.RelativeTo = Enum.ActuatorRelativeTo.World
	mover.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	mover.MaxAxesForce = Vector3.new(1e6, 0, 1e6)
	mover.VectorVelocity = direction * Config.DiveSpeed
	mover.Parent = root
	local velocity = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(velocity.X, math.max(velocity.Y, 0) + Config.DiveUp, velocity.Z)
	root.CFrame = CFrame.lookAt(root.Position, root.Position + direction)
	if not inAir then
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	end
	local this = { mover = mover, attachment = attachment }
	diving = this
	task.delay(DIVE_SECONDS, function()
		if diving == this then
			stopDive()
		end
	end)
	Remotes.Dive:FireServer()
end

-- 0 to 1: how ready each move is (for the phone buttons)
function Controls.Cooldowns()
	local now = os.clock()
	return math.clamp((now - lastBonk) / Config.BonkCooldown, 0, 1),
		math.clamp((now - lastDive) / Config.DiveCooldown, 0, 1)
end

-- Jump a moment after leaving an edge, or just before landing
local function watchJumps(humanoid)
	humanoid.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Jumping then
			jumpedSinceGround = true
		elseif new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running then
			divedThisJump = false
			jumpedSinceGround = false
			lastGrounded = os.clock()
			if os.clock() - jumpPressedAt < JUMP_BUFFER then
				-- A tap just before landing: the normal jump already missed it
				jumpPressedAt = -1
				humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end
	end)
end

local function onJumpRequest()
	local root, humanoid = parts()
	if not root or Movement.IsStunned() then
		return
	end
	local now = os.clock()
	if humanoid.FloorMaterial ~= Enum.Material.Air then
		lastGrounded = now
		return
	end
	if not jumpedSinceGround and now - lastGrounded < Config.CoyoteSeconds then
		jumpedSinceGround = true
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		return
	end
	jumpPressedAt = now
end

local function showBonkButton(on)
	if hammerShown == on then
		return
	end
	hammerShown = on
	if on then
		ContextActionService:BindAction("CrownRushBonk", function(_, state)
			if state == Enum.UserInputState.Begin then
				Controls.Bonk()
			end
			return Enum.ContextActionResult.Pass
		end, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.F, Enum.KeyCode.ButtonR2)
		ContextActionService:SetTitle("CrownRushBonk", "BONK")
		ContextActionService:SetPosition("CrownRushBonk", UDim2.new(1, -150, 1, -150))
	else
		ContextActionService:UnbindAction("CrownRushBonk")
	end
end

local function onCharacter(character)
	stopDive()
	divedThisJump = false
	jumpedSinceGround = false
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid then
		humanoid.WalkSpeed = Config.WalkSpeed
		humanoid.UseJumpPower = false
		humanoid.JumpHeight = Config.JumpHeight
		watchJumps(humanoid)
	end
	showBonkButton(character:GetAttribute("HasHammer") == true)
	character:GetAttributeChangedSignal("HasHammer"):Connect(function()
		showBonkButton(character:GetAttribute("HasHammer") == true)
	end)
end

function Controls.Init()
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	end)

	ContextActionService:BindAction("CrownRushDive", function(_, state)
		if state == Enum.UserInputState.Begin then
			Controls.Dive()
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonX)
	ContextActionService:SetTitle("CrownRushDive", "DIVE")
	ContextActionService:SetPosition("CrownRushDive", UDim2.new(1, -230, 1, -100))

	UserInputService.JumpRequest:Connect(onJumpRequest)
	Movement.Launched:Connect(function()
		stopDive()
	end)
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
end

return Controls
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[-- Celebrations, gem sparkles, falls, hits and sounds. The server says what
-- happened and where (the Effect remote); every player draws it on their own screen.
-- A few effects come straight from this player's own movement (bounces, hits).

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Cosmetics = require(Shared.Cosmetics)
local Remotes = require(Shared.Remotes)

local Movement = require(script.Parent.Movement)

local Effects = {}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SOUNDS = {
	bonk = { "rbxasset://sounds/collide.wav", 0.8 },
	swing = { "rbxasset://sounds/swordslash.wav", 0.25 },
	dive = { "rbxasset://sounds/swordlunge.wav", 0.3 },
	ko = { "rbxasset://sounds/uuhhh.mp3", 0.6 },
	fall = { "rbxasset://sounds/uuhhh.mp3", 0.35 },
	ding = { "rbxasset://sounds/electronicpingshort.wav", 0.6 },
	crack = { "rbxasset://sounds/glassbreak.wav", 0.35 },
	boing = { "rbxasset://sounds/action_jump.mp3", 0.6 },
	win = { "rbxasset://sounds/victory.wav", 0.5 },
}

local folder

local function anchor(position)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.one
	p.Position = position
	p.Parent = folder
	return p
end

function Effects.Sound(name, position)
	local info = SOUNDS[name]
	if not info then
		return
	end
	local holder = anchor(position)
	local sound = Instance.new("Sound")
	sound.SoundId = info[1]
	sound.Volume = info[2]
	sound.RollOffMaxDistance = 200
	sound.Parent = holder
	sound:Play()
	Debris:AddItem(holder, 3)
end

-- A burst of particles in the given colors
function Effects.Burst(position, colors, count, speed, texture, size)
	local holder = anchor(position)
	local keypoints = {}
	for index, color in ipairs(colors) do
		table.insert(keypoints, ColorSequenceKeypoint.new((index - 1) / math.max(1, #colors - 1), color))
	end
	if #keypoints == 1 then
		table.insert(keypoints, ColorSequenceKeypoint.new(1, colors[1]))
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = texture or SPARKLE
	emitter.Color = ColorSequence.new(keypoints)
	emitter.Size = NumberSequence.new(size or 1, 0)
	emitter.Speed = NumberRange.new(speed * 0.5, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Lifetime = NumberRange.new(0.4, 0.9)
	emitter.Drag = 3
	emitter.LightEmission = 0.5
	emitter.Rate = 0
	emitter.Parent = holder
	emitter:Emit(count)
	Debris:AddItem(holder, 2)
	return holder
end

-- Text that floats up and fades, like "+10%" or "KO!"
function Effects.Popup(position, text, color, size, seconds)
	local holder = anchor(position)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(size * 4, size)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 250
	gui.Parent = holder
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextStrokeTransparency = 0
	label.Parent = gui
	seconds = seconds or 0.9
	TweenService:Create(holder, TweenInfo.new(seconds), { Position = position + Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(
		label,
		TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ TextTransparency = 1, TextStrokeTransparency = 1 }
	):Play()
	Debris:AddItem(holder, seconds + 0.1)
end

local function ring(position, color, radius)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Shape = Enum.PartType.Cylinder
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = 0.3
	p.Size = Vector3.new(0.4, 2, 2)
	p.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	p.Parent = folder
	TweenService:Create(p, TweenInfo.new(0.35), { Size = Vector3.new(0.4, radius * 2, radius * 2), Transparency = 1 })
		:Play()
	Debris:AddItem(p, 0.4)
end

local function lightning(position, colors)
	local top = position + Vector3.new(0, 40, 0)
	local previous = top
	for step = 1, 6 do
		local nextPoint = top:Lerp(position, step / 6)
			+ (step < 6 and Vector3.new(math.random(-3, 3), 0, math.random(-3, 3)) or Vector3.zero)
		local length = (nextPoint - previous).Magnitude
		local bolt = Instance.new("Part")
		bolt.Anchored = true
		bolt.CanCollide = false
		bolt.CanQuery = false
		bolt.CanTouch = false
		bolt.Material = Enum.Material.Neon
		bolt.Color = colors[1]
		bolt.Size = Vector3.new(0.6, 0.6, length)
		bolt.CFrame = CFrame.lookAt((previous + nextPoint) / 2, nextPoint)
		bolt.Parent = folder
		TweenService:Create(bolt, TweenInfo.new(0.5), { Transparency = 1 }):Play()
		Debris:AddItem(bolt, 0.6)
		previous = nextPoint
	end
	Effects.Burst(position, colors, 40, 30)
end

-- The finish celebration the player has equipped (cel_* cosmetics)
function Effects.Celebrate(position, effectId)
	local item = Cosmetics.ById[effectId or ""]
	if not item or item.kind ~= "celebrate" then
		item = Cosmetics.ById[Cosmetics.Defaults.celebrate]
	end
	local colors = item.colors
	if item.id == "cel_bubbles" then
		Effects.Burst(position, colors, 50, 12, SPARKLE, 3)
	elseif item.id == "cel_hearts" then
		Effects.Burst(position, colors, 60, 25, SPARKLE, 2.5)
		Effects.Popup(position + Vector3.new(0, 2, 0), "<3", colors[1], 60, 1.2)
	elseif item.id == "cel_confetti" then
		Effects.Burst(position, colors, 140, 50, SPARKLE, 1.5)
	elseif item.id == "cel_star" then
		Effects.Burst(position, colors, 60, 35, SPARKLE, 3)
		Effects.Popup(position + Vector3.new(0, 3, 0), "*", colors[1], 120, 1.2)
	elseif item.id == "cel_fireworks" then
		for index = 1, 5 do
			task.delay(index * 0.18, function()
				local at = position + Vector3.new(math.random(-8, 8), math.random(6, 14), math.random(-8, 8))
				Effects.Burst(at, { colors[(index % #colors) + 1], colors[1] }, 50, 40, SPARKLE, 2)
			end)
		end
	elseif item.id == "cel_lightning" then
		lightning(position, colors)
	else
		Effects.Burst(position, colors, 70, 30, SPARKLE, 2)
	end
	Effects.Sound("win", position)
end

local handlers = {
	-- Courses
	fall = function(position)
		Effects.Burst(position, { Color3.new(1, 1, 1) }, 18, 10, SMOKE, 3)
		Effects.Sound("fall", position)
	end,
	checkpoint = function(position)
		ring(position, Color3.fromRGB(90, 255, 140), 9)
		Effects.Burst(position + Vector3.new(0, 2, 0), { Color3.fromRGB(90, 255, 140), Color3.new(1, 1, 1) }, 30, 20)
		Effects.Sound("ding", position)
	end,
	gem = function(position)
		Effects.Burst(position, { Color3.fromRGB(80, 230, 255), Color3.new(1, 1, 1) }, 40, 22)
		Effects.Popup(position + Vector3.new(0, 2, 0), "GEM!", Color3.fromRGB(80, 230, 255), 40, 1.2)
		Effects.Sound("ding", position)
	end,
	door = function(position)
		Effects.Burst(position, { Color3.fromRGB(200, 200, 200) }, 20, 12, SMOKE, 3)
		Effects.Sound("crack", position)
	end,
	finish = function(position, extra)
		Effects.Celebrate(position + Vector3.new(0, 3, 0), extra and extra.effect)
	end,
	qualify = function(position, extra)
		Effects.Celebrate(position + Vector3.new(0, 3, 0), extra and extra.effect)
		Effects.Popup(position + Vector3.new(0, 5, 0), "QUALIFIED!", Color3.fromRGB(120, 255, 140), 50, 1.4)
	end,
	dive = function(position)
		Effects.Burst(position - Vector3.new(0, 2, 0), { Color3.new(1, 1, 1) }, 10, 8, SMOKE, 2)
		Effects.Sound("dive", position)
	end,
	-- Fight rounds
	hit = function(position, extra)
		Effects.Burst(
			position,
			{ Color3.fromRGB(255, 240, 150), Color3.fromRGB(255, 150, 60) },
			extra and extra.big and 40 or 20,
			30
		)
		if extra and extra.damage then
			Effects.Popup(position + Vector3.new(0, 3, 0), "+" .. extra.damage .. "%", Color3.fromRGB(255, 220, 80), 34)
		end
		Effects.Sound("bonk", position)
	end,
	swing = function(position)
		Effects.Sound("swing", position)
	end,
	ko = function(position)
		Effects.Burst(position, { Color3.new(1, 1, 1), Color3.fromRGB(255, 200, 120) }, 30, 15, SMOKE, 4)
		Effects.Popup(position + Vector3.new(0, 5, 0), "KO!", Color3.fromRGB(255, 90, 60), 70, 1.4)
		Effects.Sound("ko", position)
	end,
	score = function(position, extra)
		local color = extra and extra.color or Color3.fromRGB(255, 220, 80)
		Effects.Burst(position, { color, Color3.new(1, 1, 1) }, 40, 25)
		Effects.Popup(position + Vector3.new(0, 4, 0), extra and extra.text or "+1", color, 44, 1.2)
		Effects.Sound("ding", position)
	end,
}

function Effects.Init()
	folder = Instance.new("Folder")
	folder.Name = "CrownRushEffects"
	folder.Parent = Workspace
	Remotes.Effect.OnClientEvent:Connect(function(kind, position, extra)
		local handler = handlers[kind]
		if handler and typeof(position) == "Vector3" then
			handler(position, extra)
		end
	end)
	-- Your own bounces and knocks, with no wait for the server
	Movement.Launched:Connect(function(kind)
		local character = Players.LocalPlayer.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root then
			return
		end
		if kind == "bounce" then
			Effects.Burst(root.Position - Vector3.new(0, 3, 0), { Color3.fromRGB(255, 110, 200) }, 15, 15)
			Effects.Sound("boing", root.Position)
		elseif kind == "hit" then
			Effects.Burst(root.Position, { Color3.fromRGB(255, 240, 150), Color3.fromRGB(255, 150, 60) }, 20, 25)
			Effects.Sound("bonk", root.Position)
		end
	end)
end

return Effects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">Guide</string><ProtectedString name="Source"><![CDATA[-- The first-time guide on screen: the current goal at the top, and a golden
-- line from you to where you need to go.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Tutorial = require(Shared.Tutorial)

local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local T = UI.Theme

local Guide = {}

local player = Players.LocalPlayer
local card, cardText
local beam, beamFrom, beamTo, marker, follower

local function findTarget(name)
	if not name then
		return nil
	end
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("GuideTarget") == name then
			return item
		end
	end
	return nil
end

local function currentStep()
	local data = State.data
	if not data or not data.tutorial or data.tutorial >= Tutorial.Done then
		return nil, nil
	end
	return Tutorial.Steps[data.tutorial], data.tutorial
end

local function update()
	local step, index = currentStep()
	if player:GetAttribute("InTournament") then
		step = nil
	end
	card.Visible = step ~= nil
	if not step then
		beam.Enabled = false
		marker.Enabled = false
		return
	end
	cardText.Text = string.format("(%d/%d) %s", index, #Tutorial.Steps, step.text)

	local target = findTarget(step.target)
	if target then
		beamTo.Parent = target
		beam.Enabled = true
		marker.Adornee = target
		marker.Enabled = true
	else
		beam.Enabled = false
		marker.Enabled = false
	end
end

function Guide.Init(screenGui)
	card = UI.new("Frame", {
		Name = "GuideCard",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 120),
		Size = UDim2.fromOffset(560, 56),
		BackgroundColor3 = Color3.fromRGB(255, 244, 214),
		Visible = false,
		Parent = screenGui,
	}, { UI.corner(12), UI.stroke(T.Gold, 3), UI.padding(8) })
	cardText = UI.label(
		"",
		{
			Size = UDim2.fromScale(1, 1),
			TextColor3 = Color3.fromRGB(60, 40, 20),
			Font = T.BodyFont,
			TextWrapped = true,
			Parent = card,
		}
	)

	-- An invisible part that follows the player carries the start of the line
	follower = Instance.new("Part")
	follower.Name = "GuideFollower"
	follower.Anchored = true
	follower.CanCollide = false
	follower.CanQuery = false
	follower.CanTouch = false
	follower.Transparency = 1
	follower.Size = Vector3.one * 0.2
	follower.Parent = Workspace
	beamFrom = Instance.new("Attachment")
	beamFrom.Name = "GuideFrom"
	beamFrom.Parent = follower
	beamTo = Instance.new("Attachment")
	beamTo.Name = "GuideTo"
	beamTo.Position = Vector3.new(0, 3, 0)
	beam = Instance.new("Beam")
	beam.Attachment0 = beamFrom
	beam.Attachment1 = beamTo
	beam.Width0 = 0.6
	beam.Width1 = 0.6
	beam.FaceCamera = true
	beam.Color = ColorSequence.new(T.Gold)
	beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0.1) })
	beam.LightEmission = 1
	beam.Enabled = false
	beam.Parent = beamFrom

	marker = UI.new("BillboardGui", {
		Name = "GuideMarker",
		Size = UDim2.fromOffset(80, 80),
		StudsOffset = Vector3.new(0, 6, 0),
		AlwaysOnTop = true,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local arrow = UI.label(
		"V",
		{ Size = UDim2.fromScale(1, 1), TextColor3 = T.Gold, TextStrokeTransparency = 0, Parent = marker }
	)

	RunService.RenderStepped:Connect(function()
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			follower.Position = root.Position - Vector3.new(0, 1.5, 0)
		end
		if marker.Enabled then
			marker.StudsOffset = Vector3.new(0, 6 + math.sin(os.clock() * 4) * 0.6, 0)
			arrow.TextTransparency = 0
		end
	end)

	State.Changed:Connect(update)
	player:GetAttributeChangedSignal("InTournament"):Connect(update)
	player.CharacterAdded:Connect(function()
		task.wait(1)
		update()
	end)
	update()
end

return Guide
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[-- Always-on screen info: level, coins, stars and crowns, the tournament queue
-- banner and the menu buttons.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Level = require(Shared.Level)
local Format = require(Shared.Format)
local Courses = require(Shared.Courses)

local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local Panels = require(script.Parent.Panels)
local RunHud = require(script.Parent.RunHud)
local T = UI.Theme

local Hud = {}

local player = Players.LocalPlayer
local STAR = utf8.char(9733)

function Hud.Init(screenGui)
	-- Stats, top left
	local stats = UI.new("Frame", {
		Name = "Stats",
		Position = UDim2.fromOffset(16, 60),
		Size = UDim2.fromOffset(230, 96),
		BackgroundColor3 = T.Background,
		BackgroundTransparency = 0.15,
		Parent = screenGui,
	}, { UI.corner(12), UI.padding(10), UI.list(4) })
	local levelLine = UI.label(
		"Lv 1 Runner",
		{
			Size = UDim2.new(1, 0, 0, 22),
			TextColor3 = Color3.fromRGB(150, 220, 255),
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 1,
			Parent = stats,
		}
	)
	local xpBack = UI.new(
		"Frame",
		{ Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = T.Card, LayoutOrder = 2, Parent = stats },
		{ UI.corner(3) }
	)
	local xpFill = UI.new(
		"Frame",
		{ Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.fromRGB(150, 220, 255), Parent = xpBack },
		{ UI.corner(3) }
	)
	local coins = UI.label(
		"0 coins",
		{
			Size = UDim2.new(1, 0, 0, 24),
			TextColor3 = T.Gold,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 3,
			Parent = stats,
		}
	)
	local record = UI.label(
		"",
		{
			Size = UDim2.new(1, 0, 0, 16),
			Font = T.BodyFont,
			TextColor3 = T.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 4,
			Parent = stats,
		}
	)

	local function update(data)
		local progress, level = Level.Progress(data.xp or 0)
		levelLine.Text = string.format("Lv %d Runner", level)
		xpFill.Size = UDim2.fromScale(math.clamp(progress, 0, 1), 1)
		coins.Text = Format.Number(data.coins) .. " coins"
		record.Text = string.format(
			"%s %s stars  -  %s crowns",
			STAR,
			Format.Number(Courses.TotalStars(data.adventure)),
			Format.Number(data.stats.crowns)
		)
	end
	State.Changed:Connect(update)
	if State.data then
		update(State.data)
	end

	-- Queue banner, top center, while you stand on a tournament pad
	local queueBanner = UI.new("Frame", {
		Name = "QueueBanner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(520, 56),
		BackgroundColor3 = T.Background,
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = screenGui,
	}, { UI.corner(12), UI.stroke(T.Gold, 2), UI.padding(6), UI.list(2) })
	local queueLine = UI.label("", { Size = UDim2.new(1, 0, 0, 24), TextColor3 = T.Gold, Parent = queueBanner })
	UI.label(
		"Step off the pad to leave the queue",
		{ Size = UDim2.new(1, 0, 0, 16), Font = T.BodyFont, TextColor3 = T.Muted, Parent = queueBanner }
	)

	-- Menu buttons, left side under the stats, with keyboard shortcuts
	local menu = UI.new("Frame", {
		Name = "Menu",
		Position = UDim2.fromOffset(16, 166),
		Size = UDim2.fromOffset(130, 5 * 48),
		BackgroundTransparency = 1,
		Parent = screenGui,
	}, { UI.list(6) })
	local buttons = {
		{ "Courses", "Courses", Color3.fromRGB(255, 120, 180), Enum.KeyCode.C },
		{ "Shop", "Shop", Color3.fromRGB(70, 200, 110), Enum.KeyCode.P },
		{ "Locker", "Locker", Color3.fromRGB(90, 140, 220), Enum.KeyCode.L },
		{ "Quests", "Quests", Color3.fromRGB(200, 150, 70), Enum.KeyCode.N },
	}
	local shortcuts = {}
	for index, info in ipairs(buttons) do
		local keyName = UserInputService.KeyboardEnabled and (" (" .. info[4].Name .. ")") or ""
		UI.button(info[1] .. keyName, info[3], function()
			Panels[info[2]].toggle()
		end, { Size = UDim2.fromOffset(130, 42), LayoutOrder = index, Parent = menu })
		shortcuts[info[4]] = info[2]
	end

	-- On a course or in a tournament the course bar and its buttons take over
	task.spawn(function()
		while true do
			local busy = RunHud.IsOnCourse() or player:GetAttribute("InTournament") ~= nil
			menu.Visible = not busy
			local pad = player:GetAttribute("QueuePad")
			queueBanner.Visible = pad ~= nil and not busy
			if pad then
				queueLine.Text = ReplicatedStorage:GetAttribute("PadStatus" .. pad) or "Waiting..."
			end
			task.wait(0.2)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or RunHud.IsOnCourse() then
			return
		end
		local panel = shortcuts[input.KeyCode]
		if panel then
			Panels[panel].toggle()
		end
	end)
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">Movement</string><ProtectedString name="Source"><![CDATA[-- Moves every obstacle on this player's screen, and handles what obstacles do
-- to this player's own character: riding moving platforms, conveyor belts and
-- slides, bounce pads, wind, ziplines, getting knocked by spinners and hammers,
-- and touching lava or lasers.
--
-- Obstacles move from the server clock (Shared/Motion), so everyone sees them
-- in the same place, and they move perfectly smoothly. Your character is moved
-- by your own computer (that's how Roblox works), so doing these here means no
-- lag between seeing a hammer hit you and flying.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Motion = require(Shared.Motion)
local Remotes = require(Shared.Remotes)

local Movement = {}

local player = Players.LocalPlayer
local ANIMATE_RANGE = 700 -- obstacles farther than this from the camera wait
local HIT_COOLDOWN = 0.7
local KILL_COOLDOWN = 1.2
local ZIP_SPEED = 48

local movers = {} -- [part] = { spec, transparency, collide, state }
local tagged = { Hit = {}, Kill = {}, Bounce = {}, Wind = {}, Zip = {}, Gem = {} }
local lastHit = 0
local lastFell = 0
local lastBounce = 0
local stunToken = 0
local stunnedUntil = 0
local zipping = nil
local ownedGems = {} -- [index] = true for the course you're on
local onLaunch = Instance.new("BindableEvent")
Movement.Launched = onLaunch.Event

local function flat(vector)
	return Vector3.new(vector.X, 0, vector.Z)
end

local function parts()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if root and humanoid and humanoid.Health > 0 then
		return root, humanoid, character
	end
	return nil
end

function Movement.IsStunned()
	return os.clock() < stunnedUntil or zipping ~= nil
end

-- Sends your character tumbling with a velocity (obstacle hits, foam hammers)
function Movement.Launch(velocity, stun, spin)
	local root, humanoid = parts()
	if not root then
		return
	end
	if zipping then
		zipping = nil
	end
	stunToken += 1
	local token = stunToken
	stunnedUntil = os.clock() + stun
	humanoid.PlatformStand = true
	root.AssemblyLinearVelocity = velocity
	root.AssemblyAngularVelocity = spin or Vector3.zero
	onLaunch:Fire()
	task.delay(stun, function()
		if stunToken ~= token or not humanoid.Parent then
			return
		end
		humanoid.PlatformStand = false
		root.AssemblyAngularVelocity = Vector3.zero
		local look = flat(root.CFrame.LookVector)
		if look.Magnitude < 0.1 then
			look = Vector3.new(0, 0, -1)
		end
		root.CFrame = CFrame.lookAt(root.Position, root.Position + look)
	end)
end

local function fell()
	local now = os.clock()
	if now - lastFell < KILL_COOLDOWN then
		return
	end
	lastFell = now
	Remotes.Fell:FireServer()
end

------------------------------------------------------------------ Tracking tagged parts
local function addMover(part)
	if part:IsA("BasePart") then
		movers[part] =
			{ spec = Motion.Read(part), transparency = part.Transparency, collide = part.CanCollide, state = "solid" }
	end
end

local function track(tag, set, onAdd)
	for _, item in ipairs(CollectionService:GetTagged(tag)) do
		set[item] = true
		if onAdd then
			onAdd(item)
		end
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(function(item)
		set[item] = true
		if onAdd then
			onAdd(item)
		end
	end)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(item)
		set[item] = nil
		if tag == Motion.Tag then
			movers[item] = nil
		end
	end)
end

------------------------------------------------------------------ Checks
-- Is any part of the body (feet, middle, head) inside a part's box?
local function touches(cframe, size, root, margin)
	local base = root.Position
	for _, height in ipairs({ -2.2, 0, 1.6 }) do
		local offset = cframe:PointToObjectSpace(base + Vector3.new(0, height, 0))
		if
			math.abs(offset.X) <= size.X / 2 + margin
			and math.abs(offset.Y) <= size.Y / 2 + margin
			and math.abs(offset.Z) <= size.Z / 2 + margin
		then
			return true, base + Vector3.new(0, height, 0)
		end
	end
	return false
end

local function touchesBall(part, root)
	local radius = part.Size.X / 2 + 1.2
	local base = root.Position
	for _, height in ipairs({ -2.2, 0, 1.6 }) do
		local point = base + Vector3.new(0, height, 0)
		if (point - part.Position).Magnitude < radius then
			return true, point
		end
	end
	return false
end

local function feetY(root, humanoid)
	return root.Position.Y - humanoid.HipHeight - root.Size.Y / 2
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function floorUnder(root, humanoid, character)
	rayParams.FilterDescendantsInstances = { character }
	local depth = humanoid.HipHeight + root.Size.Y / 2 + 1.2
	local hit = Workspace:Raycast(root.Position, Vector3.new(0, -depth, 0), rayParams)
	return hit and hit.Instance
end

------------------------------------------------------------------ Every frame
local function step(dt)
	local t = Motion.Clock()
	local camera = Workspace.CurrentCamera
	local focus = camera and camera.CFrame.Position or Vector3.zero
	local root, humanoid, character = parts()

	-- What you stand on, before anything moves
	local floor, floorBefore = nil, nil
	if root and not zipping and humanoid.FloorMaterial ~= Enum.Material.Air then
		floor = floorUnder(root, humanoid, character)
		if floor and movers[floor] then
			floorBefore = floor.CFrame
		end
	end

	-- Move the obstacles
	for part, info in pairs(movers) do
		if part == floor or (part.Position - focus).Magnitude < ANIMATE_RANGE or info.spec.kind == "blink" then
			local cframe, state = Motion.At(info.spec, t)
			part.CFrame = cframe
			if state ~= info.state or state == "warn" then
				info.state = state
				if state == "gone" then
					part.Transparency = 1
					part.CanCollide = false
				elseif state == "warn" then
					part.Transparency = info.transparency + (1 - info.transparency) * (0.35 + 0.3 * math.sin(t * 25))
					part.CanCollide = info.collide
				else
					part.Transparency = info.transparency
					part.CanCollide = info.collide
				end
			end
		end
	end

	if not root then
		return
	end

	-- Ride whatever you stand on
	if floorBefore then
		local relative = floorBefore:ToObjectSpace(root.CFrame)
		local moved = floor.CFrame:ToWorldSpace(relative)
		local look = flat(moved.LookVector)
		if look.Magnitude < 0.1 then
			look = flat(root.CFrame.LookVector)
		end
		root.CFrame = CFrame.lookAt(moved.Position, moved.Position + look)
	end
	if floor then
		local belt = floor:GetAttribute("Belt")
		if typeof(belt) == "Vector3" then
			root.CFrame += belt * dt
		end
	end

	-- Ziplines
	if zipping then
		zipping.along += ZIP_SPEED * dt
		local total = (zipping.to - zipping.from).Magnitude
		local direction = (zipping.to - zipping.from).Unit
		if zipping.along >= total then
			humanoid.PlatformStand = false
			root.CFrame = CFrame.lookAt(zipping.to, zipping.to + flat(direction))
			root.AssemblyLinearVelocity = flat(direction) * 20 + Vector3.new(0, 10, 0)
			zipping = nil
		else
			local at = zipping.from + direction * zipping.along
			root.CFrame = CFrame.lookAt(at, at + flat(direction))
			root.AssemblyLinearVelocity = Vector3.zero
		end
		return
	end
	local feet = feetY(root, humanoid)
	for pad in pairs(tagged.Zip) do
		local offset = root.Position - pad.Position
		if flat(offset).Magnitude < 3.5 and math.abs(feet - pad.Position.Y) < 2 then
			local from, to = pad:GetAttribute("ZipFrom"), pad:GetAttribute("ZipTo")
			if typeof(from) == "Vector3" and typeof(to) == "Vector3" then
				zipping = { from = from, to = to, along = 0 }
				humanoid.PlatformStand = true
				return
			end
		end
	end

	-- Bounce pads
	local now = os.clock()
	if now - lastBounce > 0.4 then
		for pad in pairs(tagged.Bounce) do
			local offset = root.Position - pad.Position
			local radius = math.max(pad.Size.Y, pad.Size.Z) / 2
			if flat(offset).Magnitude < radius and feet - pad.Position.Y < 1.5 and feet - pad.Position.Y > -1.5 then
				local launch = pad:GetAttribute("Launch")
				if typeof(launch) == "Vector3" then
					lastBounce = now
					root.AssemblyLinearVelocity = launch
					humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
					onLaunch:Fire("bounce")
				end
				break
			end
		end
	end

	-- Wind gusts
	for zone in pairs(tagged.Wind) do
		local push = zone:GetAttribute("Push")
		if typeof(push) == "Vector3" and (zone.Position - root.Position).Magnitude < zone.Size.Magnitude then
			local period = zone:GetAttribute("Period") or 4
			local on = zone:GetAttribute("On") or 2
			local blowing = (t + (zone:GetAttribute("Phase") or 0)) % period < on
			zone:SetAttribute("Blowing", blowing)
			if blowing and touches(zone.CFrame, zone.Size, root, 0) then
				root.CFrame += push * dt
			end
		end
	end

	-- Knocks from spinners, hammers, balls and pistons
	if now - lastHit > HIT_COOLDOWN and now > stunnedUntil then
		for part in pairs(tagged.Hit) do
			local info = movers[part]
			if
				info
				and info.state ~= "gone"
				and (part.Position - root.Position).Magnitude < math.max(part.Size.X, part.Size.Y, part.Size.Z) + 6
			then
				local hit, point
				if part.Shape == Enum.PartType.Ball then
					hit, point = touchesBall(part, root)
				else
					hit, point = touches(part.CFrame, part.Size, root, 0.9)
				end
				if hit then
					lastHit = now
					local push = flat(Motion.VelocityAt(info.spec, t, point))
					if push.Magnitude < 3 then
						push = flat(root.Position - part.Position)
					end
					if push.Magnitude < 0.1 then
						push = -flat(root.CFrame.LookVector)
					end
					Movement.Launch(
						push.Unit * Config.HitSpeed + Vector3.new(0, Config.HitUp, 0),
						Config.HitStun,
						push.Unit:Cross(Vector3.yAxis) * 6
					)
					onLaunch:Fire("hit")
					break
				end
			end
		end
	end

	-- Lava, lasers and spikes
	for part in pairs(tagged.Kill) do
		local info = movers[part]
		local live = not info or info.state ~= "gone"
		if live and (part.Position - root.Position).Magnitude < math.max(part.Size.X, part.Size.Z) + 10 then
			if touches(part.CFrame, part.Size, root, 0.2) then
				fell()
				break
			end
		end
	end

	-- Below the course
	local killY = player:GetAttribute("KillY")
	if killY and root.Position.Y < killY then
		fell()
	end
end

-- Dims the gems you already found on this course
local function refreshGems()
	local courseId = player:GetAttribute("Course")
	for gem in pairs(tagged.Gem) do
		local mine = gem:GetAttribute("CourseId") == courseId and ownedGems[gem:GetAttribute("GemIndex")]
		gem.LocalTransparencyModifier = mine and 0.75 or 0
	end
end

function Movement.SetGems(list)
	ownedGems = {}
	for index, value in pairs(list or {}) do
		if value then
			ownedGems[tonumber(index) or index] = true
		end
	end
	refreshGems()
end

function Movement.Init()
	track(Motion.Tag, {}, addMover)
	for name, set in pairs(tagged) do
		track(name, set, name == "Gem" and function()
			task.defer(refreshGems)
		end or nil)
	end
	local event = RunService.PreSimulation or RunService.Stepped
	if event == RunService.Stepped then
		event:Connect(function(_, dt)
			step(dt)
		end)
	else
		event:Connect(step)
	end
	player.CharacterAdded:Connect(function()
		stunToken += 1
		stunnedUntil = 0
		zipping = nil
	end)
	Remotes.Launch.OnClientEvent:Connect(Movement.Launch)
end

return Movement
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">Notifications</string><ProtectedString name="Source"><![CDATA[-- Small messages that pop up on the right side of the screen.

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local UI = require(script.Parent.UI)
local T = UI.Theme

local Notifications = {}

local COLORS = {
	success = T.Good,
	warning = T.Bad,
	coins = T.Gold,
	rare = Color3.fromRGB(255, 120, 200),
	info = T.Accent,
}

local container

function Notifications.Init(screenGui)
	container = UI.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 70),
		Size = UDim2.fromOffset(320, 400),
		BackgroundTransparency = 1,
		ZIndex = 20, -- above open windows
		Parent = screenGui,
	}, { UI.list(6) })

	Remotes.Notify.OnClientEvent:Connect(function(text, kind)
		Notifications.Show(text, kind)
	end)
end

function Notifications.Show(text, kind)
	if not container then
		return
	end
	local toast = UI.new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = T.Background,
		BackgroundTransparency = 0.1,
		Text = text,
		TextColor3 = COLORS[kind or "info"] or T.Text,
		Font = T.Font,
		TextScaled = true,
		TextWrapped = true,
		Parent = container,
	}, { UI.corner(10), UI.padding(6) })

	task.delay(4, function()
		local tween =
			TweenService:Create(toast, TweenInfo.new(0.4), { BackgroundTransparency = 1, TextTransparency = 1 })
		tween:Play()
		tween.Completed:Wait()
		toast:Destroy()
	end)

	-- Keep at most 6 on screen
	local toasts = {}
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("TextLabel") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 6 then
		toasts[1]:Destroy()
	end
end

return Notifications
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">Panels</string><ProtectedString name="Source"><![CDATA[-- The menus: Courses (a world's Adventure courses), Shop (Robux), Locker (your
-- cosmetics and the coin shop) and Quests.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Cosmetics = require(Shared.Cosmetics)
local Shop = require(Shared.Shop)
local Courses = require(Shared.Courses)
local Worlds = require(Shared.Worlds)
local Remotes = require(Shared.Remotes)
local Quests = require(Shared.Quests)
local Level = require(Shared.Level)
local Format = require(Shared.Format)

local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local Notifications = require(script.Parent.Notifications)
local T = UI.Theme

local player = Players.LocalPlayer
local Panels = {}

local function act(actionName, argument)
	local ok, message = State.Action(actionName, argument)
	if not ok and message then
		Notifications.Show(message, "warning")
	end
	return ok
end

-- Robux prices come from Roblox, so they always match the Creator Dashboard
local priceCache = {}
local function robuxPrice(id, infoType, onReady)
	local key = tostring(infoType) .. id
	if priceCache[key] then
		onReady(priceCache[key])
		return
	end
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfoAsync(id, infoType)
		end)
		if not ok then
			ok, info = pcall(function()
				return MarketplaceService:GetProductInfo(id, infoType)
			end)
		end
		if ok and info and info.PriceInRobux then
			priceCache[key] = info.PriceInRobux
			onReady(info.PriceInRobux)
		end
	end)
end

local function row(parent, height, order)
	return UI.new("Frame", {
		Size = UDim2.new(1, -8, 0, height),
		BackgroundColor3 = T.Card,
		LayoutOrder = order or 0,
		Parent = parent,
	}, { UI.corner(10) })
end

local function heading(parent, text, order)
	UI.label(
		text,
		{
			Size = UDim2.new(1, -8, 0, 30),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = T.Gold,
			LayoutOrder = order,
			Parent = parent,
		}
	)
end

local function note(parent, text, order)
	UI.label(
		text,
		{
			Size = UDim2.new(1, -8, 0, 20),
			Font = T.BodyFont,
			TextColor3 = T.Muted,
			TextWrapped = true,
			LayoutOrder = order,
			Parent = parent,
		}
	)
end

-- A small colour swatch so you can tell items apart at a glance
-- An item's name on its card, all at the same size whether it's short or long
local function itemName(card, text, width)
	local label = UI.label(
		text,
		{
			Position = UDim2.fromOffset(48, 0),
			Size = UDim2.new(width, 0, 1, 0),
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		}
	)
	UI.new("UITextSizeConstraint", { MaxTextSize = 20, Parent = label })
	return label
end

local function swatch(card, item)
	local color = item.head or item.color or (item.colors and item.colors[1]) or T.Muted
	UI.new(
		"Frame",
		{ Position = UDim2.fromOffset(10, 12), Size = UDim2.fromOffset(28, 28), BackgroundColor3 = color, Parent = card },
		{ UI.corner(14), UI.stroke(T.Background, 2) }
	)
end

local function cardButton(card, text, color, onClick)
	return UI.button(
		text,
		color,
		onClick,
		{
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.fromOffset(150, 36),
			Parent = card,
		}
	)
end

------------------------------------------------------------------ Shop (Robux)
local function renderShop(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	local order = 0
	local function nextOrder()
		order += 1
		return order
	end
	note(body, "Everything here is looks only. Nothing you buy helps you win.", nextOrder())

	heading(body, "Game pass (yours forever)", nextOrder())
	for _, pass in ipairs(Shop.Passes) do
		local card = row(body, 64, nextOrder())
		UI.label(
			pass.name,
			{
				Position = UDim2.fromOffset(12, 6),
				Size = UDim2.new(0.6, 0, 0, 26),
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = card,
			}
		)
		UI.label(
			pass.description,
			{
				Position = UDim2.fromOffset(12, 34),
				Size = UDim2.new(0.68, 0, 0, 20),
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = T.BodyFont,
				TextColor3 = T.Muted,
				Parent = card,
			}
		)
		local button = cardButton(card, "...", T.Good)
		if State.HasPass(pass.id) then
			button.Text = "Owned"
			button.BackgroundColor3 = T.Card
		elseif pass.gamePassId == 0 then
			button.Text = "Coming soon"
			button.BackgroundColor3 = T.Card
		else
			robuxPrice(pass.gamePassId, Enum.InfoType.GamePass, function(price)
				button.Text = "R$ " .. price
			end)
			button.Activated:Connect(function()
				MarketplaceService:PromptGamePassPurchase(player, pass.gamePassId)
			end)
		end
	end

	for _, kind in ipairs(Cosmetics.Kinds) do
		local items = {}
		for _, item in ipairs(Cosmetics.List) do
			if item.kind == kind.id and item.source == "robux" then
				table.insert(items, item)
			end
		end
		if #items > 0 then
			heading(body, kind.name, nextOrder())
			for _, item in ipairs(items) do
				local card = row(body, 52, nextOrder())
				swatch(card, item)
				itemName(card, item.name, 0.6)
				local owned = data.cosmetics.owned[item.id]
				local equipped = data.cosmetics.equipped[item.kind] == item.id
				local button = cardButton(card, "...", T.Good)
				if owned then
					button.Text = equipped and "Equipped" or "Equip"
					button.BackgroundColor3 = equipped and T.Card or T.Accent
					button.Activated:Connect(function()
						act("EquipCosmetic", item.id)
					end)
				elseif item.productId == 0 then
					button.Text = "Coming soon"
					button.BackgroundColor3 = T.Card
				else
					robuxPrice(item.productId, Enum.InfoType.Product, function(price)
						button.Text = "R$ " .. price
					end)
					button.Activated:Connect(function()
						MarketplaceService:PromptProductPurchase(player, item.productId)
					end)
				end
			end
		end
	end
end

------------------------------------------------------------------ Locker
local lockerTab = "trail"

local function howToGet(item, data)
	if item.source == "level" then
		return string.format("Reach level %d", item.level)
	elseif item.source == "earned" then
		local have = data.stats[item.rule] or 0
		local what = ({ stars = "stars", crowns = "crowns", gems = "gems", kos = "knockouts" })[item.rule] or item.rule
		return string.format("%d/%d %s", math.min(have, item.amount), item.amount, what)
	elseif item.source == "vip" then
		return "VIP pass"
	elseif item.source == "robux" then
		return "In the Shop"
	end
	return ""
end

local function renderLocker(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	local vip = State.HasPass("VIP")

	-- Tabs, one per kind of cosmetic
	local tabs = UI.new(
		"Frame",
		{ Size = UDim2.new(1, -8, 0, 36), BackgroundTransparency = 1, LayoutOrder = 0, Parent = body },
		{ UI.list(6, Enum.FillDirection.Horizontal) }
	)
	for _, kind in ipairs(Cosmetics.Kinds) do
		UI.button(kind.short, kind.id == lockerTab and T.Accent or T.Card, function()
			lockerTab = kind.id
			Panels.Locker.refresh()
		end, { Size = UDim2.fromOffset(104, 34), Parent = tabs })
	end
	note(
		body,
		string.format(
			"You have %s coins. Finish courses, find gems, play tournaments and do quests to earn more.",
			Format.Number(data.coins)
		),
		1
	)

	local order = 1
	for _, item in ipairs(Cosmetics.List) do
		if item.kind == lockerTab then
			order += 1
			local owns = Cosmetics.Owns(data, item, vip)
			local equipped = Cosmetics.Equipped(data, item.kind, vip)
			local isEquipped = equipped and equipped.id == item.id
			local card = row(body, 52, order)
			swatch(card, item)
			itemName(card, item.name, 0.55)
			if owns then
				local canTakeOff = isEquipped and not Cosmetics.Defaults[item.kind]
				cardButton(
					card,
					isEquipped and (canTakeOff and "Take off" or "Equipped") or "Equip",
					isEquipped and T.Card or T.Accent,
					function()
						if not isEquipped or canTakeOff then
							act("EquipCosmetic", item.id)
						end
					end
				)
			elseif item.source == "coins" then
				cardButton(
					card,
					Format.Number(item.price) .. " coins",
					data.coins >= item.price and T.Good or T.Card,
					function()
						act("BuyCosmetic", item.id)
					end
				)
			else
				cardButton(card, howToGet(item, data), T.Card, function()
					if item.source == "robux" or item.source == "vip" then
						Panels.Shop.open()
					end
				end)
			end
		end
	end
end

------------------------------------------------------------------ Quests
local function renderQuests(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	local resetIn = 86400 - (os.time() % 86400)
	note(body, string.format("Three new quests every day. New quests in %s.", Format.Duration(resetIn)), 0)
	for index, entry in ipairs(data.quests.list) do
		local quest = Quests.ById[entry.id]
		if quest then
			local card = row(body, 64, index)
			UI.label(
				Quests.Text(entry),
				{
					Position = UDim2.fromOffset(12, 6),
					Size = UDim2.new(0.62, 0, 0, 26),
					TextXAlignment = Enum.TextXAlignment.Left,
					TextColor3 = entry.done and T.Good or T.Text,
					Parent = card,
				}
			)
			local back = UI.new(
				"Frame",
				{
					Position = UDim2.fromOffset(12, 40),
					Size = UDim2.new(0.62, 0, 0, 12),
					BackgroundColor3 = T.Background,
					Parent = card,
				},
				{ UI.corner(6) }
			)
			UI.new(
				"Frame",
				{
					Size = UDim2.fromScale(math.clamp(entry.progress / entry.goal, 0, 1), 1),
					BackgroundColor3 = entry.done and T.Good or T.Accent,
					Parent = back,
				},
				{ UI.corner(6) }
			)
			UI.label(
				entry.done and "Done!" or string.format("%d/%d  -  %d coins", entry.progress, entry.goal, quest.coins),
				{
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -12, 0.5, 0),
					Size = UDim2.fromOffset(170, 26),
					TextColor3 = entry.done and T.Good or T.Gold,
					Parent = card,
				}
			)
		end
	end
	heading(body, "Your record", 10)
	local stats = data.stats
	local _, level = Level.Progress(data.xp)
	note(
		body,
		string.format(
			"Level %d  -  %d stars  -  %d gems  -  %d courses finished",
			level,
			stats.stars,
			stats.gems,
			stats.courses
		),
		11
	)
	note(
		body,
		string.format(
			"%d tournaments  -  %d crowns  -  %d rounds survived  -  %d knockouts",
			stats.tournaments,
			stats.crowns,
			stats.rounds,
			stats.kos
		),
		12
	)
	note(body, string.format("Daily login streak: %d day%s", data.dailyStreak, data.dailyStreak == 1 and "" or "s"), 13)
end

------------------------------------------------------------------ Courses
local STAR = utf8.char(9733)
local GEM = utf8.char(9670)
local worldTab = "candy"

local function countBits(bits)
	local count = 0
	for index = 0, 2 do
		count += bit32.band(bit32.rshift(bits or 0, index), 1)
	end
	return count
end

local function clock(seconds)
	local whole = math.floor(seconds)
	return string.format("%d:%02d.%02d", math.floor(whole / 60), whole % 60, math.floor((seconds - whole) * 100))
end

local function renderCourses(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	local total = Courses.TotalStars(data.adventure)

	local tabs = UI.new(
		"Frame",
		{ Size = UDim2.new(1, -8, 0, 36), BackgroundTransparency = 1, LayoutOrder = 0, Parent = body },
		{ UI.list(6, Enum.FillDirection.Horizontal) }
	)
	for _, world in ipairs(Worlds.List) do
		local open = Courses.WorldUnlocked(data.adventure, world.id)
		UI.button(world.name, world.id == worldTab and world.edge or T.Card, function()
			worldTab = world.id
			Panels.Courses.refresh()
		end, { Size = UDim2.fromOffset(108, 34), TextTransparency = open and 0 or 0.45, Parent = tabs })
	end

	local world = Worlds.ById[worldTab]
	local list = Courses.ByWorld[worldTab] or {}
	local worldStars = 0
	for _, course in ipairs(list) do
		local record = data.adventure[course.id]
		worldStars += record and Courses.CountStars(record.stars) or 0
	end
	if not Courses.WorldUnlocked(data.adventure, world.id) then
		note(
			body,
			string.format(
				"%s opens at %d stars. You have %d. Earn stars by finishing courses, beating par times and finding gems.",
				world.name,
				world.stars,
				total
			),
			1
		)
	else
		note(
			body,
			string.format(
				"%s  -  %s %d/%d in this world  -  %d stars in all",
				world.blurb,
				STAR,
				worldStars,
				#list * 3,
				total
			),
			1
		)
	end
	if #list == 0 then
		note(body, "Courses for this world are coming soon!", 2)
		return
	end

	for index, course in ipairs(list) do
		local record = data.adventure[course.id]
		local open = Courses.Unlocked(data.adventure, course.id)
		local card = row(body, 64, index + 1)
		UI.label(string.format("%d. %s%s", course.number, course.name, course.boss and "  (boss)" or ""), {
			Position = UDim2.fromOffset(12, 6),
			Size = UDim2.new(0.62, 0, 0, 26),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = open and (course.boss and world.accent or T.Text) or T.Muted,
			Parent = card,
		})
		local stars = record and Courses.CountStars(record.stars) or 0
		local gems = record and countBits(record.gems) or 0
		local detail =
			string.format("%s%s   %s %d/3", string.rep(STAR, stars), string.rep(utf8.char(9734), 3 - stars), GEM, gems)
		if record and record.best then
			detail ..= "   Best " .. clock(record.best)
		end
		UI.label(
			detail,
			{
				Position = UDim2.fromOffset(12, 36),
				Size = UDim2.new(0.62, 0, 0, 20),
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = T.BodyFont,
				TextColor3 = stars > 0 and T.Gold or T.Muted,
				Parent = card,
			}
		)
		if open then
			cardButton(
				card,
				record and record.done and "Play again" or "Play",
				record and record.done and T.Accent or T.Good,
				function()
					if act("PlayCourse", course.id) then
						Panels.Courses.close()
					end
				end
			)
		else
			cardButton(card, "Locked", T.Card, function()
				local previous = Courses.Previous(course.id)
				if not Courses.WorldUnlocked(data.adventure, world.id) then
					Notifications.Show(string.format("%s opens at %d stars", world.name, world.stars), "warning")
				elseif previous then
					Notifications.Show("Finish " .. previous.name .. " first", "warning")
				end
			end)
		end
	end
end

function Panels.Init(screenGui)
	Panels.Shop = UI.window(screenGui, "Shop", renderShop)
	Panels.Locker = UI.window(screenGui, "Locker", renderLocker)
	Panels.Quests = UI.window(screenGui, "Daily Quests", renderQuests)
	Panels.Courses = UI.window(screenGui, "Adventure", renderCourses)

	State.Changed:Connect(function()
		for _, name in ipairs({ "Shop", "Locker", "Quests", "Courses" }) do
			Panels[name].refresh()
		end
	end)

	-- The server opens a menu, e.g. a world's courses when you walk into its gate
	Remotes.OpenPanel.OnClientEvent:Connect(function(name, argument)
		if name == "Courses" and Worlds.ById[argument or ""] then
			worldTab = argument
		end
		local panel = Panels[name]
		if panel then
			panel.open()
		end
	end)
end

return Panels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">RunHud</string><ProtectedString name="Source"><![CDATA[-- What you see while on a course: the timer, checkpoints, gems, the Leave /
-- Restart / Skip buttons, and the results card at the finish. Also dresses the
-- sky in the course's world colours (and low gravity in space).

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Courses = require(Shared.Courses)
local Worlds = require(Shared.Worlds)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local Notifications = require(script.Parent.Notifications)
local Movement = require(script.Parent.Movement)
local T = UI.Theme

local RunHud = {}

local STAR = utf8.char(9733) -- a filled star
local GEM = utf8.char(9670) -- a diamond
local DEFAULT_GRAVITY = 196.2

local run = nil -- the latest summary from the server
local bar, nameLabel, timerLabel, parLabel, checkpointLabel, gemLabels
local buttons, skipButton
local resultCard, resultBody

------------------------------------------------------------------ Helpers
-- 83.456 -> "1:23.45"
function RunHud.Time(seconds)
	seconds = math.max(0, seconds)
	local whole = math.floor(seconds)
	local hundredths = math.floor((seconds - whole) * 100)
	return string.format("%d:%02d.%02d", math.floor(whole / 60), whole % 60, hundredths)
end

local function act(name, argument)
	local ok, message = State.Action(name, argument)
	if not ok and message then
		Notifications.Show(message, "warning")
	end
	return ok
end

function RunHud.IsOnCourse()
	return run ~= nil
end

------------------------------------------------------------------ World look
local plazaLook = nil
local atmosphere = nil

local function applyWorld(worldId)
	if not plazaLook then
		plazaLook = {
			ambient = Lighting.OutdoorAmbient,
			fogColor = Lighting.FogColor,
			fogEnd = Lighting.FogEnd,
			clock = Lighting.ClockTime,
		}
		atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	end
	local world = worldId and Worlds.ById[worldId]
	local info = TweenInfo.new(1.2)
	if world then
		TweenService:Create(
			Lighting,
			info,
			{
				OutdoorAmbient = world.sky.ambient,
				FogColor = world.sky.fog,
				FogEnd = 2500,
				ClockTime = world.id == "space" and 0 or 14,
			}
		):Play()
		if atmosphere then
			TweenService:Create(atmosphere, info, { Color = world.sky.top, Decay = world.sky.fog }):Play()
		end
		Workspace.Gravity = world.gravity or DEFAULT_GRAVITY
	else
		TweenService:Create(
			Lighting,
			info,
			{
				OutdoorAmbient = plazaLook.ambient,
				FogColor = plazaLook.fogColor,
				FogEnd = plazaLook.fogEnd,
				ClockTime = plazaLook.clock,
			}
		):Play()
		if atmosphere then
			TweenService
				:Create(
					atmosphere,
					info,
					{ Color = Color3.fromRGB(199, 220, 255), Decay = Color3.fromRGB(106, 112, 125) }
				)
				:Play()
		end
		Workspace.Gravity = DEFAULT_GRAVITY
	end
end

------------------------------------------------------------------ The bar
local function refreshBar()
	bar.Visible = run ~= nil
	buttons.Visible = run ~= nil and not resultCard.Visible
	if not run then
		return
	end
	nameLabel.Text = run.name
	checkpointLabel.Text = string.format("Checkpoint %d/%d", run.checkpoint, run.checkpoints)
	parLabel.Text = run.mode == "adventure" and ("Par " .. RunHud.Time(run.par)) or ""
	for index, label in ipairs(gemLabels) do
		local now = run.gems[index]
		local before = run.savedGems[index]
		label.TextColor3 = now and Color3.fromRGB(80, 230, 255)
			or (before and Color3.fromRGB(60, 120, 150) or Color3.fromRGB(70, 80, 100))
	end
	gemLabels[1].Parent.Visible = run.mode == "adventure"
	skipButton.Visible = run.canSkip == true and not run.skipped
	Movement.SetGems({
		run.gems[1] or run.savedGems[1],
		run.gems[2] or run.savedGems[2],
		run.gems[3] or run.savedGems[3],
	})
end

local function buildBar(screenGui)
	bar = UI.new("Frame", {
		Name = "RunBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(420, 92),
		BackgroundColor3 = T.Background,
		BackgroundTransparency = 0.15,
		Visible = false,
		Parent = screenGui,
	}, { UI.corner(14), UI.stroke(T.Gold, 2) })
	nameLabel = UI.label(
		"",
		{ Position = UDim2.fromOffset(14, 6), Size = UDim2.new(1, -28, 0, 20), TextColor3 = T.Gold, Parent = bar }
	)
	timerLabel =
		UI.label("0:00.00", { Position = UDim2.fromOffset(14, 26), Size = UDim2.new(1, -28, 0, 38), Parent = bar })
	checkpointLabel = UI.label(
		"",
		{
			Position = UDim2.fromOffset(14, 66),
			Size = UDim2.new(0.4, 0, 0, 18),
			Font = T.BodyFont,
			TextColor3 = T.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = bar,
		}
	)
	parLabel = UI.label(
		"",
		{
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 66),
			Size = UDim2.new(0.3, 0, 0, 18),
			Font = T.BodyFont,
			TextColor3 = T.Muted,
			Parent = bar,
		}
	)
	local gemRow = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 64),
		Size = UDim2.fromOffset(78, 22),
		BackgroundTransparency = 1,
		Parent = bar,
	}, { UI.list(4, Enum.FillDirection.Horizontal) })
	gemLabels = {}
	for index = 1, 3 do
		gemLabels[index] = UI.label(GEM, { Size = UDim2.fromOffset(22, 22), LayoutOrder = index, Parent = gemRow })
	end

	buttons = UI.new("Frame", {
		Name = "RunButtons",
		Position = UDim2.fromOffset(16, 166),
		Size = UDim2.fromOffset(130, 3 * 48),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = screenGui,
	}, { UI.list(6) })
	local keys = UserInputService.KeyboardEnabled
	UI.button(keys and "Restart (R)" or "Restart", T.Accent, function()
		act("RetryCourse")
	end, { Size = UDim2.fromOffset(130, 42), LayoutOrder = 1, Parent = buttons })
	UI.button("Leave", T.Bad, function()
		act("LeaveCourse")
	end, { Size = UDim2.fromOffset(130, 42), LayoutOrder = 2, Parent = buttons })
	skipButton = UI.button("Skip ahead", Color3.fromRGB(170, 100, 255), function()
		act("SkipSection")
	end, { Size = UDim2.fromOffset(130, 42), LayoutOrder = 3, Visible = false, Parent = buttons })

	UserInputService.InputBegan:Connect(function(input, processed)
		if
			not processed
			and input.KeyCode == Enum.KeyCode.R
			and run
			and run.mode == "adventure"
			and not resultCard.Visible
		then
			act("RetryCourse")
		end
	end)

	RunService.RenderStepped:Connect(function()
		if not run then
			return
		end
		if run.finalTime then
			timerLabel.Text = RunHud.Time(run.finalTime)
		elseif run.started then
			local elapsed = Workspace:GetServerTimeNow() - run.started
			timerLabel.Text = RunHud.Time(elapsed)
			timerLabel.TextColor3 = (run.mode == "adventure" and elapsed > run.par) and Color3.fromRGB(255, 170, 120)
				or T.Text
		else
			timerLabel.Text = RunHud.Time(0)
			timerLabel.TextColor3 = T.Text
		end
	end)
end

------------------------------------------------------------------ Results
local function showResult(result)
	UI.clear(resultBody)
	UI.list(6).Parent = resultBody
	resultBody:FindFirstChildOfClass("UIListLayout").HorizontalAlignment = Enum.HorizontalAlignment.Center
	local order = 0
	local function nextOrder()
		order += 1
		return order
	end
	UI.label(
		result.skipped and "Finished (skipped)" or "Course complete!",
		{ Size = UDim2.new(1, 0, 0, 36), TextColor3 = T.Gold, LayoutOrder = nextOrder(), Parent = resultBody }
	)
	UI.label(
		result.name,
		{
			Size = UDim2.new(1, 0, 0, 22),
			Font = T.BodyFont,
			TextColor3 = T.Muted,
			LayoutOrder = nextOrder(),
			Parent = resultBody,
		}
	)

	-- Three stars, the new ones pop in
	local starRow = UI.new(
		"Frame",
		{ Size = UDim2.fromOffset(200, 60), BackgroundTransparency = 1, LayoutOrder = nextOrder(), Parent = resultBody },
		{ UI.list(10, Enum.FillDirection.Horizontal) }
	)
	starRow:FindFirstChildOfClass("UIListLayout").HorizontalAlignment = Enum.HorizontalAlignment.Center
	for index = 1, 3 do
		local have = index <= result.stars
		local star = UI.label(
			STAR,
			{
				Size = UDim2.fromOffset(56, 56),
				TextColor3 = have and T.Gold or Color3.fromRGB(70, 80, 100),
				LayoutOrder = index,
				Parent = starRow,
			}
		)
		if have and index > result.starsBefore then
			local scale = UI.new("UIScale", { Scale = 0.1, Parent = star })
			task.delay(0.25 * (index - result.starsBefore), function()
				TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
			end)
		end
	end
	local why = {}
	table.insert(why, "Finish")
	table.insert(why, "Beat par " .. RunHud.Time(result.par))
	local gems = 0
	for index = 0, 2 do
		gems += bit32.band(bit32.rshift(result.gems or 0, index), 1)
	end
	table.insert(why, string.format("All 3 gems (%d/3)", gems))
	UI.label(
		table.concat(why, "   " .. STAR .. "   "),
		{
			Size = UDim2.new(1, 0, 0, 18),
			Font = T.BodyFont,
			TextColor3 = T.Muted,
			LayoutOrder = nextOrder(),
			Parent = resultBody,
		}
	)

	local timeText = "Time " .. RunHud.Time(result.time)
	if result.newBest then
		timeText ..= "  -  New best!"
	elseif result.best then
		timeText ..= "  -  Best " .. RunHud.Time(result.best)
	end
	UI.label(
		timeText,
		{
			Size = UDim2.new(1, 0, 0, 28),
			TextColor3 = result.newBest and T.Good or T.Text,
			LayoutOrder = nextOrder(),
			Parent = resultBody,
		}
	)
	if result.skipped then
		UI.label(
			"Skipped runs don't give stars. Try again without skipping!",
			{
				Size = UDim2.new(1, 0, 0, 18),
				Font = T.BodyFont,
				TextColor3 = T.Muted,
				LayoutOrder = nextOrder(),
				Parent = resultBody,
			}
		)
	end
	UI.label(
		string.format("+%s coins   +%s XP", Format.Number(result.coins or 0), Format.Number(result.xp or 0)),
		{ Size = UDim2.new(1, 0, 0, 26), TextColor3 = T.Gold, LayoutOrder = nextOrder(), Parent = resultBody }
	)

	local row = UI.new(
		"Frame",
		{ Size = UDim2.new(1, 0, 0, 46), BackgroundTransparency = 1, LayoutOrder = nextOrder(), Parent = resultBody },
		{ UI.list(10, Enum.FillDirection.Horizontal) }
	)
	row:FindFirstChildOfClass("UIListLayout").HorizontalAlignment = Enum.HorizontalAlignment.Center
	local function close()
		resultCard.Visible = false
		refreshBar()
	end
	local nextCourse = result.nextCourse and Courses.ById[result.nextCourse]
	if nextCourse and State.data and Courses.Unlocked(State.data.adventure, nextCourse.id) then
		UI.button("Next: " .. nextCourse.name, T.Good, function()
			close()
			act("PlayCourse", nextCourse.id)
		end, { Size = UDim2.fromOffset(220, 44), LayoutOrder = 1, Parent = row })
	end
	UI.button("Play again", T.Accent, function()
		close()
		act("PlayCourse", result.courseId)
	end, { Size = UDim2.fromOffset(150, 44), LayoutOrder = 2, Parent = row })
	UI.button("Plaza", T.Card, function()
		close()
		act("LeaveCourse")
	end, { Size = UDim2.fromOffset(110, 44), LayoutOrder = 3, Parent = row })

	resultCard.Visible = true
	refreshBar()
end

local function buildResult(screenGui)
	resultCard = UI.new("Frame", {
		Name = "ResultCard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(560, 360),
		BackgroundColor3 = T.Panel,
		Visible = false,
		Active = true,
		ZIndex = 5,
		Parent = screenGui,
	}, { UI.corner(16), UI.stroke(T.Gold, 3) })
	resultBody = UI.new(
		"Frame",
		{
			Position = UDim2.fromOffset(16, 14),
			Size = UDim2.new(1, -32, 1, -28),
			BackgroundTransparency = 1,
			Parent = resultCard,
		}
	)
end

------------------------------------------------------------------ Start
function RunHud.Init(screenGui)
	buildBar(screenGui)
	buildResult(screenGui)

	Remotes.Run.OnClientEvent:Connect(function(event, info)
		if event == "enter" then
			run = info
			resultCard.Visible = false
			applyWorld(info.world)
		elseif event == "update" then
			if run then
				local finalTime = run.finalTime
				run = info
				run.finalTime = info.finished and finalTime or nil
			else
				run = info
			end
		elseif event == "leave" then
			run = nil
			resultCard.Visible = false
			applyWorld(nil)
			Movement.SetGems({})
		elseif event == "result" then
			if run then
				run.finalTime = info.time
			end
			showResult(info)
		end
		refreshBar()
	end)
end

return RunHud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[-- The player's latest save data, as sent by the server.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local State = {
	data = nil,
	runtime = { passes = {} },
}

local changed = Instance.new("BindableEvent")
State.Changed = changed.Event

Remotes.DataUpdate.OnClientEvent:Connect(function(data, runtime)
	State.data = data
	State.runtime = runtime or State.runtime
	changed:Fire(data, State.runtime)
end)

function State.HasPass(passId)
	return State.runtime.passes ~= nil and State.runtime.passes[passId] == true
end

-- Calls a server action and shows its error message if it fails
function State.Action(actionName, argument)
	local ok, success, message = pcall(function()
		return Remotes.Action:InvokeServer(actionName, argument)
	end)
	if not ok then
		return false, "Connection problem, try again"
	end
	return success, message
end

return State
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- Helpers for building the on-screen menus in code, so nothing has to be
-- drawn by hand in Studio. Colors and fonts live in UI.Theme.

local UI = {}

UI.Theme = {
	Background = Color3.fromRGB(20, 32, 52),
	Panel = Color3.fromRGB(30, 46, 74),
	Card = Color3.fromRGB(42, 62, 96),
	Accent = Color3.fromRGB(60, 170, 255),
	Gold = Color3.fromRGB(255, 200, 40),
	Good = Color3.fromRGB(70, 200, 110),
	Bad = Color3.fromRGB(230, 80, 80),
	Muted = Color3.fromRGB(150, 170, 200),
	Text = Color3.fromRGB(255, 255, 255),
	Font = Enum.Font.FredokaOne,
	BodyFont = Enum.Font.GothamMedium,
}

local T = UI.Theme

-- UI.new("Frame", { Size = ..., Parent = ... }, { child1, child2 })
function UI.new(className, props, children)
	local instance = Instance.new(className)
	local parent = nil
	for key, value in pairs(props or {}) do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	instance.Parent = parent
	return instance
end

function UI.corner(radius)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function UI.stroke(color, thickness)
	return UI.new(
		"UIStroke",
		{
			Color = color or Color3.new(0, 0, 0),
			Thickness = thickness or 2,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}
	)
end

function UI.padding(pixels)
	local p = UDim.new(0, pixels)
	return UI.new("UIPadding", { PaddingTop = p, PaddingBottom = p, PaddingLeft = p, PaddingRight = p })
end

function UI.list(spacing, direction)
	return UI.new("UIListLayout", {
		Padding = UDim.new(0, spacing or 8),
		FillDirection = direction or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function UI.label(text, props)
	local label = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = T.Text,
		Font = T.Font,
		TextScaled = true,
		Size = UDim2.new(1, 0, 0, 24),
	})
	for key, value in pairs(props or {}) do
		label[key] = value
	end
	return label
end

function UI.button(text, color, onClick, props)
	local button = UI.new(
		"TextButton",
		{
			Text = text,
			BackgroundColor3 = color or T.Accent,
			TextColor3 = T.Text,
			Font = T.Font,
			TextScaled = true,
			AutoButtonColor = true,
			Size = UDim2.fromOffset(120, 40),
		},
		{
			UI.corner(8),
			UI.new(
				"UIPadding",
				{
					PaddingTop = UDim.new(0, 6),
					PaddingBottom = UDim.new(0, 6),
					PaddingLeft = UDim.new(0, 8),
					PaddingRight = UDim.new(0, 8),
				}
			),
		}
	)
	for key, value in pairs(props or {}) do
		button[key] = value
	end
	if onClick then
		button.Activated:Connect(onClick)
	end
	return button
end

function UI.clear(container)
	for _, child in ipairs(container:GetChildren()) do
		child:Destroy()
	end
end

-- A centered window with a title, a close button and a scrolling body.
-- Only one window is open at a time.
local openWindow = nil
local windowChanged = Instance.new("BindableEvent")
UI.WindowChanged = windowChanged.Event -- fires with true/false when a window opens/closes

function UI.IsWindowOpen()
	return openWindow ~= nil
end

function UI.window(screenGui, title, render)
	local frame = UI.new("Frame", {
		Name = title .. "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(620, 440),
		BackgroundColor3 = T.Panel,
		Visible = false,
		Active = true, -- clicks on the window don't reach the game (no bonking through it)
		ZIndex = 10, -- above the HUD and the guide card, so the close button is never covered
		Parent = screenGui,
	}, { UI.corner(16), UI.stroke(T.Background, 4) })

	UI.label(
		title,
		{
			Position = UDim2.fromOffset(20, 12),
			Size = UDim2.new(1, -90, 0, 36),
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = frame,
		}
	)

	local body = UI.new("ScrollingFrame", {
		Name = "Body",
		Position = UDim2.fromOffset(16, 60),
		Size = UDim2.new(1, -32, 1, -76),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = frame,
	})

	local window = { frame = frame, body = body }

	function window.refresh()
		if frame.Visible then
			UI.clear(body)
			render(body)
		end
	end

	function window.open()
		if openWindow and openWindow ~= window then
			openWindow.close()
		end
		openWindow = window
		frame.Visible = true
		window.refresh()
		windowChanged:Fire(true)
	end

	function window.close()
		frame.Visible = false
		if openWindow == window then
			openWindow = nil
			windowChanged:Fire(false)
		end
	end

	function window.toggle()
		if frame.Visible then
			window.close()
		else
			window.open()
		end
	end

	UI.button("X", T.Bad, window.close, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(40, 40),
		Parent = frame,
	})

	return window
end

return UI
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>
